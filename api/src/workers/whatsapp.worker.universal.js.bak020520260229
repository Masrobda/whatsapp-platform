// src/workers/whatsapp.worker.universal.js
const { Worker } = require('bullmq');
const { redisConnection } = require('../config/redis');
const { query } = require('../config/database');
const logger = require('../utils/logger');
const watiService = require('../services/wati.service');
const { canSendToRecipient, incrementClientStats } = require('../services/message.service');

const WORKER_CONFIG = {
  connection: redisConnection,
  concurrency: 15,
  lockDuration: 60000,
  stalledInterval: 30000,
  maxStalledCount: 3,
  removeOnComplete: { age: 3600, count: 500 },
  removeOnFail: { age: 86400, count: 2000 },
  settings: {
    backoffStrategies: {
      exponential: (attemptsMade) => {
        return Math.min(Math.pow(2, attemptsMade) * 1000, 300000);
      }
    }
  }
};

const workerStats = new Map();

async function processMessage(job) {
  const startTime = Date.now();
  const { messageId, client_id, recipient_phone, phoneNumber } = job.data;

  logger.debug(`[${job.queueName}] Traitement ${messageId} (attempt ${job.attemptsMade + 1})`);

  try {
    const statusCheck = await query(
      `SELECT wa_status FROM messages WHERE id = $1 FOR UPDATE SKIP LOCKED`,
      [messageId]
    );

    if (statusCheck.rows.length === 0) {
      throw new Error(`Message ${messageId} non trouvé`);
    }

    if (statusCheck.rows[0].wa_status !== 'queued') {
      logger.info(`[${messageId}] Déjà traité: ${statusCheck.rows[0].wa_status}`);
      return { success: true, skipped: true };
    }

    const cooldownCheck = await canSendToRecipient(recipient_phone, client_id);
    if (!cooldownCheck.canSend) {
      await markMessageAsFailed(messageId, client_id, cooldownCheck.reason);
      throw new Error(cooldownCheck.reason);
    }

    const result = await sendViaWati(job.data);

    if (!result?.success) {
      throw new Error(result?.error || 'Échec WATI');
    }

    await markMessageAsSent(messageId, client_id, result.messageId);
    await incrementClientStats(phoneNumber, client_id);
//    await incrementClientStats(client_id);

    const duration = Date.now() - startTime;
    logger.info(`[${messageId}] Succès en ${duration}ms | WATI: ${result.messageId}`);

    updateWorkerStats(job.queueName, true, duration);

    return { success: true, duration, watiId: result.messageId };

  } catch (error) {
    const duration = Date.now() - startTime;
    logger.error(`[${messageId}] Échec: ${error.message}`);
    updateWorkerStats(job.queueName, false, duration);

    if (isFatalError(error)) {
      await markMessageAsFailed(messageId, client_id, error.message);
      return { success: false, fatal: true };
    }

    throw error;
  }
}

async function sendViaWati(data) {
  // Log de sécurité pour voir l'objet réel en cas de doute
  console.log("DEBUG DATA REÇUE DANS LE WORKER:", JSON.stringify(data));
  
  // Log de débogage complet
  console.log("=== [WORKER] DONNÉES REÇUES ===");
  console.log("message_type:", data.message_type);
  console.log("invoice_data présent?", !!data.invoice_data);
  console.log("Contenu invoice_data:", JSON.stringify(data.invoice_data, null, 2));
  console.log("Toutes les clés:", Object.keys(data));
  console.log("DEBUG WORKER - Objet data complet:", JSON.stringify(data, null, 2));

  // Extraction robuste : supporte snake_case ET camelCase
  const recipient_phone = data.recipient_phone || data.recipientPhone;
  const message_type = data.message_type || data.messageType;
  const template_name = data.template_name || data.templateName; // <-- CORRECTION ICI
  const template_params = data.template_params || data.templateParams; // <-- CORRECTION ICI
  const template_language = data.template_language || data.templateLanguage || 'fr';
  
  // Support des autres champs
  const message_content = data.message_content || data.messageContent;
  const media_url = data.media_url || data.mediaUrl;
  const media_type = data.media_type || data.mediaType;
  const invoice_data = data.invoice_data || data.invoiceData;
  const phoneNumber = data.phoneNumber || data.phone_number;

  // Validation critique pour les templates
  if (!template_name && message_type === 'template') {
      console.error("❌ CRITIQUE: template_name est introuvable dans data", data);
  }

  let result; // Déclarer result pour stocker le retour

  switch (message_type) {
    case 'template':
        // Support de pdfUrl ET url dans invoice_data
        if (invoice_data && (invoice_data.pdfUrl || invoice_data.url)) {
            console.log("✅ ENVOI AVEC PDF - URL:", invoice_data.pdfUrl || invoice_data.url);

            result = await watiService.sendInvoiceWithPDF(
                recipient_phone,
                template_name,
                template_params || {},
                {
                    ...invoice_data,
                    media_type: 'document'
                },
                phoneNumber
            );

            console.log("=== RÉPONSE COMPLÈTE DU SERVICE (PDF) ===");
            console.log("localMessageId:", result.localMessageId);
            console.log("watiMessageId:", result.watiMessageId);
            console.log("status:", result.status);
            console.log("TOUT:", JSON.stringify(result, null, 2));
        } else {
            console.log("ℹ️ ENVOI SANS PDF");
            if (!invoice_data) console.log("Raison: invoice_data est undefined/null");
            if (invoice_data && !invoice_data.pdfUrl && !invoice_data.url) console.log("Raison: pdfUrl/url manquant dans invoice_data");

            result = await watiService.sendTemplateMessage(
                recipient_phone,
                template_name,
                template_params || {},
                template_language,
                phoneNumber
            );

            console.log("=== RÉPONSE COMPLÈTE DU SERVICE (Template) ===");
            console.log("localMessageId:", result.localMessageId);
            console.log("watiMessageId:", result.watiMessageId);
            console.log("status:", result.status);
            console.log("TOUT:", JSON.stringify(result, null, 2));
        }
        break;

    case 'text':
        result = await watiService.sendTextMessage(
            recipient_phone,
            message_content,
            phoneNumber
        );

        console.log("=== RÉPONSE COMPLÈTE DU SERVICE (Text) ===");
        console.log("localMessageId:", result.localMessageId);
        console.log("watiMessageId:", result.watiMessageId);
        console.log("status:", result.status);
        console.log("TOUT:", JSON.stringify(result, null, 2));
        break;

    case 'media':
        result = await watiService.sendMediaMessage(
            recipient_phone,
            media_url,
            media_type || 'image',
            message_content,
            phoneNumber
        );

        console.log("=== RÉPONSE COMPLÈTE DU SERVICE (Media) ===");
        console.log("localMessageId:", result.localMessageId);
        console.log("watiMessageId:", result.watiMessageId);
        console.log("status:", result.status);
        console.log("TOUT:", JSON.stringify(result, null, 2));
        break;

    default:
        throw new Error(`Type inconnu: ${message_type}`);
  }

  // 🔥 Maintenant result a localMessageId ET watiMessageId
  console.log("=== [WORKER] RÉSUMÉ FINAL DE L'ENVOI ===");
  console.log("localMessageId:", result?.localMessageId);
  console.log("watiMessageId:", result?.watiMessageId);
  console.log("status:", result?.status);

  return result;
}

async function markMessageAsSent(messageId, clientId, sendResult) {
  // 🔥 Stocker le VRAI ID WATI (pas votre UUID)
  const watiMessageId = sendResult.watiMessageId || sendResult.messageId;
  
  console.log(`📝 Stockage ID WATI: ${watiMessageId} pour message ${messageId}`);

  await query(
    `UPDATE messages SET wa_message_id = $1, wa_status = 'sent', sent_at = NOW() WHERE id = $2`,
    [watiMessageId, messageId]
  );

  const clientTable = `messages_client_${clientId.replace(/-/g, '_')}`;
  await query(
    `UPDATE ${clientTable} SET wa_message_id = $1, wa_status = 'sent', sent_at = NOW() WHERE id = $2`,
    [watiMessageId, messageId]
  );
}

function isFatalError(error) {
  const fatalMessages = [
    'COOLDOWN_ACTIVE',
    'INVALID_MESSAGE_TYPE',
    'CLIENT_NOT_FOUND',
    'INSUFFICIENT_QUOTA',
    'template non trouvé'
  ];
  return fatalMessages.some(msg => error.message.includes(msg));
}

function updateWorkerStats(queueName, success, duration) {
  if (!workerStats.has(queueName)) {
    workerStats.set(queueName, { total: 0, success: 0, failed: 0, avgDuration: 0 });
  }

  const stats = workerStats.get(queueName);
  stats.total++;
  if (success) stats.success++;
  else stats.failed++;
  stats.avgDuration = (stats.avgDuration * (stats.total - 1) + duration) / stats.total;
}

const workers = new Map();

async function initWorkers() {
  try {
    const result = await query(
      `SELECT phone_number FROM whatsapp_numbers WHERE is_active = true`
    );

    const activePhones = result.rows.map(r => r.phone_number);

    for (const phone of activePhones) {
      const normalizedPhone = phone.replace(/[^0-9]/g, '');
      const queueName = `whatsapp-messages-${normalizedPhone}`;

      if (!workers.has(queueName)) {
        logger.info(`🚀 Démarrage worker pour: ${queueName}`);

        const worker = new Worker(queueName, processMessage, WORKER_CONFIG);

        worker.on('completed', (job) => {
          logger.debug(`✅ Job ${job.id} terminé`);
        });

        worker.on('failed', (job, err) => {
          if (!job) return;
          logger.error(`❌ Job ${job.id} échoué: ${err?.message}`);
        });

        worker.on('stalled', (jobId) => {
          logger.warn(`⚠️ Job stalled: ${jobId}`);
        });

        worker.on('error', (err) => {
          logger.error(`🔥 Worker error: ${err.message}`);
        });

        workers.set(queueName, worker);
      }
    }

    if (!statsInterval) {
      startStatsReporting();
    }

    logger.info(`📊 ${workers.size} workers actifs sur ${activePhones.length} numéros`);

  } catch (error) {
    logger.error('❌ Erreur initWorkers:', error);
  }
}

let statsInterval = null;

function startStatsReporting() {
  statsInterval = setInterval(() => {
    logger.info('📈 STATS WORKERS:');
    for (const [name, stats] of workerStats) {
      const successRate = stats.total > 0 ? (stats.success / stats.total * 100).toFixed(1) : 0;
      logger.info(`   ${name}: ${stats.total} jobs | Succès: ${successRate}% | Avg: ${stats.avgDuration.toFixed(0)}ms`);
    }
  }, 60000);
}

setInterval(initWorkers, 300000);

process.on('SIGTERM', async () => {
  logger.info('🛑 Arrêt des workers...');
  if (statsInterval) clearInterval(statsInterval);
  for (const [name, worker] of workers) {
    await worker.close();
  }
  process.exit(0);
});

initWorkers();

module.exports = { processMessage, initWorkers };
