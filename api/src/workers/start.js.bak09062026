// src/workers/start.js
/**
 * Point d'entrée pour démarrer tous les workers
 */
require('dotenv').config();

const logger = require('../utils/logger');

// Importer les workers existants
const messageWorker = require('./message.worker');
const { scheduleCleanupTasks } = require('./cleanup.worker');

// ✅ AJOUT : Importer le nouveau worker unifié pour les queues dynamiques
require('./whatsapp.worker.universal');

// Démarrer les tâches de nettoyage planifiées
scheduleCleanupTasks();

logger.info(`
╔═══════════════════════════════════════════════════════════════╗
║                                                               ║
║              🔧 WORKERS NEXTLTD DÉMARRÉS 🔧                  ║
║                                                               ║
║  📱 Message Worker Legacy: Active                           ║
║     - Concurrency: 5                                        ║
║     - Rate Limit: 50/sec                                    ║
║                                                              ║
║  🚀 WhatsApp Worker Universal: ACTIF                        ║
║     - Workers dynamiques par numéro                         ║
║     - Concurrency: 15 par queue                             ║
║     - Auto-scaling                                          ║
║                                                              ║
║  🧹 Cleanup Worker: Planifié                                ║
║     - Schedule: Tous les jours à 2h00                       ║
║                                                              ║
╚═══════════════════════════════════════════════════════════════╝
`);

// Gestion de l'arrêt gracieux
process.on('SIGTERM', async () => {
  logger.info('SIGTERM reçu, arrêt des workers...');
  
  // Fermer le worker legacy
  if (messageWorker && messageWorker.close) {
    await messageWorker.close();
  }
  
  // Note: Le worker unifié se ferme tout seul via ses propres handlers
  
  setTimeout(() => process.exit(0), 5000);
});

process.on('SIGINT', async () => {
  logger.info('SIGINT reçu, arrêt des workers...');
  
  if (messageWorker && messageWorker.close) {
    await messageWorker.close();
  }
  
  setTimeout(() => process.exit(0), 5000);
});
