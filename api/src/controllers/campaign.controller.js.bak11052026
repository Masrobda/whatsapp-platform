/**
 * POST /api/v1/campaigns/:id/contacts/import
 * Import CSV ou Excel
 */
async function importContactsHandler(request, reply) {
  try {
    const { id } = request.params;
    const clientId = request.user.id;

    const data = await request.file();
    if (!data) {
      return reply.code(400).send({ success: false, code: 'NO_FILE', message: 'Aucun fichier fourni' });
    }

    const buffer = await data.toBuffer();
    const filename = data.filename?.toLowerCase() || '';

    let result;
    if (filename.endsWith('.csv') || data.mimetype === 'text/csv') {
      result = await campaignService.importContactsFromCSV(id, clientId, buffer);
    } else if (filename.endsWith('.xlsx') || filename.endsWith('.xls')) {
      result = await campaignService.importContactsFromExcel(id, clientId, buffer);
    } else {
      return reply.code(400).send({ success: false, code: 'INVALID_FORMAT', message: 'Format non supporté. Utilisez CSV ou Excel (.xlsx)' });
    }

    return reply.code(200).send(result);
  } catch (error) {
    logger.error('Erreur import contacts:', error);
    return reply.code(error.statusCode || 500).send({ success: false, code: error.code || 'INTERNAL_ERROR', message: error.message });
  }
}

/**
 * GET /api/v1/campaigns/:id/logs
 */
async function getCampaignLogsHandler(request, reply) {
  try {
    const { id } = request.params;
    const clientId = request.user.role === 'admin' ? null : request.user.id;
    const filters = {
      limit: request.query.limit || 100,
      level: request.query.level,
    };
    const result = await campaignService.getCampaignLogs(id, clientId, filters);
    return reply.code(200).send(result);
  } catch (error) {
    return reply.code(error.statusCode || 500).send({ success: false, code: error.code || 'INTERNAL_ERROR', message: error.message });
  }
}

module.exports = {
  getGlobalStatsHandler,
  listCampaignsHandler,
  createCampaignHandler,
  getCampaignHandler,
  updateCampaignHandler,
  launchCampaignHandler,
  pauseCampaignHandler,
  cancelCampaignHandler,
  getCampaignStatsHandler,
  getCampaignContactsHandler,
  importContactsHandler,
  getCampaignLogsHandler,
};
