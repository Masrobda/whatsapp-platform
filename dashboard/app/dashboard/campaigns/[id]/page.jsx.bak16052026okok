export default function CampaignDetailPage() {
  const router = useRouter();
  const params = useParams();
  const campaignId = params?.id;
  const isGlobal = campaignId === 'stats';

  const [tab, setTab] = useState('overview');
  const [campaign, setCampaign] = useState(null);
  const [stats, setStats] = useState(null);
  const [contacts, setContacts] = useState([]);
  const [logs, setLogs] = useState([]);
  const [loading, setLoading] = useState(true);
  const [actionLoading, setActionLoading] = useState(null);
  const [toast, setToast] = useState(null);
  const [contactFilters, setContactFilters] = useState({ status: '', search: '', page: 1 });
  const [contactPagination, setContactPagination] = useState({});
  const [logLevel, setLogLevel] = useState('');

  const [showImport, setShowImport] = useState(false);
  const [importFile, setImportFile] = useState(null);
  const [importLoading, setImportLoading] = useState(false);
  const [importResult, setImportResult] = useState(null);

  const showToast = (msg, type = 'success') => {
    setToast({ msg, type });
    setTimeout(() => setToast(null), 4000);
  };

const fetchCampaign = useCallback(async () => {
  if (!campaignId) return;
  try {
    let campRes, statsRes;

    // 1. Récupération des données selon le type de campagne
    if (isGlobal) {
      statsRes = await apiFetch('/campaigns/stats');
      setCampaign({
        name: "Statistiques Globales",
        status: "completed",
        total_contacts: parseInt(statsRes.stats?.total_contacts || statsRes.stats?.total_sent || 0),
        campaign_type: "Global",
        phone_number: "Tous les comptes"
      });
    } else {
      [campRes, statsRes] = await Promise.all([
        apiFetch(`/campaigns/${campaignId}`),
        apiFetch(`/campaigns/${campaignId}/stats`),
      ]);
      setCampaign(campRes.campaign);
      
      // LOG pour voir la structure de statsRes
      console.log('📡 statsRes RAW from API:', statsRes);
      console.log('📡 daily_stats dans statsRes:', statsRes.daily_stats);
    }

    // 2. Normalisation et mise à jour des statistiques
    if (isGlobal && statsRes?.stats) {
      const s = statsRes.stats;
      
      const normalizedStats = {
        campaign: {
          total_contacts: parseInt(s.total_contacts || s.total_sent) || 0,
          sent_count: parseInt(s.total_sent) || 0,
          delivered_count: parseInt(s.total_delivered) || 0,
          read_count: parseInt(s.total_read) || 0,
          failed_count: parseInt(s.total_failed) || 0,
          replied_count: parseInt(s.total_replied) || 0,
          optout_count: parseInt(s.total_optout) || 0,
          actual_cost: parseFloat(s.total_cost) || 0,
          estimated_cost: parseFloat(s.total_cost) || 0,
          delivery_rate: s.total_sent > 0 ? ((s.total_delivered / s.total_sent) * 100).toFixed(1) : "0.0",
          read_rate: s.total_delivered > 0 ? ((s.total_read / s.total_delivered) * 100).toFixed(1) : "0.0",
        },
        contact_status_breakdown: {
          sent: parseInt(s.total_sent) || 0,
          delivered: parseInt(s.total_delivered) || 0,
          read: parseInt(s.total_read) || 0,
          failed: parseInt(s.total_failed) || 0,
        },
        daily_stats: (statsRes.daily_stats || []).map(day => ({
          stat_date: day.stat_date || day.date || day.day,
          name: day.date || day.day,
          date: day.date || day.day,
          sent: parseInt(day.sent || day.sent_count || day.count || 0),
          delivered: parseInt(day.delivered || day.delivered_count || 0),
          read: parseInt(day.read || day.read_count || 0),
          failed: parseInt(day.failed || day.failed_count || 0)
        }))
      };
      
      console.log('📡 normalizedStats (global):', normalizedStats);
      setStats(normalizedStats);
    } else {
      // Pour une campagne unique - UTILISEZ DIRECTEMENT les données de l'API
      // Sans transformation excessive
      const dailyStatsFromAPI = statsRes?.daily_stats || [];
      console.log('📡 rawDailyStats avant mapping:', dailyStatsFromAPI);
      
      const mappedDailyStats = dailyStatsFromAPI.map(day => ({
        stat_date: day.stat_date,
        date: day.stat_date,
        name: day.stat_date,
        sent: parseInt(day.sent || 0),
        delivered: parseInt(day.delivered || 0),
        read: parseInt(day.read || 0),
        failed: parseInt(day.failed || 0)
      }));
      
      console.log('📡 mappedDailyStats:', mappedDailyStats);
      console.log('📡 mappedDailyStats length:', mappedDailyStats.length);
      
      setStats({
        ...statsRes,
        campaign: statsRes?.campaign || statsRes?.stats || {},
        daily_stats: mappedDailyStats
      });
    }
  } catch (error) {
    console.error("Erreur lors du chargement de la campagne :", error);
  }
}, [campaignId, isGlobal, apiFetch]);

  useEffect(() => {
    if (!campaignId || isGlobal) {
      setContacts([]);
      return;
    }

    const fetchContacts = async () => {
      try {
        const qs = new URLSearchParams({
          page: contactFilters.page,
          limit: 20,
          ...(contactFilters.status && { status: contactFilters.status }),
          ...(contactFilters.search && { search: contactFilters.search }),
        }).toString();
        const res = await apiFetch(`/campaigns/${campaignId}/contacts?${qs}`);
        setContacts(res.contacts || []);
        setContactPagination(res.pagination || {});
      } catch {
        setContacts(DEMO_CONTACTS);
      }
    };
    fetchContacts();
  }, [campaignId, contactFilters.page, contactFilters.status, contactFilters.search, isGlobal]);

  useEffect(() => {
    if (!campaignId || isGlobal) {
      setLogs([]);
      return;
    }

    const fetchLogs = async () => {
      try {
        const qs = new URLSearchParams({ limit: 100, ...(logLevel && { level: logLevel }) }).toString();
        const res = await apiFetch(`/campaigns/${campaignId}/logs?${qs}`);
        setLogs(res.logs || []);
      } catch {
        setLogs(DEMO_LOGS);
      }
    };
    fetchLogs();
  }, [campaignId, logLevel, isGlobal]);

  useEffect(() => {
    setLoading(true);
    fetchCampaign().finally(() => setLoading(false));
  }, [fetchCampaign]);

  useEffect(() => {
    if (campaign?.status !== 'running') return;
    const interval = setInterval(fetchCampaign, 15000);
    return () => clearInterval(interval);
  }, [campaign?.status, fetchCampaign]);

  const handleAction = async (action) => {
    setActionLoading(action);
    try {
      await apiFetch(`/campaigns/${campaignId}/${action}`, { method: 'POST' });
      showToast(
        action === 'launch' ? '🚀 Campagne lancée !' :
        action === 'pause' ? '⏸️ Campagne mise en pause' :
        '❌ Campagne annulée'
      );
      fetchCampaign();
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      setActionLoading(null);
    }
  };

  const handleImport = async () => {
    if (!importFile) return;
    setImportLoading(true);
    setImportResult(null);
    try {
      const token = localStorage.getItem('token');
      const formData = new FormData();
      formData.append('file', importFile);
      const res = await fetch(`${API_BASE}/campaigns/${campaignId}/contacts/import`, {
        method: 'POST',
        headers: { ...(token ? { Authorization: `Bearer ${token}` } : {}) },
        body: formData,
      });
      const data = await res.json();
      setImportResult(data);
      showToast(`${data.imported} contacts importés !`);
      fetchCampaign();
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      setImportLoading(false);
