'use client';
import { useState, useEffect, useCallback } from 'react';
import { campaignFetch } from '@/lib/campaigns/api';

const API_BASE = process.env.NEXT_PUBLIC_API_URL || 'https://api.numericexport.com/api/v1';
async function api(path, opts = {}) {
  const token = typeof window !== 'undefined' ? localStorage.getItem('token') : null;
  const res = await fetch(`${API_BASE}${path}`, {
    ...opts, headers: { 'Content-Type':'application/json', ...(token?{Authorization:`Bearer ${token}`}:{}), ...opts.headers }
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.message||`HTTP ${res.status}`);
  return data;
}

// ── DEMO DATA ─────────────────────────────────────────────────
const DEMO_CAMPAIGNS = [
  { id:'camp-1', name:'Factures Avril 2026', status:'completed', total_contacts:8420, sent_count:8420, delivered_count:7820, read_count:4950, failed_count:180, actual_cost:42.1, completed_at: new Date(Date.now()-86400000).toISOString() },
  { id:'camp-2', name:'Promotion Ramadan', status:'running', total_contacts:15200, sent_count:9800, delivered_count:9100, read_count:5800, failed_count:320, actual_cost:49.0 },
  { id:'camp-3', name:'Relance Impayés Q1', status:'paused', total_contacts:2340, sent_count:1200, delivered_count:1100, read_count:680, failed_count:45, actual_cost:6.0 },
];

const DEMO_EXPORTS = [
  { id:'e1', campaign_id:'camp-1', export_type:'pdf', status:'ready', file_url:'https://api.numericexport.com/reports/campaign_abc123.pdf', file_size:284320, created_at: new Date(Date.now()-3600000).toISOString(), completed_at: new Date(Date.now()-3540000).toISOString() },
  { id:'e2', campaign_id:'camp-2', export_type:'csv', status:'ready', file_url:'https://api.numericexport.com/reports/campaign_def456.csv', file_size:98240, created_at: new Date(Date.now()-7200000).toISOString(), completed_at: new Date(Date.now()-7180000).toISOString() },
  { id:'e3', campaign_id:'camp-1', export_type:'pdf', status:'processing', file_url:null, file_size:null, created_at: new Date(Date.now()-120000).toISOString(), completed_at:null },
