           FROM messages
           WHERE id::text = $${values.length}
             AND created_at > NOW() - INTERVAL '7 days'`
        );
      }

      if (parts.length > 0) {
        const result = await query(
          `SELECT * FROM (${parts.join(' UNION ALL ')}) sub ORDER BY prio ASC LIMIT 1`,
