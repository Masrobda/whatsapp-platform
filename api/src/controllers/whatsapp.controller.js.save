// src/controllers/whatsapp.controller.js
const { query } = require('../config/database');
const logger = require('../utils/logger');
const { redisConnection } = require('../config/redis');

/**
 * Liste tous les numéros avec les détails du client associé
 */
   /**
 * Récupère tous les numéros avec leurs assignations
 * (Remplace getAllNumbers)
 */
async function getAllNumbersWithAssignments(req, rep) {
    try {
        // Utilisez la version AVEC STATS
        const sql = `
            SELECT
                wn.*,
                (
                    SELECT json_agg(json_build_object(
                        'client_id', wa.client_id,
                        'client_name', c.company_name,
                        'client_email', c.email,
                        'is_primary', wa.is_primary,
                        'assigned_at', wa.assigned_at,
                        'daily_limit', wa.daily_limit,
                        'notes', wa.notes,
                        'stats', (
                            SELECT json_build_object(
                                'messages_sent_24h', wns.messages_sent_24h,
                                'messages_sent_total', wns.messages_sent_total,
                                'conversations_active', wns.conversations_active,
                                'conversations_total', wns.conversations_total,
                                'last_message_at', wns.last_message_at,
                                'last_activity', wns.last_activity,
                                'quality_rating', wns.quality_rating,
                                'tier_current', wns.tier_current
                            )
                            FROM whatsapp_number_client_stats wns
                            WHERE wns.assignment_id = wa.id
                        )
                    ) ORDER BY wa.is_primary DESC, wa.assigned_at DESC)
                    FROM whatsapp_number_assignments wa
                    JOIN clients c ON wa.client_id = c.id
                    WHERE wa.number_id = wn.id
                ) as assignments,
                (
                    SELECT json_build_object(
                        'client_id', wa.client_id,
                        'client_name', c.company_name,
                        'client_email', c.email
                    )
                    FROM whatsapp_number_assignments wa
                    JOIN clients c ON wa.client_id = c.id
                    WHERE wa.number_id = wn.id AND wa.is_primary = true
                    LIMIT 1
                ) as primary_client
            FROM whatsapp_numbers wn
            ORDER BY wn.created_at DESC;
        `;

        const res = await query(sql);
        return rep.send({ success: true, data: res.rows });
    } catch (err) {
        logger.error('Erreur lecture numéros:', err);
        return rep.status(500).send({ success: false, message: "Erreur serveur" });
    }
}


/**
 * Récupère les statistiques d'un client pour un numéro
 */
async function getClientNumberStats(req, rep) {
    try {
        const { numberId, clientId } = req.params;

        const result = await query(`
            SELECT 
                wa.*,
                wns.*,
                c.company_name,
                c.email
            FROM whatsapp_number_assignments wa
            LEFT JOIN whatsapp_number_client_stats wns ON wa.id = wns.assignment_id
            JOIN clients c ON wa.client_id = c.id
            WHERE wa.number_id = $1 AND wa.client_id = $2
        `, [numberId, clientId]);

        if (result.rowCount === 0) {
            return rep.status(404).send({ success: false, message: "Assignation non trouvée" });
        }

        return rep.send({ success: true, data: result.rows[0] });
    } catch (err) {
        logger.error('Erreur récupération stats client:', err);
        return rep.status(500).send({ success: false, message: err.message });
    }
}

/**
 * Met à jour les statistiques d'un client pour un numéro
 */
async function updateClientNumberStats(req, rep) {
    try {
        const { numberId, clientId } = req.params;
        const stats = req.body;

        // Récupérer l'ID de l'assignation
        const assignment = await query(
            'SELECT id FROM whatsapp_number_assignments WHERE number_id = $1 AND client_id = $2',
            [numberId, clientId]
        );

        if (assignment.rowCount === 0) {
            return rep.status(404).send({ success: false, message: "Assignation non trouvée" });
        }

        const assignmentId = assignment.rows[0].id;

        // Mettre à jour ou insérer les stats
        const result = await query(`
            INSERT INTO whatsapp_number_client_stats 
            (assignment_id, messages_sent_24h, messages_sent_total, conversations_active, 
             conversations_total, last_message_at, quality_rating, tier_current, daily_limit)
            VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
            ON CONFLICT (assignment_id) DO UPDATE SET
                messages_sent_24h = EXCLUDED.messages_sent_24h,
                messages_sent_total = whatsapp_number_client_stats.messages_sent_total + EXCLUDED.messages_sent_24h,
                conversations_active = EXCLUDED.conversations_active,
                conversations_total = whatsapp_number_client_stats.conversations_total + 1,
                last_message_at = EXCLUDED.last_message_at,
                quality_rating = EXCLUDED.quality_rating,
                tier_current = EXCLUDED.tier_current,
                daily_limit = EXCLUDED.daily_limit,
                last_activity = NOW()
            RETURNING *
        `, [
            assignmentId,
            stats.messages_sent_24h || 0,
            stats.messages_sent_24h || 0,
            stats.conversations_active || 0,
            stats.conversations_total || 0,
            stats.last_message_at || null,
            stats.quality_rating || null,
            stats.tier_current || null,
            stats.daily_limit || 1000
        ]);

        logger.info(`Stats mises à jour pour client ${clientId} sur numéro ${numberId}`);
        return rep.send({ success: true, data: result.rows[0] });
    } catch (err) {
        logger.error('Erreur mise à jour stats client:', err);
        return rep.status(500).send({ success: false, message: err.message });
    }
}

