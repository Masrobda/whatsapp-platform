'use client';

import { useCallback, useEffect, useState } from 'react';
import {
  AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip,
  ResponsiveContainer, Legend,
} from 'recharts';
import { FiDownload, FiRefreshCw } from 'react-icons/fi';

type Summary = {
  total: number;
  delivrees: number;
  consultees: number;
  recues: number;
  en_acheminement: number;
  en_file: number;
  non_delivrees: number;
  taux_delivrabilite: number;
  taux_consultation: number;
};

type DayPoint = {
  jour: string;
  delivrees: number;
  en_acheminement: number;
  non_delivrees: number;
  total: number;
};

export default function DeliveryReport({ token }: { token: string }) {
  const [days, setDays] = useState(30);
  const [summary, setSummary] = useState<Summary | null>(null);
  const [byDay, setByDay] = useState<DayPoint[]>([]);
  const [loading, setLoading] = useState(false);
  const [exporting, setExporting] = useState(false);

  const load = useCallback(async () => {
    if (!token) return;
    setLoading(true);
    try {
      const res = await fetch(`/api/v1/socadel/stats/delivery?days=${days}`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const json = await res.json();
      if (json.success) {
        setSummary(json.summary);
        setByDay(json.byDay || []);
      }
    } finally {
      setLoading(false);
    }
  }, [token, days]);

  useEffect(() => {
    load();
  }, [load]);

  const exportNonDelivrees = async () => {
    if (!token) return;
    setExporting(true);
    try {
      const res = await fetch(
        `/api/v1/socadel/export-non-delivrees?days=${days}`,
        { headers: { Authorization: `Bearer ${token}` } }
      );

      if (!res.ok) {
        if (res.status === 404) {
          alert('Aucune facture non délivrée sur cette période.');
        } else {
          alert("Erreur lors de l'export.");
        }
        return;
      }

      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `factures_non_delivrees_${days}j_${new Date()
        .toISOString()
        .slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    } catch {
      alert('Erreur réseau lors de l\'export.');
    } finally {
      setExporting(false);
    }
  };

  if (!summary) {
    return (
      <div className="p-8 text-center text-slate-400">
        {loading ? 'Chargement du rapport…' : 'Aucune donnée'}
      </div>
    );
  }

  const total = summary.total || 1;
  const pctDelivrees    = Math.round((summary.delivrees / total) * 1000) / 10;
  const pctAcheminement = Math.round((summary.en_acheminement / total) * 1000) / 10;
  const pctNonDelivrees = Math.round((summary.non_delivrees / total) * 1000) / 10;

  return (
    <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
      {/* ── Header ── */}
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 className="text-lg font-bold text-slate-800">
            Rapport de livraison des factures
          </h2>
          <p className="text-xs text-slate-500 mt-1">
            {summary.total.toLocaleString('fr-FR')} factures sur les {days} derniers jours
          </p>
        </div>

        <div className="flex flex-wrap gap-2 items-center">
          <select
            value={days}
            onChange={(e) => setDays(parseInt(e.target.value, 10))}
            className="text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white"
          >
            <option value={7}>7 derniers jours</option>
            <option value={15}>15 derniers jours</option>
            <option value={30}>30 derniers jours</option>
            <option value={60}>60 derniers jours</option>
            <option value={90}>90 derniers jours</option>
          </select>

          <button
            type="button"
            onClick={load}
            disabled={loading}
            className="inline-flex items-center gap-1.5 px-3 py-2 bg-slate-100 hover:bg-slate-200
                       text-slate-700 rounded-lg text-sm font-medium transition disabled:opacity-50"
          >
            <FiRefreshCw size={14} className={loading ? 'animate-spin' : ''} />
            Actualiser
          </button>

          <button
            type="button"
            onClick={exportNonDelivrees}
            disabled={exporting}
            className="inline-flex items-center gap-1.5 px-3 py-2 bg-blue-700 hover:bg-blue-800
                       text-white rounded-lg text-sm font-medium transition disabled:opacity-50"
          >
            <FiDownload size={14} />
            {exporting ? 'Export…' : 'Exporter les non délivrées'}
          </button>
        </div>
      </div>

      {/* ── Barre de progression ── */}
      <div>
        <div className="flex h-3 rounded-full overflow-hidden bg-slate-100">
          <div
            className="bg-emerald-500"
            style={{ width: `${pctDelivrees}%` }}
            title={`Délivrées : ${pctDelivrees}%`}
          />
          <div
            className="bg-amber-400"
            style={{ width: `${pctAcheminement}%` }}
            title={`En acheminement : ${pctAcheminement}%`}
          />
          <div
            className="bg-rose-500"
            style={{ width: `${pctNonDelivrees}%` }}
            title={`Non délivrées : ${pctNonDelivrees}%`}
          />
        </div>

        <div className="flex flex-wrap gap-4 mt-3 text-xs">
          <span className="inline-flex items-center gap-1.5">
            <span className="w-2.5 h-2.5 rounded-full bg-emerald-500" />
            <span className="text-slate-600">Délivrées</span>
            <span className="font-semibold text-slate-800">{pctDelivrees}%</span>
          </span>
          <span className="inline-flex items-center gap-1.5">
            <span className="w-2.5 h-2.5 rounded-full bg-amber-400" />
            <span className="text-slate-600">En acheminement</span>
            <span className="font-semibold text-slate-800">{pctAcheminement}%</span>
          </span>
          <span className="inline-flex items-center gap-1.5">
            <span className="w-2.5 h-2.5 rounded-full bg-rose-500" />
            <span className="text-slate-600">Non délivrées</span>
            <span className="font-semibold text-slate-800">{pctNonDelivrees}%</span>
          </span>
        </div>
      </div>

      {/* ── Cartes synthétiques ── */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        <Card
          label="Taux de délivrabilité"
          value={`${summary.taux_delivrabilite}%`}
          sub={`${summary.delivrees.toLocaleString('fr-FR')} factures reçues`}
          accent="emerald"
        />
        <Card
          label="Taux de consultation"
          value={`${summary.taux_consultation}%`}
          sub={`${summary.consultees.toLocaleString('fr-FR')} ouvertes par les clients`}
          accent="emerald"
        />
        <Card
          label="En acheminement"
          value={summary.en_acheminement.toLocaleString('fr-FR')}
          sub="Routage en cours chez l'opérateur"
          accent="amber"
        />
        <Card
          label="Non délivrées"
          value={summary.non_delivrees.toLocaleString('fr-FR')}
          sub="Adresse ou canal indisponible"
          accent="rose"
        />
      </div>

      {/* ── Graphique d'évolution ── */}
      {byDay.length > 0 && (
        <div>
          <p className="text-sm font-semibold text-slate-700 mb-3">
            Évolution quotidienne
          </p>
          <ResponsiveContainer width="100%" height={260}>
            <AreaChart data={byDay}>
              <defs>
                <linearGradient id="drColorDelivrees" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="#10b981" stopOpacity={0.6} />
                  <stop offset="95%" stopColor="#10b981" stopOpacity={0} />
                </linearGradient>
                <linearGradient id="drColorAcheminement" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="#fbbf24" stopOpacity={0.6} />
                  <stop offset="95%" stopColor="#fbbf24" stopOpacity={0} />
                </linearGradient>
                <linearGradient id="drColorNonDelivrees" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="#f43f5e" stopOpacity={0.6} />
                  <stop offset="95%" stopColor="#f43f5e" stopOpacity={0} />
                </linearGradient>
              </defs>
              <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
              <XAxis
                dataKey="jour"
                tick={{ fontSize: 11 }}
                tickFormatter={(v) =>
                  new Date(v).toLocaleDateString('fr-FR', {
                    day: '2-digit',
                    month: '2-digit',
                  })
                }
              />
              <YAxis tick={{ fontSize: 11 }} />
              <Tooltip
                labelFormatter={(v) => new Date(v).toLocaleDateString('fr-FR')}
              />
              <Legend wrapperStyle={{ fontSize: 12 }} />
              <Area
                type="monotone"
                dataKey="delivrees"
                name="Délivrées"
                stroke="#10b981"
                fill="url(#drColorDelivrees)"
              />
              <Area
                type="monotone"
                dataKey="en_acheminement"
                name="En acheminement"
                stroke="#fbbf24"
                fill="url(#drColorAcheminement)"
              />
              <Area
                type="monotone"
                dataKey="non_delivrees"
                name="Non délivrées"
                stroke="#f43f5e"
                fill="url(#drColorNonDelivrees)"
              />
            </AreaChart>
          </ResponsiveContainer>
        </div>
      )}
    </div>
  );
}

/* ── Carte interne ── */
function Card({
  label,
  value,
  sub,
  accent,
}: {
  label: string;
  value: string;
  sub: string;
  accent: 'emerald' | 'amber' | 'rose';
}) {
  const colors = {
    emerald: 'from-emerald-50 to-white border-emerald-200 text-emerald-800',
    amber:   'from-amber-50 to-white border-amber-200 text-amber-800',
    rose:    'from-rose-50 to-white border-rose-200 text-rose-800',
  };
  return (
    <div
      className={`bg-gradient-to-br ${colors[accent]} p-4 rounded-xl border shadow-sm`}
    >
      <p className="text-[11px] uppercase font-medium opacity-80">{label}</p>
      <p className="text-2xl font-bold mt-1">{value}</p>
      <p className="text-[10px] text-slate-500 mt-1">{sub}</p>
    </div>
  );
}
