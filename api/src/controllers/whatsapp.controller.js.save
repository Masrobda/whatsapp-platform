}


/**
 * Ajouter un nouveau numéro
 */
async function addNumber(req, rep) {
    try {
        const { phone_number, display_name, client_id, notes, daily_conversation_limit } = req.body;

        if (!phone_number) {
            return rep.status(400).send({ success: false, message: "Numéro requis" });
        }

        // IMPORTANT: Ne nettoyer QUE les espaces, garder le +
        const cleanPhone = phone_number.trim().replace(/\s+/g, '');
        
        // Vérifier que le numéro commence bien par +
        if (!cleanPhone.startsWith('+')) {
            return rep.status(400).send({ 
                success: false, 
                message: "Le numéro doit être au format international avec + (ex: +237689000000)" 
            });
        }

        // Vérifier le format (chiffres seulement après le +)
        if (!/^\+\d{8,15}$/.test(cleanPhone)) {
            return rep.status(400).send({ 
                success: false, 
                message: "Format invalide. Utilisez + suivi de 8 à 15 chiffres" 
            });
        }

        const result = await query(
            `INSERT INTO whatsapp_numbers
             (phone_number, display_name, client_id, notes, daily_conversation_limit, is_active, created_at, updated_at)
             VALUES ($1, $2, $3, $4, $5, true, NOW(), NOW())
             RETURNING *`,
            [cleanPhone, display_name || null, client_id || null, notes || null, daily_conversation_limit || 1000]
        );

        logger.info(`Nouveau numéro ajouté: ${cleanPhone}`);
        return rep.send({ success: true, data: result.rows[0] });
    } catch (err) {
        logger.error('Erreur ajout numéro:', err);
        return rep.status(500).send({ success: false, message: err.message });
    }
}


/**
 * Modifier un numéro
 */
async function updateNumber(req, rep) {
    try {
        const { id } = req.params;
        const { display_name, notes, daily_conversation_limit, is_active } = req.body;

        const updates = [];
        const values = [];
        let paramIndex = 1;

        if (display_name !== undefined) {
            updates.push(`display_name = $${paramIndex++}`);
            values.push(display_name);
        }
        if (notes !== undefined) {
            updates.push(`notes = $${paramIndex++}`);
            values.push(notes);
        }
        if (daily_conversation_limit !== undefined) {
            updates.push(`daily_conversation_limit = $${paramIndex++}`);
            values.push(daily_conversation_limit);
        }
        if (is_active !== undefined) {
            updates.push(`is_active = $${paramIndex++}`);
            values.push(is_active);
        }

        updates.push(`updated_at = NOW()`);

        if (updates.length === 0) {
            return rep.status(400).send({ success: false, message: "Aucune donnée à mettre à jour" });
        }

        values.push(id);
        const sql = `UPDATE whatsapp_numbers SET ${updates.join(', ')} WHERE id = $${paramIndex} RETURNING *`;

        const result = await query(sql, values);

        if (result.rowCount === 0) {
            return rep.status(404).send({ success: false, message: "Numéro non trouvé" });
        }

        logger.info(`Numéro ${id} mis à jour`);
        return rep.send({ success: true, data: result.rows[0] });
    } catch (err) {
        logger.error('Erreur mise à jour numéro:', err);
        return rep.status(500).send({ success: false, message: err.message });
    }
}

/**
 * Activation/Désactivation d'un numéro
 */
async function toggleNumberStatus(req, rep) {
    try {
        const { id } = req.params;
        const { is_active } = req.body;

        const result = await query(
            `UPDATE whatsapp_numbers 
             SET is_active = $1, updated_at = NOW() 
             WHERE id = $2 
             RETURNING *`,
            [is_active, id]
        );

        if (result.rowCount === 0) {
            return rep.status(404).send({ success: false, message: "Numéro non trouvé" });
        }

        logger.info(`Numéro ${id} ${is_active ? 'activé' : 'désactivé'}`);
        return rep.send({ 
            success: true, 
            message: `Numéro ${is_active ? 'activé' : 'désactivé'} avec succès`,
            data: result.rows[0]
        });
    } catch (err) {
        logger.error('Erreur changement statut:', err);
        return rep.status(500).send({ success: false, message: err.message });
    }
}

