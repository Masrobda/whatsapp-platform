  // ============================================================
  // UPDATE MESSAGE STATUS — via batch engine
  // ============================================================
  async updateMessageStatus(whatsappMessageId, status, timestamp, eventType, localMessageId = null, failedDetail = null) {
    console.log(`📨 WEBHOOK - localId=${localMessageId}, waId=${whatsappMessageId}, event=${eventType}`);

    if (!localMessageId && !whatsappMessageId) return;

    if (localMessageId && this.isDuplicateEvent(localMessageId, eventType)) {
      logger.debug(`[WEBHOOK] Doublon ignoré: ${localMessageId}|${eventType}`);
      return;
    }

    try {
      const internalStatus = mapWatiStatus(eventType);
      const timestampDate  = timestamp ? new Date(parseInt(timestamp) * 1000) : new Date();
      const eventTypeUpper = eventType?.toUpperCase() || '';

      const message = await this.findMessage(localMessageId, whatsappMessageId);

      if (!message) {
        logger.warn('⚠️ Message non trouvé → orphan_webhooks:', { localMessageId, whatsappMessageId });
        batchEngine.scheduleOrphan({
          localMessageId,
          whatsappMessageId,
          eventType,
          rawPayload:   { status, timestamp, failedDetail },
          sent_at:      eventTypeUpper.includes('SENT')      ? timestampDate : null,
          delivered_at: eventTypeUpper.includes('DELIVERED') ? timestampDate : null,
          read_at:      eventTypeUpper.includes('READ')      ? timestampDate : null,
          failed_at:    eventTypeUpper.includes('FAILED')    ? timestampDate : null,
        });
        return;
      }

      if (!isValidStatusTransition(message.wa_status, internalStatus)) {
        logger.info('⚠️ Transition invalide:', { current: message.wa_status, new: internalStatus });
        return;
      }
      if (message.wa_status === internalStatus) {
        logger.debug('⏭️ Statut identique ignoré:', { messageId: message.id });
        return;
      }

      batchEngine.schedule(
        message.id,
        message.client_id,
        internalStatus,
        timestampDate,
        whatsappMessageId !== message.wa_message_id ? whatsappMessageId : null,
        failedDetail
      );

      if (localMessageId) {
        query(
          `UPDATE orphan_webhooks SET processed = true WHERE local_message_id = $1`,
          [localMessageId]
        ).catch(() => {});
      }

      setImmediate(() => {
        this.triggerClientWebhooks(message.id, internalStatus).catch(err =>
          logger.error('triggerClientWebhooks:', err.message)
        );

        updateCampaignContactStatus(whatsappMessageId, internalStatus, message.id, message.client_id).catch(err =>
          logger.error('updateCampaignContactStatus:', err.message)
        );

        query(
          `SELECT  campaign_id FROM messages WHERE id = $1 AND created_at = $2 LIMIT 1`,
          [message.id, message.created_at]  // created_at → accès direct à la partition exacte
        ).then(r => {
          const campaignId = r.rows[0]?.campaign_id || null;
          triggerWorkflowFromCampaign(campaignId, message.recipient_phone, internalStatus)
            .catch(err => logger.error('Trigger automation:', err.message));
          if (campaignId) {
            triggerWorkflowFromCampaign(null, message.recipient_phone, internalStatus)
              .catch(err => logger.error('Trigger automation (global):', err.message));
          }
        }).catch(() => {});
      });

      logger.info(`✅ Status batché: ${message.id} → ${internalStatus}`);

    } catch (error) {
      logger.error('❌ Erreur updateMessageStatus:', error.message);
    }
  }

