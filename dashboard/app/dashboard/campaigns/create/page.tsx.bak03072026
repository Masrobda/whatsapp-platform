'use client';
import { useState, useRef, useCallback, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import * as XLSX from 'xlsx';
import Cookies from 'js-cookie';

const API_BASE = process.env.NEXT_PUBLIC_API_URL || 'https://api.numericexport.com/api/v1';

async function apiFetch(path: string, options: RequestInit = {}) {
  const token = Cookies.get('token');

  if (!token) {
    if (typeof window !== 'undefined') {
      window.location.href = '/login';
    }
    throw new Error('Non authentifié');
  }

  // Construire les headers sans Content-Type par défaut
  const headers: Record<string, string> = {
    'Authorization': `Bearer ${token}`,
  };

  // Ajouter Content-Type uniquement si on a un body à envoyer
  const hasBody = options.body !== undefined && options.body !== null;
  if (hasBody) {
    headers['Content-Type'] = 'application/json';
  }

  const res = await fetch(`${API_BASE}${path}`, {
    method: options.method || 'GET',
    headers: {
      ...headers,
      ...options.headers as Record<string, string>,
    },
    body: options.body || undefined,
  });

  if (res.status === 401) {
    Cookies.remove('token');
    Cookies.remove('user');
    window.location.href = '/login?session=expired';
    throw new Error('Session expirée');
  }

  // Pour les réponses sans contenu (204 No Content)
  if (res.status === 204) {
    return { success: true };
  }

  const text = await res.text();
  if (!text) return { success: true };

  if (!res.ok) {
    try {
      const err = JSON.parse(text);
      throw new Error(err.message || `HTTP ${res.status}`);
    } catch {
      throw new Error(`HTTP ${res.status}`);
    }
  }

  return JSON.parse(text);
}

// ============================================================
// TYPES
// ============================================================
type SendMode = 'instant' | 'batch' | 'scheduled' | 'smart';
type CampaignType = 'broadcast' | 'drip' | 'trigger';

interface Contact {
  phone_number: string;
  name: string;
  variables: Record<string, string>;
  _ordered_values?: string[];
}

interface TemplateParam {
  name: string;
  label: string;
  params: string[];
  body_content?: string;
  header_content?: string;
  footer_content?: string;
}

interface FormData {
  name: string;
  description: string;
  campaign_type: CampaignType;
  category: string;
  priority: number;
  phone_number: string;
  template_name: string;
  template_language: string;
  template_params: Record<string, string>;
  send_mode: SendMode;
  batch_size: number;
  batch_interval_seconds: number;
  daily_limit: number;
  rate_per_minute: number;
  scheduled_at: string;
  contacts: Contact[];
  tags: string[];
}

interface Step {
  id: number;
  label: string;
  icon: string;
  desc: string;
}

interface Toast {
  msg: string;
  type: string;
}

