/**
 * Réduit le poids du HTML (Gmail tronque au-delà de ~102 Ko) : les styles inline répétés
 * sont remplacés par des classes définies dans <style>. Les attributs bgcolor/width conservent
 * les barres de progression même si un client ignore la balise <style>.
 */
function compactStyles(html) {
  const counts = new Map();
  html.replace(/ style="([^"]+)"/g, (m, st) => counts.set(st, (counts.get(st) || 0) + 1) && m);
  const map = new Map();
  let css = '';
  let i = 0;
  for (const [st, c] of counts) {
    if (c >= 3 && st.length > 35) {
      const cl = `s${(i++).toString(36)}`;
      map.set(st, cl);
      css += `.${cl}{${st}}`;
    }
  }
  const out = html.replace(/ style="([^"]+)"/g, (m, st) => (map.has(st) ? ` class="${map.get(st)}"` : m));
  return out.replace('</title>', `</title><style>${css}</style>`);
}

