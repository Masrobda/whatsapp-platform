  <tr><td style="padding:30px 28px 24px 28px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid ${C.border};"><tr><td style="padding-top:12px;font-family:${FONT};font-size:10px;line-height:1.6;color:#8a9a92;">
      Rapport automatique généré le ${esc(generatedLabel)} (heure de Douala) · périmètre : factures du cycle ${data.cycle}/${data.annee} (émission à venir).<br/>
      <b>Distribuée</b> = statut délivré ou lu · <b>Taux de succès</b> = distribuées / factures à distribuer · <b>Taux de lecture</b> = lues / distribuées · <b>Taux d'échec</b> = échecs / envois tentés.<br/>
      <b>Recouvrement</b> = montant payé des factures distribuées / montant distribué · <b>Délai de paiement</b> = date de paiement − jour de distribution · <b>Score</b> = 40 % succès + 20 % lecture + 40 % recouvrement.<br/>
      Objectifs de référence : succès ${fmt(TARGET_SUCCESS)} %, recouvrement ${fmt(TARGET_RECOUV)} %. Détail complet par agence et listes de relance : pièces jointes.
    </td></tr></table>
  </td></tr>
</table></td></tr></table>
</body></html>`;

  return compactStyles(html.replace(/>\s+</g, '><').replace(/\n\s*/g, ''));
}

/* ───────────────────────── CSV ───────────────────────── */
function toCsv(headers, rows) {
  const e = (v) => {
    const s = v == null ? '' : v instanceof Date ? ymd(v) : String(v);
    return /[";\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  return '\uFEFF' + [headers.map(e).join(';'), ...rows.map((r) => r.map(e).join(';'))].join('\n');
}

function buildAgencesCsv(data) {
  const h = ['Agence', 'Division', 'Factures', 'Montant', 'Contacts valides', 'Taux contacts valides (%)', 'Envois tentés', 'Distribuées', 'Taux de succès (%)', 'Lues', 'Taux de lecture (%)', 'Échecs', "Taux d'échec (%)", 'Montant distribué', 'Factures payées', 'Montant payé', 'Recouvrement (%)', 'Délai paiement (j)', 'Délai distribution (h)', 'Score'];
  return toCsv(h, (data.byAgence || []).map((r) => [r.label, r.parent, r.total, r.montant, r.valides, r.tx_valide, r.envoyees, r.distribuees, r.tx_succes, r.lues, r.tx_lecture, r.echecs, r.tx_echec, r.montant_distribue, r.payees, r.montant_paye, r.tx_recouv, r.delai_paiement == null ? '' : Number(r.delai_paiement).toFixed(1), r.delai_dist_h == null ? '' : Number(r.delai_dist_h).toFixed(1), r.score]));
}

function buildRelanceCsv(data) {
  const h = ['Priorité', 'Région', 'Division', 'MRC', 'Agence', 'Catégorie', 'Client', 'Contrat', 'Facture', 'Téléphone', 'Montant', 'Échéance', 'Jours avant échéance', 'Statut WhatsApp'];
  const map = (label) => (r) => [label, r.region, r.division, r.mrc, r.agence, r.categorie, r.nom_client, r.numero_contrat, r.numero_facture, r.telephone, r.montant, r.due_date, r.jours, r.st];
  return toCsv(h, [...(data.relanceSoon || []).map(map('Échéance ≤ 3 j')), ...(data.relanceLate || []).map(map('Échue'))]);
}

/* ───────────────────────── Envoi email ───────────────────────── */
function buildReportTransporter() {
  const host = process.env.REPORT_SMTP_HOST;
  const user = process.env.REPORT_SMTP_USER;
  const pass = process.env.REPORT_SMTP_PASSWORD;
  if (!host || !user) {
    const emailService = require('./email.service');
    return emailService.transporter || (typeof emailService.getTransporter === 'function' ? emailService.getTransporter() : null);
  }
  return nodemailer.createTransport({
    host,
    port: parseInt(process.env.REPORT_SMTP_PORT || '587', 10),
    secure: String(process.env.REPORT_SMTP_SECURE || 'false').toLowerCase() === 'true',
    auth: { user, pass },
  });
}

async function sendInvoiceReportEmail({ to, cc } = {}) {
  const recipients =
    to ||
    process.env.SOCADEL_INVOICE_REPORT_EMAIL_TO ||
    process.env.SOCADEL_REPORT_EMAIL_TO ||
    process.env.REPORT_EMAIL_TO ||
    'patrick.tondjou@camlight.cm';

  const data = await buildReportData();
  const html = buildReportHtml(data); // version email (allégée)
  const fullHtml = buildReportHtml(data, { full: true }); // version complète en pièce jointe
  const csvAgences = buildAgencesCsv(data);
  const csvRelance = buildRelanceCsv(data);
  const day = ymd(data.today);
  logger.info(`[SOCADEL-INVOICE] HTML=${html.length} o · complet=${fullHtml.length} o`);

  try {
    fs.writeFileSync('/tmp/socadel-invoice-report-email.html', html, 'utf8');
    fs.writeFileSync('/tmp/socadel-invoice-report-full.html', fullHtml, 'utf8');
  } catch (err) {
    logger.warn(`[SOCADEL-INVOICE] écriture /tmp: ${err.message}`);
  }

  const g = data.global;
  const subject = `Socadel — Distribution des factures WhatsApp — Cycle ${data.cycle}/${data.annee} — ${day}`;
  const text =
    `Distribution des factures WhatsApp — cycle ${data.cycle}/${data.annee} — ${day}\n` +
    `Factures à distribuer : ${g.total}\nDistribuées : ${g.distribuees} (${g.tx_succes} %)\n` +
    `Taux de lecture : ${g.tx_lecture} %\nÉchecs : ${g.echecs} (${g.tx_echec} %)\n` +
    `Montant distribué : ${g.montant_distribue}\nMontant payé : ${g.montant_paye} (${g.tx_recouv} %)\n`;

  const transporter = buildReportTransporter();
  if (!transporter) throw new Error('Aucun transporter SMTP disponible pour le rapport');
  const from = process.env.REPORT_EMAIL_FROM || process.env.EMAIL_FROM || process.env.SMTP_FROM || process.env.SMTP_USER;

  if (typeof transporter.verify === 'function') {
    try {
      await withTimeout(transporter.verify(), 15000, 'smtp.verify');
    } catch (err) {
      logger.warn(`[SOCADEL-INVOICE] SMTP verify: ${err.message}`);
    }
  }

  const info = await withTimeout(
    transporter.sendMail({
      from,
      to: recipients,
      cc: cc || process.env.SOCADEL_INVOICE_REPORT_EMAIL_CC || process.env.SOCADEL_REPORT_EMAIL_CC || undefined,
      subject,
      html,
      text,
      attachments: [
        { filename: `socadel-rapport-complet-${day}.html`, content: Buffer.from(fullHtml, 'utf8'), contentType: 'text/html; charset=utf-8' },
        { filename: `socadel-agences-${day}.csv`, content: Buffer.from(csvAgences, 'utf8'), contentType: 'text/csv; charset=utf-8' },
        { filename: `socadel-relance-${day}.csv`, content: Buffer.from(csvRelance, 'utf8'), contentType: 'text/csv; charset=utf-8' },
      ],
    }),
    120000,
    'sendMail'
  );
  logger.info(`[SOCADEL-INVOICE] Email OK id=${info.messageId}`);
  return { success: true, to: recipients, date: day, messageId: info.messageId };
}

module.exports = {
  buildReportData,
  buildReportHtml,
  buildAgencesCsv,
  buildRelanceCsv,
  sendInvoiceReportEmail,
  enrich,
};
