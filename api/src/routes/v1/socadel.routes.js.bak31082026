// api/src/routes/v1/socadel.routes.js
'use strict';

const { query } = require('../../config/database');
const { generateBordereauPDF } = require('../../services/pdf.service');

/**
 * TERRAIN seulement si :
 * - check OK
 * - abonné
 * - activated_at >= check_date
 */
function computeResponsable(checkStatus, statut, activatedAt, checkDate) {
  if (checkStatus !== 'OK' || statut !== 'ABONNE') return 'AUTRES';
  if (!activatedAt || !checkDate) return 'AUTRES';

  const act = new Date(activatedAt).getTime();
  const chk = new Date(checkDate).getTime();
  if (Number.isNaN(act) || Number.isNaN(chk)) return 'AUTRES';

  // activation >= check → passage terrain plausible
  return act >= chk ? 'TERRAIN' : 'AUTRES';
}

async function socadelRoutes(fastify, opts) {
  const auth = { preHandler: [fastify.authenticateJWT] };

  // ────────────────────────────────────────────────
  // GET /itineraries – liste distincte des itinéraires
  // ────────────────────────────────────────────────
  fastify.get('/itineraries', auth, async (request, reply) => {
    const result = await query(
      `SELECT DISTINCT itineraires
       FROM socadel_contacts
       WHERE itineraires IS NOT NULL AND itineraires <> ''
       ORDER BY itineraires`
    );
    return reply.send({
      success: true,
      data: result.rows.map((r) => r.itineraires)
    });
  });

  // ────────────────────────────────────────────────
  // GET /data – données filtrées par itinéraires + recherche
  // ────────────────────────────────────────────────
  fastify.get('/data', auth, async (request, reply) => {
    const {
      itineraires,
      meter_no,
      service_no,
      page = 1,
      limit = 50
    } = request.query;

    if (!itineraires) {
      return reply.code(400).send({
        success: false,
        message: 'Paramètre itineraires requis'
      });
    }

    const list = itineraires.split(',').map((i) => i.trim()).filter(Boolean);
    if (list.length === 0) {
      return reply.code(400).send({ success: false, message: 'Aucun itinéraire valide' });
    }

    const params = [list];
    let where = `WHERE itineraires = ANY($1::text[])`;

    if (meter_no) {
      params.push(`%${meter_no}%`);
      where += ` AND meter_no ILIKE $${params.length}`;
    }
    if (service_no) {
      params.push(`%${service_no}%`);
      where += ` AND service_no ILIKE $${params.length}`;
    }

    const offset = (parseInt(page, 10) - 1) * parseInt(limit, 10);

    const countRes = await query(
      `SELECT COUNT(*)::int AS total FROM socadel_contacts ${where}`,
      params
    );
    const total = countRes.rows[0].total;

    const dataRes = await query(
      `SELECT
         id, region, division, agence, service_no, noms, categorie, mrc,
         ref_geo, itineraires, meter_no, numero_telephone, rapport,
         check_status, check_date, api_status, api_date, statut, responsable, activated_at
       FROM socadel_contacts
       ${where}
       ORDER BY itineraires, service_no
       LIMIT $${params.length + 1} OFFSET $${params.length + 2}`,
      [...params, parseInt(limit, 10), offset]
    );

    return reply.send({
      success: true,
      data: dataRes.rows,
      pagination: {
        total,
        page: parseInt(page, 10),
        limit: parseInt(limit, 10),
        totalPages: Math.ceil(total / parseInt(limit, 10))
      }
    });
  });

  // ────────────────────────────────────────────────
  // PUT /update-check – saisie manuelle CHECK + recalcul responsable
  // ────────────────────────────────────────────────
    fastify.put('/update-check', auth, async (request, reply) => {
    const { id, check_status } = request.body;

    if (!id) {
      return reply.code(400).send({ success: false, message: 'id requis' });
    }

    const current = await query(
      `SELECT statut, activated_at, check_date
       FROM socadel_contacts WHERE id = $1`,
      [id]
    );
    if (current.rows.length === 0) {
      return reply.code(404).send({ success: false, message: 'Contact introuvable' });
    }

    const row = current.rows[0];
    const isOk = check_status === 'OK';
    const newCheckDate = isOk ? new Date() : null;

    const responsable = computeResponsable(
      isOk ? 'OK' : null,
      row.statut || 'NON ABONNE',
      row.activated_at,
      newCheckDate || row.check_date
    );

    await query(
      `UPDATE socadel_contacts
       SET check_status = $1,
           check_date   = CASE WHEN $1 = 'OK' THEN NOW() ELSE NULL END,
           responsable  = $2,
           updated_at   = NOW()
       WHERE id = $3`,
      [isOk ? 'OK' : null, responsable, id]
    );

    return reply.send({
      success: true,
      data: {
        check_status: isOk ? 'OK' : null,
        check_date: isOk ? new Date().toISOString() : null,
        responsable
      }
    });
  });

  // ────────────────────────────────────────────────
  // POST /sync – synchronisation avec whatsapp_valid_contacts
  // ────────────────────────────────────────────────

    fastify.post('/sync', auth, async (request, reply) => {
    const contacts = await query(
      `SELECT id, service_no, check_status, check_date
       FROM socadel_contacts`
    );

    let updated = 0;
    let abonne = 0;
    let nonAbonne = 0;

    for (const c of contacts.rows) {
      if (!c.service_no) continue;

      const valid = await query(
        `SELECT whatsapp_phone, client_name, activated_at
         FROM whatsapp_valid_contacts
         WHERE contract_number = $1
         LIMIT 1`,
        [c.service_no]
      );

      const isAbonne = valid.rows.length > 0;
      const statut = isAbonne ? 'ABONNE' : 'NON ABONNE';
      const api_status = isAbonne ? 'OK' : 'NOK';
      const whatsappPhone = isAbonne ? valid.rows[0].whatsapp_phone : null;
      const clientName = isAbonne ? valid.rows[0].client_name : null;
      const activatedAt = isAbonne ? valid.rows[0].activated_at : null;

      const responsable = computeResponsable(
        c.check_status,
        statut,
        activatedAt,
        c.check_date
      );

      await query(
        `UPDATE socadel_contacts
         SET numero_telephone = COALESCE($1, numero_telephone),
             noms             = COALESCE($2, noms),
             api_status       = $3,
             api_date         = NOW(),
             statut           = $4,
             activated_at     = $5,
             responsable      = $6,
             updated_at       = NOW()
         WHERE id = $7`,
        [
          whatsappPhone,
          clientName,
          api_status,
          statut,
          activatedAt,
          responsable,
          c.id
        ]
      );

      updated++;
      if (isAbonne) abonne++;
      else nonAbonne++;
    }

    return reply.send({
      success: true,
      updated,
      abonne,
      non_abonne: nonAbonne
    });
  });

  // ────────────────────────────────────────────────
  // GET /export-pdf – bordereau PDF
  // ────────────────────────────────────────────────
    fastify.get('/export-pdf', auth, async (request, reply) => {
    const { itineraires } = request.query;

    if (!itineraires) {
      return reply.code(400).send({ success: false, message: 'itineraires requis' });
    }

    const list = itineraires.split(',').map((i) => i.trim()).filter(Boolean);
    if (list.length === 0) {
      return reply.code(400).send({ success: false, message: 'Aucun itinéraire valide' });
    }

    try {
      const result = await query(
        `SELECT *
         FROM socadel_contacts
         WHERE itineraires = ANY($1::text[])
         ORDER BY itineraires, service_no`,
        [list]
      );

      if (result.rows.length === 0) {
        return reply.code(404).send({
          success: false,
          message: 'Aucune donnée pour les itinéraires sélectionnés'
        });
      }

      const pdfBuffer = await generateBordereauPDF(result.rows, list);

      return reply
        .header('Content-Type', 'application/pdf')
        .header(
          'Content-Disposition',
          `attachment; filename="bordereau_socadel_${Date.now()}.pdf"`
        )
        .send(pdfBuffer);
    } catch (err) {
      request.log?.error?.(err) || console.error('[socadel/export-pdf]', err);
      return reply.code(500).send({
        success: false,
        message: 'Erreur génération PDF',
        detail: process.env.NODE_ENV === 'development' ? err.message : undefined
      });
    }
  });

    // ────────────────────────────────────────────────
  // PUT /check-itinerary – cocher / décocher tout un itinéraire
  // ────────────────────────────────────────────────
    fastify.put('/check-itinerary', auth, async (request, reply) => {
    const { itineraires, check_status } = request.body || {};

    if (!itineraires) {
      return reply.code(400).send({
        success: false,
        message: 'itineraires requis (string ou tableau)'
      });
    }

    const list = Array.isArray(itineraires)
      ? itineraires.map((i) => String(i).trim()).filter(Boolean)
      : String(itineraires)
          .split(/[,;\s]+/)
          .map((i) => i.trim())
          .filter(Boolean);

    if (list.length === 0) {
      return reply.code(400).send({ success: false, message: 'Aucun itinéraire valide' });
    }

    const isOk = check_status === 'OK';

    const result = await query(
      `UPDATE socadel_contacts
       SET
         check_status = $1,
         check_date   = CASE WHEN $1 = 'OK' THEN NOW() ELSE NULL END,
         responsable  = CASE
           WHEN $1 = 'OK'
            AND statut = 'ABONNE'
            AND activated_at IS NOT NULL
            AND activated_at >= (CASE WHEN $1 = 'OK' THEN NOW() ELSE check_date END)
           THEN 'TERRAIN'
           ELSE 'AUTRES'
         END,
         updated_at   = NOW()
       WHERE itineraires = ANY($2::text[])
       RETURNING id`,
      [isOk ? 'OK' : null, list]
    );

    return reply.send({
      success: true,
      updated: result.rowCount,
      check_status: isOk ? 'OK' : null
    });
  });

    // ────────────────────────────────────────────────
  // GET /export-csv – export CSV des itinéraires
  // ────────────────────────────────────────────────
  fastify.get('/export-csv', auth, async (request, reply) => {
    const { itineraires, meter_no, service_no } = request.query;

    if (!itineraires) {
      return reply.code(400).send({
        success: false,
        message: 'itineraires requis'
      });
    }

    const list = String(itineraires)
      .split(',')
      .map((i) => i.trim())
      .filter(Boolean);

    if (list.length === 0) {
      return reply.code(400).send({
        success: false,
        message: 'Aucun itinéraire valide'
      });
    }

    const params = [list];
    let where = `WHERE itineraires = ANY($1::text[])`;

    if (meter_no) {
      params.push(`%${meter_no}%`);
      where += ` AND meter_no ILIKE $${params.length}`;
    }
    if (service_no) {
      params.push(`%${service_no}%`);
      where += ` AND service_no ILIKE $${params.length}`;
    }

    try {
      const result = await query(
        `SELECT
           region, division, agence, service_no, noms, categorie, mrc,
           ref_geo, itineraires, meter_no, numero_telephone,
           check_status, check_date, api_status, api_date,
           statut, responsable, activated_at
         FROM socadel_contacts
         ${where}
         ORDER BY itineraires, service_no`,
        params
      );

      if (result.rows.length === 0) {
        return reply.code(404).send({
          success: false,
          message: 'Aucune donnée pour les itinéraires sélectionnés'
        });
      }

      const headers = [
        'REGION',
        'DIVISION',
        'AGENCE',
        'SERVICE_NO',
        'NOMS',
        'CATEGORIE',
        'MRC',
        'REF_GEO',
        'ITINERAIRE',
        'METER_NO',
        'NUMERO_TELEPHONE',
        'CHECK',
        'CHECK_DATE',
        'API',
        'API_DATE',
        'STATUT',
        'RESPONSABLE',
        'DATE_ABONNEMENT'
      ];

      const escapeCsv = (val) => {
        if (val == null || val === '') return '';
        const s = String(val);
        // Format date ISO → lisible FR si timestamp
        if (/^\d{4}-\d{2}-\d{2}/.test(s) && !Number.isNaN(Date.parse(s))) {
          const d = new Date(s);
          const formatted = d.toLocaleString('fr-FR');
          return `"${formatted.replace(/"/g, '""')}"`;
        }
        if (/[",\n\r]/.test(s)) {
          return `"${s.replace(/"/g, '""')}"`;
        }
        return s;
      };

      const lines = [headers.join(';')];

      for (const row of result.rows) {
        lines.push(
          [
            row.region,
            row.division,
            row.agence,
            row.service_no,
            row.noms,
            row.categorie,
            row.mrc,
            row.ref_geo,
            row.itineraires,
            row.meter_no,
            row.numero_telephone,
            row.check_status,
            row.check_date,
            row.api_status,
            row.api_date,
            row.statut,
            row.responsable,
            row.activated_at
          ]
            .map(escapeCsv)
            .join(';')
        );
      }

      // BOM UTF-8 pour ouverture correcte dans Excel
      const csv = '\uFEFF' + lines.join('\r\n');
      const filename = `export_socadel_${list.join('_')}_${Date.now()}.csv`;

      return reply
        .header('Content-Type', 'text/csv; charset=utf-8')
        .header('Content-Disposition', `attachment; filename="${filename}"`)
        .send(csv);
    } catch (err) {
      request.log?.error?.(err) || console.error('[socadel/export-csv]', err);
      return reply.code(500).send({
        success: false,
        message: 'Erreur génération CSV'
      });
    }
  });


  // ────────────────────────────────────────────────
  // GET /stats – statistiques globales + ventilations
  // ────────────────────────────────────────────────
  fastify.get('/stats', auth, async (request, reply) => {
    const [global, byRegion, byDivision, byAgence, byMrc, byItinerary, byDay] =
      await Promise.all([
        // Global
        query(`
          SELECT
            COUNT(*)::int                                              AS total,
            COUNT(CASE WHEN numero_telephone IS NOT NULL
                         AND numero_telephone <> '' THEN 1 END)::int  AS with_phone,
            COUNT(CASE WHEN statut = 'ABONNE' THEN 1 END)::int         AS abonne,
            COUNT(CASE WHEN statut = 'NON ABONNE' THEN 1 END)::int     AS non_abonne,
            COUNT(CASE WHEN check_status = 'OK' THEN 1 END)::int       AS checked,
            COUNT(CASE WHEN api_status = 'OK' THEN 1 END)::int         AS api_ok,
            COUNT(CASE WHEN api_status = 'NOK' THEN 1 END)::int        AS api_nok,
            COUNT(CASE WHEN responsable = 'TERRAIN' THEN 1 END)::int   AS terrain,
            COUNT(CASE WHEN responsable = 'AUTRES' THEN 1 END)::int    AS autres
          FROM socadel_contacts
        `),

        // Par région
        query(`
          SELECT region,
                 COUNT(*)::int AS total,
                 COUNT(CASE WHEN statut = 'ABONNE' THEN 1 END)::int AS abonne,
                 COUNT(CASE WHEN check_status = 'OK' THEN 1 END)::int AS checked
          FROM socadel_contacts
          WHERE region IS NOT NULL
          GROUP BY region
          ORDER BY total DESC
        `),

        // Par division
        query(`
          SELECT division,
                 COUNT(*)::int AS total,
                 COUNT(CASE WHEN statut = 'ABONNE' THEN 1 END)::int AS abonne
          FROM socadel_contacts
          WHERE division IS NOT NULL
          GROUP BY division
          ORDER BY total DESC
        `),

        // Par agence
        query(`
          SELECT agence,
                 COUNT(*)::int AS total,
                 COUNT(CASE WHEN statut = 'ABONNE' THEN 1 END)::int AS abonne
          FROM socadel_contacts
          WHERE agence IS NOT NULL
          GROUP BY agence
          ORDER BY total DESC
          LIMIT 20
        `),

        // Par MRC
        query(`
          SELECT mrc,
                 COUNT(*)::int AS total,
                 COUNT(CASE WHEN statut = 'ABONNE' THEN 1 END)::int AS abonne
          FROM socadel_contacts
          WHERE mrc IS NOT NULL
          GROUP BY mrc
          ORDER BY total DESC
          LIMIT 20
        `),

        // Par itinéraire
        query(`
          SELECT itineraires,
                 COUNT(*)::int AS total,
                 COUNT(CASE WHEN statut = 'ABONNE' THEN 1 END)::int AS abonne,
                 COUNT(CASE WHEN check_status = 'OK' THEN 1 END)::int AS checked
          FROM socadel_contacts
          WHERE itineraires IS NOT NULL
          GROUP BY itineraires
          ORDER BY total DESC
        `),

        // Évolution journalière (30 derniers jours)
        query(`
          SELECT DATE(COALESCE(check_date, api_date, updated_at)) AS jour,
                 COUNT(*)::int AS total,
                 COUNT(CASE WHEN check_status = 'OK' THEN 1 END)::int AS checked,
                 COUNT(CASE WHEN statut = 'ABONNE' THEN 1 END)::int AS abonne
          FROM socadel_contacts
          WHERE COALESCE(check_date, api_date, updated_at) >= NOW() - INTERVAL '30 days'
          GROUP BY jour
          ORDER BY jour
        `)
      ]);

    const g = global.rows[0];

    return reply.send({
      success: true,
      stats: {
        ...g,
        taux_abonnement: g.total > 0 ? Math.round((g.abonne / g.total) * 1000) / 10 : 0,
        taux_check: g.total > 0 ? Math.round((g.checked / g.total) * 1000) / 10 : 0,
        taux_api_ok: g.total > 0 ? Math.round((g.api_ok / g.total) * 1000) / 10 : 0
      },
      byRegion: byRegion.rows,
      byDivision: byDivision.rows,
      byAgence: byAgence.rows,
      byMrc: byMrc.rows,
      byItinerary: byItinerary.rows,
      byDay: byDay.rows
    });
  });
}

module.exports = socadelRoutes;
