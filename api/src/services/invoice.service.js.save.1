      color: lightGreen
    });

    page.drawText(cleanTextForPDF('VALIDATION'), {
      x: signatureX + 8,
      y: signatureY - 13,
      size: 10,
      font: fontBold,
      color: brandGreen
    });

    signatureY -= 40;

    // === ZONE TAMON + QR (alignés côte à côte) ===

    const stampBoxSize = 100;     // un peu plus grand
    const qrSize       = 100;     // même taille que le tampon pour harmonie
    const spacing      = 20;      // espace entre tampon et QR

    // Centre du tampon
    const stampCenterX = signatureX + 60;

    // Centre du QR (juste à droite du tampon)
    const qrCenterX = stampCenterX + (stampBoxSize / 2) + (qrSize / 2) + spacing;

    // === Tampon ===
    const tamponPath = '/var/www/numericexport/assets/tampon.png';
    try {
      const tamponExists = await fileExists(tamponPath);
      if (tamponExists) {
        const tamponBytes = await fs.readFile(tamponPath);
        const tamponImage = await pdfDoc.embedPng(tamponBytes);
        page.drawImage(tamponImage, {
          x: stampCenterX - stampBoxSize / 2,
          y: signatureY - stampBoxSize,
          width: stampBoxSize,
          height: stampBoxSize
        });
      } else {
        // Placeholder cercle
        page.drawCircle({
          x: stampCenterX,
          y: signatureY - stampBoxSize / 2,
          size: stampBoxSize / 2,
          borderWidth: 2,
          borderColor: brandGreen,
          borderDashArray: [4, 4]
        });
        page.drawText(cleanTextForPDF('CACHET'), {
          x: stampCenterX - 22,
          y: signatureY - stampBoxSize / 2 - 5,
          size: 9,
          font: fontBold,
          color: grayMedium
        });
      }
    } catch (error) {
      logger.error('Erreur chargement tampon:', error);
    }

    // === QR Code ===
    let qrDrawn = false;
    if (verificationToken) {
      const baseApiUrl = process.env.API_BASE_URL || 'https://api.numericexport.com';
      const qrUrl = `${baseApiUrl}/api/v1/orders/invoices/${invoice.id}/verify?token=${verificationToken}`;

      logger.info(`[QR] Tentative de génération pour URL : ${qrUrl}`);

      const qrImageBuffer = await generateQRCodeImage(qrUrl);
      if (qrImageBuffer) {
        try {
          const qrImage = await pdfDoc.embedPng(qrImageBuffer);
          page.drawImage(qrImage, {
            x: qrCenterX - qrSize / 2,
            y: signatureY - qrSize,
            width: qrSize,
            height: qrSize
          });
          qrDrawn = true;

          // Petit label sous le QR
          page.drawText(cleanTextForPDF('Vérification'), {
            x: qrCenterX - 35,
            y: signatureY - qrSize - 18,
            size: 8,
            font: fontRegular,
            color: grayMedium
          });

          logger.info('[QR] QR code ajouté avec succès');
        } catch (embedError) {
          logger.error('[QR] Erreur embed PNG du QR:', embedError);
        }
      } else {
        logger.warn('[QR] generateQRCodeImage a retourné null');
      }
    } else {
      logger.warn('[QR] Aucun verificationToken fourni → QR non généré');
    }

    // Placeholder si QR non dessiné (pour debug visuel)
    if (!qrDrawn) {
      page.drawRectangle({
        x: qrCenterX - qrSize / 2,
        y: signatureY - qrSize,
        width: qrSize,
        height: qrSize,
        borderWidth: 1,
        borderColor: rgb(1, 0, 0),
        color: rgb(0.98, 0.9, 0.9)
      });
      page.drawText(cleanTextForPDF('QR NON GÉNÉRÉ'), {
        x: qrCenterX - 45,
        y: signatureY - qrSize / 2 - 5,
        size: 9,
        font: fontBold,
        color: rgb(0.8, 0, 0)
      });
    }

    // Ligne signature (sous le tampon uniquement)
    signatureY -= stampBoxSize + 15;

    page.drawText(cleanTextForPDF('Le Directeur'), {
      x: stampCenterX - 28,
      y: signatureY,
      size: 9,
      font: fontBold,
      color: grayDark
    });

    page.drawLine({
      start: { x: stampCenterX - 40, y: signatureY - 5 },
      end: { x: stampCenterX + 40, y: signatureY - 5 },
      thickness: 1,
      color: grayMedium
    });
    signatureY -= 25;

    // QR Code
    if (verificationToken) {
      const baseApiUrl = process.env.API_BASE_URL || 'https://api.numericexport.com';
      const qrUrl = `${baseApiUrl}/api/v1/orders/invoices/${invoice.id}/verify?token=${verificationToken}`;
      const qrImageBuffer = await generateQRCodeImage(qrUrl);
      if (qrImageBuffer) {
        const qrImage = await pdfDoc.embedPng(qrImageBuffer);
        const qrSize = 80;
        page.drawImage(qrImage, {
          x: stampCenterX - qrSize / 2,
          y: signatureY - qrSize,
          width: qrSize,
          height: qrSize
        });
        page.drawText(cleanTextForPDF('Vérification'), {
          x: stampCenterX - 28,
          y: signatureY - qrSize - 12,
          size: 7,
          font: fontRegular,
          color: grayMedium
        });
      }
    }

    // === PIED DE PAGE ===
    const footerY = 70;

    page.drawLine({
      start: { x: marginLeft, y: footerY + 15 },
      end: { x: width - marginRight, y: footerY + 15 },
      thickness: 2,
      color: brandGreen
    });

    const legalTexts = [
      'Cette facture proforma est valable 30 jours à compter de sa date d\'émission.',
      'Document non contractuel - Sous réserve de validation.',
      'Pour toute question: team@numericexport.com'
    ];

    let legalY = footerY;
    legalTexts.forEach((text, index) => {
      page.drawText(cleanTextForPDF(text), {
        x: marginLeft,
        y: legalY - (index * 11),
        size: 7,
        font: fontRegular,
        color: grayMedium
      });
    });

    page.drawText(cleanTextForPDF(`© ${new Date().getFullYear()} NEXT LTD - Tous droits réservés`), {
      x: marginLeft,
      y: 25,
      size: 7,
      font: fontRegular,
      color: grayMedium
    });

    drawRightText(
      page,
      `Générée le ${formatDateForPDF(new Date())}`,
      25,
      7,
      fontRegular,
      grayMedium,
      width - marginRight
    );

    page.drawRectangle({
      x: 0,
      y: 0,
      width: width,
      height: 8,
      color: brandGreen
    });

    // Sauvegarde
    const pdfBytes = await pdfDoc.save();
    await fs.writeFile(pdfPath, pdfBytes);

    logger.info(`✅ Facture proforma professionnelle générée: ${pdfPath}`);
    return pdfPath;

  } catch (error) {
    logger.error('❌ Erreur dans generateProformaPDF:', error);
    throw error;
  }
}

