'use client';

import { useState } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';

type Mode = 'choice' | 'partenaire' | 'socadel';

export default function SocadelLoginPage() {
  const router = useRouter();
  const [mode, setMode] = useState<Mode>('choice');

  // Partenaire
  const [username, setUsername] = useState('');
  const [partnerPass, setPartnerPass] = useState('');

  // Agent
  const [email, setEmail] = useState('');
  const [agentPass, setAgentPass] = useState('');

  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  const loginPartenaire = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    try {
      const res = await fetch('/api/v1/auth/socadel-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password: partnerPass })
      });
      const data = await res.json();
      if (data.success && data.token) {
        localStorage.setItem('socadel_token', data.token);
        localStorage.setItem('socadel_role', 'releveur');
        router.push('/socadel/dashboard');
      } else {
        setError(data.message || 'Identifiants incorrects');
      }
    } catch {
      setError('Erreur réseau');
    } finally {
      setLoading(false);
    }
  };

  const loginAgent = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    try {
      const res = await fetch('/api/v1/auth/socadel-agent/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password: agentPass })
      });
      const data = await res.json();
      if (data.success && data.token) {
        localStorage.setItem('socadel_token', data.token);
        localStorage.setItem('socadel_role', 'agent_socadel');
        if (data.agent) {
          localStorage.setItem('socadel_agent', JSON.stringify(data.agent));
        }
        router.push('/socadel/dashboard');
      } else if (data.code === 'NOT_ACTIVATED') {
        setError('Compte non activé. Activez-le avec le code reçu par email.');
      } else {
        setError(data.message || 'Identifiants incorrects');
      }
    } catch {
      setError('Erreur réseau');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-50 via-blue-50 to-white px-4">
      <div className="bg-white p-8 sm:p-10 rounded-2xl shadow-xl w-full max-w-md border border-blue-100">
        <div className="text-center mb-8">
          <img src="/socad.png" alt="Socadel" className="h-14 mx-auto mb-3" />
          <h1 className="text-2xl font-bold text-blue-900 tracking-tight">
            Collecte WhatsApp
          </h1>
          <p className="text-sm text-blue-600/80 mt-1">Socadel — Accès sécurisé</p>
        </div>

        {mode === 'choice' && (
          <div className="space-y-3">
            <button
              type="button"
              onClick={() => { setMode('partenaire'); setError(''); }}
              className="w-full bg-blue-700 hover:bg-blue-800 text-white font-semibold py-3.5 rounded-xl transition shadow-sm"
            >
              Partenaire (Releveur)
            </button>
            <button
              type="button"
              onClick={() => { setMode('socadel'); setError(''); }}
              className="w-full bg-white hover:bg-blue-50 text-blue-800 font-semibold py-3.5 rounded-xl transition border-2 border-blue-200"
            >
              Agent Socadel
            </button>
          </div>
        )}

        {mode === 'partenaire' && (
          <form onSubmit={loginPartenaire} className="space-y-4">
            <button
              type="button"
              onClick={() => setMode('choice')}
              className="text-xs text-blue-600 hover:underline mb-2"
            >
              ← Retour
            </button>
            <input
              type="text"
              placeholder="Nom d'utilisateur"
              value={username}
              onChange={(e) => setUsername(e.target.value)}
              required
              className="w-full border border-blue-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
            <input
              type="password"
              placeholder="Mot de passe"
              value={partnerPass}
              onChange={(e) => setPartnerPass(e.target.value)}
              required
              className="w-full border border-blue-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
            {error && (
              <p className="text-red-600 text-sm bg-red-50 border border-red-100 rounded-lg px-3 py-2">
                {error}
              </p>
            )}
            <button
              type="submit"
              disabled={loading}
              className="w-full bg-blue-700 hover:bg-blue-800 disabled:bg-blue-400 text-white font-semibold py-3 rounded-xl"
            >
              {loading ? 'Connexion…' : 'Se connecter'}
            </button>
          </form>
        )}

        {mode === 'socadel' && (
          <form onSubmit={loginAgent} className="space-y-4">
            <button
              type="button"
              onClick={() => setMode('choice')}
              className="text-xs text-blue-600 hover:underline mb-2"
            >
              ← Retour
            </button>
            <input
              type="email"
              placeholder="Email @camlight.cm ou @eneo.cm"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              required
              className="w-full border border-blue-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
            <input
              type="password"
              placeholder="Mot de passe"
              value={agentPass}
              onChange={(e) => setAgentPass(e.target.value)}
              required
              className="w-full border border-blue-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
            {error && (
              <p className="text-red-600 text-sm bg-red-50 border border-red-100 rounded-lg px-3 py-2">
                {error}
              </p>
            )}
            <button
              type="submit"
              disabled={loading}
              className="w-full bg-blue-700 hover:bg-blue-800 disabled:bg-blue-400 text-white font-semibold py-3 rounded-xl"
            >
              {loading ? 'Connexion…' : 'Se connecter'}
            </button>
            <div className="text-center text-sm space-y-1 pt-2">
              <Link href="/socadel/register" className="block text-blue-700 hover:underline">
                Créer un compte agent
              </Link>
              <Link href="/socadel/activate" className="block text-slate-500 hover:underline text-xs">
                Activer mon compte (code email)
              </Link>
            </div>
          </form>
        )}

        <p className="text-xs text-slate-400 text-center mt-8">
          © Socadel — Campagne collecte WhatsApp
        </p>
      </div>
    </div>
  );
}
