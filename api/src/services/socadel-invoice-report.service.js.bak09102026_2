    { label: 'Taux de recouvrement', value: fmtPct(g.tx_recouv), sub: 'Payé / distribué', rate: g.tx_recouv, color: rateColor(g.tx_recouv, TARGET_RECOUV) },
    { label: 'Taux de paiement', value: fmtPct(g.tx_paiement), sub: 'Payées / distribuées', rate: g.tx_paiement, color: C.green },
    { label: 'Délai moyen de paiement', value: fmtDays(g.delai_paiement), sub: `Médiane ${fmtDays(g.pay_med)} · P90 ${fmtDays(g.pay_p90)}`, color: C.mid },
