  /* ── 5. Évolution journalière ── */
  function barChart(days, key, color, title) {
    const H = 80;
    const vals = days.map((d) => Number(d[key] || 0));
    const max = Math.max(1, ...vals);
    const cols = days
      .map((d, i) => {
        const v = vals[i];
        const h = v > 0 ? Math.max(2, Math.round((v / max) * H)) : 1;
        const col = v > 0 ? color : C.track;
        return `<td valign="bottom" align="center" style="padding:0 1px;font-family:${FONT};">
          <div style="font-size:8px;color:${C.muted};height:11px;">${v > 0 ? fmtK(v) : ''}</div>
          <table cellpadding="0" cellspacing="0" align="center"><tr><td width="14" height="${h}" bgcolor="${col}" style="font-size:0;line-height:0;">&nbsp;</td></tr></table></td>`;
      })
      .join('');
    const labels = days
      .map((d) => `<td align="center" style="padding-top:4px;font-family:${FONT};font-size:8px;color:${C.muted};">${pad(toDay(d.jour).getDate())}</td>`)
      .join('');
    return `<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:${C.softer};border:1px solid ${C.border};margin-bottom:10px;">
      <tr><td style="padding:10px 14px 0 14px;font-family:${FONT};font-size:11.5px;font-weight:700;color:${C.dark};">${esc(title)}</td></tr>
      <tr><td style="padding:6px 14px 10px 14px;"><table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>${cols}</tr><tr>${labels}</tr></table></td></tr></table>`;
  }

  function dailyBlock() {
    const days = data.daily || [];
    if (!days.length) return '';
    const peakD = days.reduce((b, d) => (d.distribuees > (b.distribuees || 0) ? d : b), {});
    const peakP = days.reduce((b, d) => (d.payees > (b.payees || 0) ? d : b), {});
    const stat = (l, v, s) => `<td width="25%" style="padding:0 6px 0 0;"><table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid ${C.border};"><tr><td style="padding:8px 10px;font-family:${FONT};">
      <div style="font-size:10.5px;color:${C.muted};">${l}</div>
      <div style="font-size:15px;font-weight:700;color:${C.dark};margin-top:2px;">${v}</div>
      <div style="font-size:10px;color:${C.muted};">${s || '&nbsp;'}</div></td></tr></table></td>`;
    const chart = `<tr><td style="padding:0 28px;">
      ${barChart(days, 'distribuees', C.green, 'Factures distribuées par jour')}
      ${barChart(days, 'payees', C.dark, 'Paiements par jour (nombre de factures)')}
      <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
        ${stat('Pic de distribution', peakD.jour ? fmt(peakD.distribuees) : '—', peakD.jour ? `le ${dm(peakD.jour)}` : '')}
        ${stat('Pic de paiement', peakP.jour ? fmt(peakP.payees) : '—', peakP.jour ? `le ${dm(peakP.jour)} · ${money(peakP.montant_paye)}` : '')}
        ${stat('Total distribué (période)', fmt(days.reduce((a, d) => a + d.distribuees, 0)), `${fmt(days.filter((d) => d.distribuees > 0).length)} jour(s) d'envoi`)}
        ${stat('Total payé (période)', fmt(days.reduce((a, d) => a + d.payees, 0)), money(days.reduce((a, d) => a + d.montant_paye, 0)))}
      </tr></table></td></tr>`;
    if (!full) return chart;
    const body = days
      .map((d, i) => `<tr>${td(dm(d.jour), { bg: zebra(i), bold: true })}${td(fmt(d.envoyees), { align: 'right', bg: zebra(i) })}${td(fmt(d.distribuees), { align: 'right', bg: zebra(i) })}${td(fmt(d.echecs), { align: 'right', bg: zebra(i) })}${td(money(d.montant_distribue), { align: 'right', bg: zebra(i) })}${td(fmt(d.payees), { align: 'right', bg: zebra(i) })}${td(money(d.montant_paye), { align: 'right', bg: zebra(i), bold: true, color: C.dark })}</tr>`)
      .join('');
    return chart + `<tr><td style="padding:10px 28px 0 28px;"></td></tr>` +
      tbl([['Jour', 'left'], ['Envoyées', 'right'], ['Distribuées', 'right'], ['Échecs', 'right'], ['Montant distribué', 'right'], ['Payées', 'right'], ['Montant payé', 'right']], body);
  }

  /* ── 5 bis. Distributions réussies par jour et par région ── */
  function dailyRegionBlock() {
    const rows = data.dailyRegion || [];
    if (!rows.length) return '';
    const MOIS = ['janv', 'févr', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'];
    const regions = [...new Set(rows.map((r) => r.region))].sort((a, b) => a.localeCompare(b, 'fr'));
    const dayMap = new Map();
    for (const r of rows) {
      const k = ymd(r.jour);
      if (!dayMap.has(k)) dayMap.set(k, { jour: r.jour, v: {} });
      dayMap.get(k).v[r.region] = r.nb;
    }
    const days = [...dayMap.values()].sort((a, b) => ymd(a.jour).localeCompare(ymd(b.jour)));
    const colTot = Object.fromEntries(regions.map((rg) => [rg, 0]));
    let max = 1;
    for (const d of days) {
      d.total = 0;
      for (const rg of regions) {
        const v = d.v[rg] || 0;
        d.total += v;
        colTot[rg] += v;
        if (v > max) max = v;
      }
    }
    const grand = days.reduce((a, d) => a + d.total, 0);
    const heat = (v) => {
      if (!v) return '#ffffff';
      const t = Math.ceil(Math.min(1, v / max) * 8) / 8;
      const mix = (a, b) => Math.round(a + (b - a) * (0.12 + 0.6 * t));
      const h = (x) => x.toString(16).padStart(2, '0');
      return `#${h(mix(255, 37))}${h(mix(255, 211))}${h(mix(255, 102))}`;
    };
    // Cellules en attributs HTML (bgcolor/align) : balisage minimal pour rester léger dans l'email
    const body = days
      .map((d) => {
        const dd = toDay(d.jour);
        const lab = `${pad(dd.getDate())}-${MOIS[dd.getMonth()]}`;
        return `<tr><td bgcolor="${C.softer}"><b>${lab}</b></td>${regions
          .map((rg) => `<td align="right" bgcolor="${heat(d.v[rg] || 0)}">${d.v[rg] ? fmt(d.v[rg]) : '–'}</td>`)
          .join('')}<td align="right" bgcolor="${C.soft}"><b>${fmt(d.total)}</b></td></tr>`;
      })
      .join('');
    const foot = `<tr style="font-weight:700;color:${C.dark};"><td bgcolor="${C.soft}">TOTAL</td>${regions
      .map((rg) => `<td align="right" bgcolor="${C.soft}">${fmt(colTot[rg])}</td>`)
      .join('')}<td align="right" bgcolor="${C.soft}">${fmt(grand)}</td></tr>`;
    const head = `<tr style="background:${C.dark};color:#ffffff;font-weight:600;font-size:10px;"><td bgcolor="${C.dark}"><font color="#ffffff">Date</font></td>${regions
      .map((rg) => `<td align="right" bgcolor="${C.dark}"><font color="#ffffff">${esc(rg)}</font></td>`)
      .join('')}<td align="right" bgcolor="${C.dark}"><font color="#ffffff">TOTAL</font></td></tr>`;
    return `<tr><td style="padding:0 28px;"><table width="100%" cellpadding="6" cellspacing="0" border="0" style="${tblStyle}font-size:11px;">${head}${body}${foot}</table></td></tr>`;
  }

  /* ── 6. Paiement ── */
  function paymentBlock() {
    const bk = Object.fromEntries((data.payBuckets || []).map((r) => [r.ord, r]));
    const tot = (data.payBuckets || []).reduce((a, r) => a + r.nb, 0) || 1;
    const body = PAY_LABELS.map((l, i) => {
      const r = bk[i] || { nb: 0, montant: 0 };
      const bg = zebra(i);
      return `<tr>${td(l, { bg, bold: true })}<td style="${cell({ bg })}" width="34%">${progressBar(pct(r.nb, tot), i === 0 ? C.grey : C.green, 8)}</td>
        ${td(fmt(r.nb), { align: 'right', bg, bold: true, color: C.dark })}${td(fmtPct(pct(r.nb, tot)), { align: 'right', bg })}${td(money(r.montant), { align: 'right', bg })}</tr>`;
    }).join('');
    const kp = (l, v) => `<td width="25%" style="padding:0 6px 10px 0;"><table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid ${C.border};"><tr><td style="padding:8px 10px;font-family:${FONT};">
      <div style="font-size:10.5px;color:${C.muted};">${l}</div><div style="font-size:15px;font-weight:700;color:${C.dark};margin-top:2px;">${v}</div></td></tr></table></td>`;
    const strip = `<tr><td style="padding:0 28px;"><table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      ${kp('Délai moyen de paiement', fmtDays(g.delai_paiement))}
      ${kp('Délai médian · P90', `${fmtDays(g.pay_med)} · ${fmtDays(g.pay_p90)}`)}
      ${kp('Payées avant échéance', fmtPct(pct(g.payees_avant_echeance, g.payees)))}
      ${kp('Payées avant la distribution', fmt(g.payees_avant_dist))}
    </tr></table></td></tr>`;

    const ch = Object.fromEntries((data.channel || []).map((r) => [r.seg, r]));
    const chBody = ['lue', 'delivree', 'non_distribuee']
      .filter((k) => ch[k])
      .map((k, i) => {
        const r = ch[k];
        const bg = zebra(i);
        return `<tr>${td(SEG_LABELS[k], { bg, bold: true })}${td(fmt(r.total), { align: 'right', bg })}${td(fmt(r.payees), { align: 'right', bg })}
          ${rateCell(pct(r.payees, r.total), TARGET_RECOUV, bg)}
          ${td(money(r.montant), { align: 'right', bg })}${td(money(r.montant_paye), { align: 'right', bg, bold: true, color: C.dark })}
          ${td(fmtPct(Math.min(100, pct(r.montant_paye, r.montant))), { align: 'right', bg })}</tr>`;
      })
      .join('');
    const impact = chBody
      ? `<tr><td style="padding:14px 28px 0 28px;"></td></tr>` +
        tbl([['Comparaison selon la situation de la facture', 'left'], ['Factures', 'right'], ['Payées', 'right'], ['Taux de paiement', 'right'], ['Montant', 'right'], ['Montant payé', 'right'], ['Recouvrement', 'right']], chBody)
      : '';
    return strip + tbl([['Délai de paiement après distribution', 'left'], ['', 'left'], ['Factures', 'right'], ['% des payées', 'right'], ['Montant payé', 'right']], body) + impact;
  }

  /* ── 7. Échéancier & relance ── */
  function echeanceBlock() {
    const rows = Object.fromEntries((data.echeancier || []).map((r) => [r.ord, r]));
    const totM = (data.echeancier || []).reduce((a, r) => a + r.montant, 0) || 1;
    const totN = (data.echeancier || []).reduce((a, r) => a + r.nb, 0);
    const body = ECH_LABELS.map((l, i) => {
      const r = rows[i];
      if (!r) return '';
      const bg = i <= 3 ? C.redSoft : i <= 7 ? C.amberSoft : zebra(i);
      return `<tr>${td(l, { bg, bold: i <= 7 })}${td(fmt(r.nb), { align: 'right', bg, bold: true, color: C.dark })}${td(money(r.montant), { align: 'right', bg })}${td(fmtPct(pct(r.montant, totM)), { align: 'right', bg })}</tr>`;
    }).join('');
    const foot = `<tr>${td('TOTAL distribuées non payées', { bold: true, bg: C.soft, color: C.dark })}${td(fmt(totN), { align: 'right', bold: true, bg: C.soft, color: C.dark })}${td(money(totN ? totM : 0), { align: 'right', bold: true, bg: C.soft, color: C.dark })}${td('', { bg: C.soft })}</tr>`;
    let html = tbl([['Échéance des factures distribuées et non payées', 'left'], ['Factures', 'right'], ['Montant à risque', 'right'], ['% du montant', 'right']], body, foot);
    html += `<tr><td style="padding:8px 28px 0 28px;font-family:${FONT};font-size:11px;color:${C.muted};">
      Distribuées non payées : <b>${fmt(totN)}</b> · Non distribuées et non payées : <b>${fmt(g.nd_np)}</b> (${money(g.nd_np_montant)}) — à traiter par un autre canal.</td></tr>`;
    const list = (title, rows2, limit) => {
      const shown = (rows2 || []).slice(0, limit);
      if (!shown.length) return '';
      const b = shown
        .map((r, i) => {
          const bg = zebra(i);
          const j = r.jours;
          const txt = j == null ? '—' : j < 0 ? `échue il y a ${-j} j` : j === 0 ? "aujourd'hui" : `dans ${j} j`;
          return `<tr>${td(esc(r.nom_client || '—'), { bg, bold: true })}${td(esc(r.numero_contrat), { bg })}${td(esc(r.agence), { bg })}${td(esc(r.categorie), { bg })}${td(money(r.montant), { align: 'right', bg, bold: true, color: C.dark })}${td(`${dm(r.due_date)} · ${txt}`, { bg })}${td(esc((STATUS[r.st] || { l: r.st }).l), { bg })}</tr>`;
        })
        .join('');
      return `<tr><td style="padding:14px 28px 0 28px;"></td></tr>` +
        tbl([[title, 'left'], ['Contrat', 'left'], ['Agence', 'left'], ['Catégorie', 'left'], ['Montant', 'right'], ['Échéance', 'left'], ['Statut WhatsApp', 'left']], b);
    };
    html += list('Relance prioritaire : échéance sous 3 jours (top 15)', data.relanceSoon, 15);
    html += list('Plus gros montants échus non payés (top 10)', data.relanceLate, 10);
    return html;
  }

  /* ── 8. Pareto ── */
  function paretoBlock() {
    const P = data.pareto;
    if (!P || !P.top) return '';
    const shareTop = pct(P.top.montant, g.montant);
    const k80pct = P.n ? pct(P.k80, P.n) : 0;
    const row = (label, r, bg) => `<tr>${td(label, { bg, bold: true })}${td(fmt(r.total), { align: 'right', bg })}${td(money(r.montant), { align: 'right', bg })}${td(fmtPct(pct(r.montant, g.montant)), { align: 'right', bg })}
      ${rateCell(r.tx_succes, TARGET_SUCCESS, bg)}${rateCell(r.tx_lecture, 70, bg)}${rateCell(r.tx_recouv, TARGET_RECOUV, bg)}</tr>`;
    const body = row('Top 20 % des factures (gros montants)', P.top, '#ffffff') + (P.rest ? row('80 % restants', P.rest, C.softer) : '');
    const note = `<tr><td style="padding:0 28px 10px 28px;font-family:${FONT};font-size:12px;color:${C.text};">
      Les <b>20 % de factures les plus élevées</b> représentent <b>${fmtPct(shareTop)}</b> du montant à distribuer.
      ${P.n ? `À l'inverse, <b>${fmtPct(k80pct)}</b> des factures suffisent à atteindre 80 % du montant.` : ''}</td></tr>`;
    let html = note + tbl([['Segment', 'left'], ['Factures', 'right'], ['Montant', 'right'], ['% du montant', 'right'], ['Taux de succès', 'right'], ['Taux de lecture', 'right'], ['Recouvrement', 'right']], body);
    if (data.bigUnpaid?.length) {
      const b = data.bigUnpaid
        .map((r, i) => `<tr>${td(esc(r.nom_client || '—'), { bg: zebra(i), bold: true })}${td(esc(r.agence), { bg: zebra(i) })}${td(esc(r.categorie), { bg: zebra(i) })}${td(money(r.montant), { align: 'right', bg: zebra(i), bold: true, color: C.dark })}${td(dm(r.due_date), { bg: zebra(i) })}${td(esc((STATUS[r.st] || { l: r.st }).l), { bg: zebra(i) })}</tr>`)
        .join('');
      html += `<tr><td style="padding:14px 28px 0 28px;"></td></tr>` +
        tbl([['Top 10 gros montants non payés', 'left'], ['Agence', 'left'], ['Catégorie', 'left'], ['Montant', 'right'], ['Échéance', 'left'], ['Statut WhatsApp', 'left']], b);
    }
    return html;
  }

  /* ── 9. Tableaux par dimension ── */
  function dimTable(title, rows, { limit = null, showParent = false, labelHead = 'Libellé' } = {}) {
    if (!rows?.length) return '';
    const shown = limit ? rows.slice(0, limit) : rows;
    const s = sumRows(rows);
    const body = shown
      .map((r, i) => {
        const bg = zebra(i);
        return `<tr><td style="${cell({ bg, bold: true })}">${esc(r.label)}${showParent && r.parent ? `<div style="font-size:9.5px;font-weight:400;color:${C.muted};">${esc(r.parent)}</div>` : ''}</td>
          ${td(fmt(r.total), { align: 'right', bg })}${td(money(r.montant), { align: 'right', bg })}${td(fmtPct(r.tx_valide), { align: 'right', bg })}${td(fmt(r.distribuees), { align: 'right', bg })}
          ${rateCell(r.tx_succes, TARGET_SUCCESS, bg)}${td(fmtPct(r.tx_lecture), { align: 'right', bg })}${td(fmtPct(r.tx_echec), { align: 'right', bg, color: r.tx_echec > 5 ? C.red : C.text })}
          ${td(money(r.montant_paye), { align: 'right', bg })}${rateCell(r.tx_recouv, TARGET_RECOUV, bg)}${td(fmtDays(r.delai_paiement), { align: 'right', bg })}</tr>`;
      })
      .join('');
    const f = (v, a = 'right') => td(v, { align: a, bold: true, bg: C.soft, color: C.dark });
    const foot = `<tr>${f('TOTAL', 'left')}${f(fmt(s.total))}${f(money(s.montant))}${f(fmtPct(s.tx_valide))}${f(fmt(s.distribuees))}${f(fmtPct(s.tx_succes))}${f(fmtPct(s.tx_lecture))}${f(fmtPct(s.tx_echec))}${f(money(s.montant_paye))}${f(fmtPct(s.tx_recouv))}${f(fmtDays(s.delai_paiement))}</tr>`;
    const heads = [[labelHead, 'left'], ['Factures', 'right'], ['Montant', 'right'], ['Contacts valides', 'right'], ['Distribuées', 'right'], ['Taux de succès', 'right'], ['Lecture', 'right'], ['Échec', 'right'], ['Montant payé', 'right'], ['Recouvrement', 'right'], ['Délai pay.', 'right']];
    const sub = `${rows.length} élément(s)${limit && rows.length > limit ? ` · ${limit} plus gros affichés, détail complet en pièce jointe` : ''}`;
    return sectionTitle(title, sub) + tbl(heads, body, foot);
  }

  /* ── 10. Classement ── */
