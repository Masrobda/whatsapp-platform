// src/controllers/campaign.controller.js
const campaignService = require('../services/campaign.service');
const logger = require('../utils/logger');
const multipart = require('@fastify/multipart');

/**
 * GET /api/v1/campaigns/stats
 */
async function getGlobalStatsHandler(request, reply) {
  try {
    // Correction: Ne pas utiliser clientId = null pour admin
    let clientId = request.user.id;
    
    // Si admin et clientId spécifié dans query
    if (request.user.role === 'admin' && request.query.clientId) {
      clientId = request.query.clientId;
    }
    
    const result = await campaignService.getGlobalCampaignStats(clientId);
    return reply.code(200).send(result);
  } catch (error) {
    logger.error('Erreur stats globales campagnes:', error);
    return reply.code(500).send({ success: false, code: 'INTERNAL_ERROR', message: error.message });
  }
}

/**
 * GET /api/v1/campaigns
 */
async function listCampaignsHandler(request, reply) {
  try {
    const clientId = request.user.role === 'admin' ? request.query.clientId : request.user.id;
    const filters = {
      page: request.query.page || 1,
      limit: request.query.limit || 20,
      status: request.query.status,
      search: request.query.search,
      category: request.query.category,
      campaign_type: request.query.campaign_type,
    };
    const result = await campaignService.getCampaigns(clientId, filters);
    return reply.code(200).send(result);
  } catch (error) {
    logger.error('Erreur liste campagnes:', error);
    return reply.code(error.statusCode || 500).send({ success: false, code: error.code || 'INTERNAL_ERROR', message: error.message });
  }
}

/**
 * POST /api/v1/campaigns
 */
async function createCampaignHandler(request, reply) {
  try {
    const clientId = request.user.id;
    const userId = request.user.id;
    const result = await campaignService.createCampaign(clientId, userId, request.body);
    return reply.code(201).send(result);
  } catch (error) {
    logger.error('Erreur création campagne:', error);
    return reply.code(error.statusCode || 500).send({ success: false, code: error.code || 'INTERNAL_ERROR', message: error.message });
  }
}

/**
 * GET /api/v1/campaigns/:id
 */
async function getCampaignHandler(request, reply) {
  try {
    const { id } = request.params;
    const clientId = request.user.role === 'admin' ? null : request.user.id;
    const campaign = await campaignService.getCampaignById(id, clientId);
    return reply.code(200).send({ success: true, campaign });
  } catch (error) {
    return reply.code(error.statusCode || 500).send({ success: false, code: error.code || 'INTERNAL_ERROR', message: error.message });
  }
}

/**
 * PUT /api/v1/campaigns/:id
 */
async function updateCampaignHandler(request, reply) {
  try {
    const { id } = request.params;
    const clientId = request.user.id;
    const result = await campaignService.updateCampaign(id, clientId, request.user.id, request.body);
    return reply.code(200).send(result);
  } catch (error) {
    return reply.code(error.statusCode || 500).send({ success: false, code: error.code || 'INTERNAL_ERROR', message: error.message });
  }
}

