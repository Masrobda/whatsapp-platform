// lib/campaigns/api.js
// Hook et utilitaires partagés pour le module campagnes

const API_BASE = process.env.NEXT_PUBLIC_API_URL || 'https://api.numericexport.com/api/v1';

// ============================================================
// CLIENT HTTP CENTRAL
// ============================================================
export async function campaignFetch(path, options = {}) {
  const token = typeof window !== 'undefined' ? localStorage.getItem('token') : null;
  
  let body = options.body;
  if (options.method === 'POST' && !options.body && !(options.body instanceof FormData)) {
    body = JSON.stringify({});
  }
  
  const headers = {
    ...(token ? { Authorization: `Bearer ${token}` } : {}),
    ...options.headers,
  };
  
  if (!(body instanceof FormData)) {
    headers['Content-Type'] = 'application/json';
  }
  
  const res = await fetch(`${API_BASE}${path}`, {
    ...options,
    body,
    headers,
  });
  
  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    const error = new Error(err.message || `HTTP ${res.status}`);
    error.statusCode = res.status;
    error.code = err.code;
    throw error;
  }
  return res.json();
}

// ============================================================
// API CAMPAGNES
// ============================================================
export const CampaignAPI = {
  list: (filters = {}) => {
    const params = new URLSearchParams();
    Object.entries(filters).forEach(([k, v]) => {
      if (v !== undefined && v !== '' && v !== null) params.append(k, v);
    });
    const qs = params.toString();
    return campaignFetch(`/campaigns${qs ? `?${qs}` : ''}`);
  },

  get: (id) => campaignFetch(`/campaigns/${id}`),

  create: (data) => campaignFetch('/campaigns', { method: 'POST', body: JSON.stringify(data) }),

  update: (id, data) => campaignFetch(`/campaigns/${id}`, { method: 'PUT', body: JSON.stringify(data) }),

  launch: (id) => campaignFetch(`/campaigns/${id}/launch`, { method: 'POST', body: JSON.stringify({}) }),
  
  pause: (id) => campaignFetch(`/campaigns/${id}/pause`, { method: 'POST', body: JSON.stringify({}) }),
  
  cancel: (id) => campaignFetch(`/campaigns/${id}/cancel`, { method: 'POST', body: JSON.stringify({}) }),

  // CORRECTION : Route unique /campaigns/stats (pas /campaigns/stats/stats)
  globalStats: () => campaignFetch('/campaigns/stats'),
  
  stats: (id) => campaignFetch(`/campaigns/${id}/stats`),

  contacts: (id, filters = {}) => {
    const params = new URLSearchParams();
    Object.entries(filters).forEach(([k, v]) => {
      if (v !== undefined && v !== '') params.append(k, v);
    });
    const qs = params.toString();
    return campaignFetch(`/campaigns/${id}/contacts${qs ? `?${qs}` : ''}`);
  },

  importContacts: async (id, file) => {
    const token = typeof window !== 'undefined' ? localStorage.getItem('token') : null;
    const formData = new FormData();
    formData.append('file', file);
    const res = await fetch(`${API_BASE}/campaigns/${id}/contacts/import`, {
      method: 'POST',
      headers: { ...(token ? { Authorization: `Bearer ${token}` } : {}) },
      body: formData,
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.message || 'Erreur import');
    }
    return res.json();
  },

  logs: (id, filters = {}) => {
    const params = new URLSearchParams();
    Object.entries(filters).forEach(([k, v]) => {
      if (v !== undefined && v !== '') params.append(k, v);
    });
    const qs = params.toString();
    return campaignFetch(`/campaigns/${id}/logs${qs ? `?${qs}` : ''}`);
  },
};

