      return tbl([['#', 'center'], [title, 'left'], ['Factures', 'right'], ['Taux de succès', 'right'], ['Lecture', 'right'], ['Recouvrement', 'right'], ['Score', 'right']], body);
    };
    return sectionTitle('Classement des agences', `Score = 40 % succès + 20 % lecture + 40 % recouvrement · agences d'au moins ${MIN_VOLUME} factures`) +
      make(`Top ${top.length} agences`, top, true) +
