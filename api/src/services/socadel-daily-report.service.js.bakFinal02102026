  </td></tr>

</table></td></tr></table>
</body></html>`;

  // Minification : retire indentations/retours entre balises (poids du mail ↓, Gmail tronque à ~102 Ko)
  return html.replace(/>\s+</g, '><').replace(/\n\s*/g, '');
}

/* ───────────────────────── Envoi email ───────────────────────── */

async function sendDailyReportEmail({ to, cc } = {}) {
  const recipients =
    to ||
    process.env.SOCADEL_REPORT_EMAIL_TO ||
    process.env.REPORT_EMAIL_TO ||
    'patrick.tondjou@camlight.cm';

  const data = await buildReportData();

  logger.info('[SOCADEL-REPORT] buildReportHtml…');
  const emailHtml = buildReportHtml(data); // allégé (corps du mail)
  const fullHtml = buildReportHtml(data, { full: true }); // complet (pièce jointe)
  logger.info(`[SOCADEL-REPORT] HTML email=${emailHtml.length} o · complet=${fullHtml.length} o`);

  try {
    fs.writeFileSync('/tmp/socadel-report-email.html', emailHtml, 'utf8');
    fs.writeFileSync('/tmp/socadel-report.html', fullHtml, 'utf8');
    logger.info('[SOCADEL-REPORT] HTML écrits dans /tmp');
  } catch (err) {
    logger.warn(`[SOCADEL-REPORT] écriture /tmp impossible: ${err.message}`);
  }

  const day = ymd(data.bounds.today);
  const g = data.global;
  const subject = `Socadel — Rapport collecte WhatsApp — ${day}`;
  const text =
    `Rapport Socadel du ${day}\n` +
    `Total à migrer : ${g.total}\n` +
    `N° collectés : ${g.collectes}\n` +
    `Abonnés digitaux : ${g.abonne_digital} (${g.taux_abonne_digital} %)\n` +
    `Montant : ${g.montant}\n\n` +
    `Le détail complet est en pièce jointe (HTML).`;

  const emailService = require('./email.service');
  const transporter =
    emailService.transporter ||
    (typeof emailService.getTransporter === 'function' ? emailService.getTransporter() : null);
  if (!transporter) throw new Error('email.service: transporter introuvable (exports ?)');

  const from = process.env.EMAIL_FROM || process.env.SMTP_FROM || process.env.SMTP_USER;

  // Diagnostic SMTP rapide (n'empêche pas l'envoi si verify() n'est pas supporté)
  if (typeof transporter.verify === 'function') {
    try {
      await withTimeout(transporter.verify(), 15000, 'smtp.verify');
      logger.info('[SOCADEL-REPORT] SMTP verify OK');
    } catch (err) {
      logger.warn(`[SOCADEL-REPORT] SMTP verify: ${err.message}`);
    }
  }

  const attachments =
    process.env.SOCADEL_REPORT_ATTACH === '0'
      ? []
      : [
          {
            filename: `rapport-socadel-${day}.html`,
            content: Buffer.from(fullHtml, 'utf8'),
            contentType: 'text/html; charset=utf-8',
          },
        ];

  logger.info(`[SOCADEL-REPORT] Envoi email → ${recipients}`);
  const info = await withTimeout(
    transporter.sendMail({
      from,
      to: recipients,
      cc: cc || process.env.SOCADEL_REPORT_EMAIL_CC || undefined,
      subject,
      html: emailHtml,
      text,
      attachments,
    }),
    90000,
    'sendMail'
  );

  logger.info(`[SOCADEL-REPORT] Email OK id=${info.messageId}`);
  return { success: true, to: recipients, date: day, messageId: info.messageId };
}

module.exports = {
  buildReportData,
  buildReportHtml,
  sendDailyReportEmail,
  WHATSAPP_UNIT_VALUE,
};
