// api/src/services/chatbot.service.js
'use strict';

const { query } = require('../config/database');
const logger = require('../utils/logger');

const CONTRACT_REGEX = /^20\d{7}$/;
const MAX_ATTEMPTS = 3;
const LOCK_MINUTES = 15;
const INACTIVITY_MINUTES = 3;

