// NORMALISATION NUMÉROS
// ============================================================
function normalizePhone(phone) {
  if (!phone) return null;
  let cleaned = phone.toString().trim().replace(/[\s\-\(\)\.]/g, '');
  let digits = cleaned.replace(/\D/g, '');
  let countryCode = '';
  let localNumber = digits;

  if (digits.startsWith('237'))      { countryCode = '237'; localNumber = digits.substring(3); }
  else if (digits.startsWith('33'))  { countryCode = '33';  localNumber = digits.substring(2); }
  else if (digits.startsWith('221')) { countryCode = '221'; localNumber = digits.substring(3); }
  else if (digits.startsWith('225')) { countryCode = '225'; localNumber = digits.substring(3); }
  else if (digits.startsWith('234')) { countryCode = '234'; localNumber = digits.substring(3); }
  else if (digits.startsWith('233')) { countryCode = '233'; localNumber = digits.substring(3); }
  else if (digits.startsWith('254')) { countryCode = '254'; localNumber = digits.substring(3); }
  else if (digits.startsWith('27'))  { countryCode = '27';  localNumber = digits.substring(2); }
  else {
    if (digits.length === 9) return `+237${digits}`;
    if (digits.length === 8) return `+2376${digits}`;
    return `+${digits}`;
  }

  if (countryCode === '237') {
    if (localNumber.length === 8) localNumber = '6' + localNumber;
    if (localNumber.length === 7) localNumber = '60' + localNumber;
  }

  return `+${countryCode}${localNumber}`;
}

// ============================================================
// HELPERS STATUT
// ============================================================
function getTimestampField(status) {
  return { sent: 'sent_at', delivered: 'delivered_at', read: 'read_at', failed: 'failed_at' }[status] || 'updated_at';
}

function mapWatiStatus(eventType) {
  if (!eventType) return 'unknown';
  const u = eventType.toUpperCase();
  if (u.includes('DELIVERED')) return 'delivered';
  if (u.includes('READ'))      return 'read';
  if (u.includes('FAILED'))    return 'failed';
  if (u.includes('SENT') || u.includes('REPLIED')) return 'sent';
  return 'unknown';
}

function isValidStatusTransition(currentStatus, newStatus) {
  const order = { queued: 0, sent: 1, delivered: 2, read: 3, failed: 4 };
  const cur = order[currentStatus] ?? -1;
  const nxt = order[newStatus]     ?? -1;
  return nxt >= cur || newStatus === 'failed';
}

// ============================================================
// BATCH ENGINE — STATUS UPDATES
// Fenêtre 300ms puis flush groupé WHERE id = ANY($ids)
// ============================================================
class StatusBatchEngine {
  constructor(flushIntervalMs = 300) {
    this.pending        = new Map();
    this.orphans        = [];
    this.flushIntervalMs = flushIntervalMs;
    this.timer          = null;
    this.processing     = false;
  }

  schedule(messageId, clientId, status, timestampDate, waMessageId, failedDetail = null) {
    const existing = this.pending.get(messageId);
    if (existing) {
      const order = { queued: 0, sent: 1, delivered: 2, read: 3, failed: 4 };
      if ((order[existing.status] || 0) >= (order[status] || 0) && status !== 'failed') return;
    }
    this.pending.set(messageId, { status, timestampDate, clientId, waMessageId, failedDetail });
    if (!this.timer) this.timer = setTimeout(() => this.flush(), this.flushIntervalMs);
  }

  scheduleOrphan(payload) {
    this.orphans.push(payload);
    if (!this.timer) this.timer = setTimeout(() => this.flush(), this.flushIntervalMs);
  }

  async flush() {
    this.timer = null;
    if (this.processing) return;
    this.processing = true;
    const updates      = [...this.pending.entries()];
    const orphansBatch = [...this.orphans];
    this.pending.clear();
    this.orphans    = [];
    this.processing = false;

    if (updates.length > 0) {
      await this._flushStatusUpdates(updates).catch(err =>
        logger.error('[BATCH] Erreur flush status:', err.message)
      );
    }
    if (orphansBatch.length > 0) {
      await this._flushOrphans(orphansBatch).catch(err =>
        logger.error('[BATCH] Erreur flush orphans:', err.message)
      );
    }
  }

