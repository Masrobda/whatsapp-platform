};

function normalizeInput(text) {
  return (text || '')
    .toString()
    .trim()
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s]/gu, '')
    .trim();
}

function isYes(input) {
  return ['oui', 'yes', '1', 'o', 'y'].includes(input);
}

function isNo(input) {
  return ['non', 'no', 'n'].includes(input);
}

function isGreeting(input) {
  const g = [
    'bonjour', 'bonsoir', 'salut', 'hello', 'hi', 'hey', 'good morning',
    'good afternoon', 'good evening', 'bjr', 'bsr', 'coucou'
  ];
  return g.some((w) => input === w || input.startsWith(w + ' '));
}

function maskPhone(phone) {
  const p = normalizePhone(phone);
  if (p.length < 6) return '****';
  return p.slice(0, 4) + '****' + p.slice(-3);
}

function normalizePhone(p) {
  if (!p) return '';
  return String(p).replace(/[^0-9+]/g, '').trim();
}

// ============================================================
// CONVERSATION
// ============================================================
async function getOrCreateConversation(phone, botNumber) {
  const existing = await query(`SELECT * FROM bot_conversations WHERE phone = $1`, [phone]);
  if (existing.rows.length > 0) {
    // Rouvrir si clôturée
    if (existing.rows[0].closed_at) {
      await query(
        `UPDATE bot_conversations SET closed_at = NULL, state = COALESCE(state, 'MAIN_MENU'), updated_at = NOW()
         WHERE phone = $1`,
        [phone]
      );
      const refreshed = await query(`SELECT * FROM bot_conversations WHERE phone = $1`, [phone]);
      return refreshed.rows[0];
    }
    return existing.rows[0];
  }
  const created = await query(
    `INSERT INTO bot_conversations (phone, bot_number, state)
     VALUES ($1, $2, 'LANG_SELECT')
     RETURNING *`,
    [phone, botNumber]
  );
  return created.rows[0];
}

async function updateConversation(phone, fields) {
  const setClauses = [];
  const values = [];
  for (const [key, value] of Object.entries(fields)) {
    values.push(value);
    setClauses.push(`${key} = $${values.length}`);
  }
  values.push(phone);
  await query(
    `UPDATE bot_conversations
     SET ${setClauses.join(', ')}, updated_at = NOW(), last_message_at = NOW()
     WHERE phone = $${values.length}`,
    values
  );
}

function remainingLockMinutes(lockedUntil) {
  if (!lockedUntil) return 0;
  const ms = new Date(lockedUntil).getTime() - Date.now();
  return ms > 0 ? Math.ceil(ms / 60000) : 0;
}

// ============================================================
// LOOKUPS
// ============================================================
async function findContract(contractNumber) {
  const result = await query(
    `SELECT contract_number, client_name FROM contracts
     WHERE contract_number = $1 AND is_active = true`,
    [contractNumber]
  );
  return result.rows[0] || null;
}

/** Contrats liés à ce WhatsApp (principal + secondaires) */
async function findContractsForPhone(phone) {
  const norm = normalizePhone(phone);
  const result = await query(
    `
    SELECT DISTINCT contract_number, client_name, whatsapp_phone, 'primary' AS src
    FROM whatsapp_valid_contacts
    WHERE regexp_replace(COALESCE(whatsapp_phone, ''), '[^0-9+]', '', 'g')
        = regexp_replace($1, '[^0-9+]', '', 'g')
    UNION
    SELECT DISTINCT wcp.contract_number,
           COALESCE(wvc.client_name, c.client_name) AS client_name,
           wcp.whatsapp_phone,
           'secondary' AS src
    FROM whatsapp_contact_phones wcp
    LEFT JOIN whatsapp_valid_contacts wvc ON wvc.contract_number = wcp.contract_number
    LEFT JOIN contracts c ON c.contract_number = wcp.contract_number
    WHERE regexp_replace(COALESCE(wcp.whatsapp_phone, ''), '[^0-9+]', '', 'g')
        = regexp_replace($1, '[^0-9+]', '', 'g')
    ORDER BY contract_number
    `,
    [norm]
  );
  // Dédupliquer par contract_number
  const map = new Map();
  for (const row of result.rows) {
    if (!map.has(row.contract_number)) map.set(row.contract_number, row);
  }
  return [...map.values()];
}

async function isContractLinkedToPhone(contractNumber, phone) {
  const list = await findContractsForPhone(phone);
  return list.some((c) => c.contract_number === contractNumber);
}

async function countContractsForPhone(phone) {
  const r = await query(
    `SELECT COUNT(DISTINCT contract_number)::int AS n
     FROM whatsapp_valid_contacts
     WHERE regexp_replace(COALESCE(whatsapp_phone, ''), '[^0-9+]', '', 'g')
         = regexp_replace($1, '[^0-9+]', '', 'g')`,
    [phone]
  );
  return r.rows[0]?.n || 0;
}

async function activateContact(contractNumber, clientName, phone) {
  const existing = await query(
    `SELECT whatsapp_phone, activated_at, client_name
     FROM whatsapp_valid_contacts WHERE contract_number = $1`,
    [contractNumber]
  );

  if (existing.rows.length > 0) {
    const currentPhone = existing.rows[0].whatsapp_phone;
    const same = normalizePhone(currentPhone) === normalizePhone(phone);
    if (!same && phone) {
      await query(
        `INSERT INTO whatsapp_contact_phones
           (contract_number, whatsapp_phone, source, is_primary, collected_by_type)
         VALUES ($1, $2, 'chatbot', false, 'chatbot')
         ON CONFLICT (contract_number, whatsapp_phone) DO NOTHING`,
        [contractNumber, phone]
      );
    }
    if (clientName && clientName !== existing.rows[0].client_name) {
      await query(
        `UPDATE whatsapp_valid_contacts SET client_name = $1 WHERE contract_number = $2`,
        [clientName, contractNumber]
      );
    }
    return { mode: 'already_subscribed', keptPrimary: true, secondaryAdded: !same };
  }

  const n = await countContractsForPhone(phone);
  if (n >= 10) {
    const err = new Error('PHONE_LIMIT_10');
    err.code = 'PHONE_LIMIT_10';
    throw err;
  }

  await query(
    `INSERT INTO whatsapp_valid_contacts
       (contract_number, client_name, whatsapp_phone, activated_at)
     VALUES ($1, $2, $3, NOW())`,
    [contractNumber, clientName, phone]
  );
  await query(
    `INSERT INTO whatsapp_contact_phones
       (contract_number, whatsapp_phone, source, is_primary, collected_by_type)
     VALUES ($1, $2, 'chatbot', true, 'chatbot')
     ON CONFLICT (contract_number, whatsapp_phone) DO NOTHING`,
    [contractNumber, phone]
  );
  return { mode: 'created' };
}

async function handleInvoiceAttemptFailure(phone, conversation, t, errorMessageFn, repromptFn, backToState) {
  const attempts = (conversation.invoice_attempts || 0) + 1;
  if (attempts >= MAX_ATTEMPTS) {
    const lockedUntil = new Date(Date.now() + LOCK_MINUTES * 60000);
    await updateConversation(phone, {
      invoice_attempts: attempts,
      locked_until: lockedUntil,
      state: backToState || conversation.state,
    });
    return { reply: t.locked() };
  }
  await updateConversation(phone, {
    invoice_attempts: attempts,
    state: backToState || conversation.state,
  });
  return { reply: `${errorMessageFn(attempts)}\n\n${repromptFn()}` };
}

async function closeConversation(phone, t) {
  await updateConversation(phone, {
    state: 'MAIN_MENU',
    closed_at: new Date(),
    draft_contract_number: null,
    draft_client_name: null,
    draft_existing_phone: null,
    invoice_attempts: 0,
  });
  return { reply: t.goodbye() };
}

// ============================================================
// MOTEUR
// ============================================================
async function processIncomingText({ phone, text, senderName, botNumber }) {
  let conversation = await getOrCreateConversation(phone, botNumber);

  if (conversation.locked_until && new Date(conversation.locked_until) <= new Date()) {
    await updateConversation(phone, { locked_until: null, invoice_attempts: 0 });
    conversation.locked_until = null;
    conversation.invoice_attempts = 0;
  }

  const lang = conversation.language || 'fr';
  const t = MESSAGES[lang] || MESSAGES.fr;
  const input = normalizeInput(text);
  const displayName = conversation.contact_name || senderName || 'Client';

  // Première interaction / langue
  if (conversation.state === 'LANG_SELECT' && !conversation.language) {
    if (input === '1' || input === '2') {
      const language = input === '1' ? 'fr' : 'en';
      await updateConversation(phone, {
        language,
        contact_name: displayName,
        state: 'MAIN_MENU',
        closed_at: null,
      });
      return {
        reply: MESSAGES[language].mainMenu(displayName),
        requiresTemplate: true,
      };
    }
    await updateConversation(phone, { contact_name: displayName });
    return { reply: MESSAGES.fr.welcome(), requiresTemplate: true };
  }

  // Salutation en cours de conversation → politesse + menu
  if (
    conversation.language &&
    conversation.state === 'MAIN_MENU' &&
    isGreeting(input)
  ) {
    return {
      reply: `${t.greeting(displayName)}\n\n${t.mainMenu(displayName)}`,
    };
  }

  switch (conversation.state) {
    case 'LANG_SELECT': {
      if (input === '1' || input === '2') {
        const language = input === '1' ? 'fr' : 'en';
        await updateConversation(phone, { language, state: 'MAIN_MENU', closed_at: null });
        return { reply: MESSAGES[language].mainMenu(displayName) };
      }
      return { reply: t.langInvalid() };
    }

    case 'MAIN_MENU': {
      if (input === '1') {
        const lockLeft = remainingLockMinutes(conversation.locked_until);
        if (lockLeft > 0) return { reply: t.stillLocked(lockLeft) };
        await updateConversation(phone, {
          state: 'INVOICE_LEGAL',
          invoice_attempts: 0,
          draft_contract_number: null,
          draft_client_name: null,
          draft_existing_phone: null,
        });
        return { reply: t.legalWarning() };
      }
      if (input === '2') {
        const contracts = await findContractsForPhone(phone);
        if (!contracts.length) {
          return { reply: t.lastInvoiceNoContract() };
        }
        const lines = contracts
          .map((c, i) => `${i + 1}. ${c.contract_number} — ${c.client_name || 'Client'}`)
          .join('\n');
        // Stocker la liste ordonnée dans draft (JSON limité) via draft_client_name détourné
        // Mieux: utiliser draft_contract_number pour le choix ; on stocke JSON dans un champ texte
        await updateConversation(phone, {
          state: 'LAST_INVOICE_SELECT',
          draft_client_name: JSON.stringify(
            contracts.map((c) => c.contract_number)
          ),
        });
        return { reply: t.lastInvoiceList(lines) };
      }
      if (input === '3') {
        return closeConversation(phone, t);
      }
      return { reply: t.menuInvalid() };
    }

    case 'INVOICE_LEGAL': {
      if (isYes(input)) {
        await updateConversation(phone, { state: 'INVOICE_CONTRACT_INPUT' });
        return { reply: t.invoicePrompt() };
      }
      if (isNo(input)) {
        await updateConversation(phone, { state: 'MAIN_MENU' });
        return { reply: t.mainMenu(displayName) };
      }
      return { reply: t.confirmInvalid() };
    }

    case 'INVOICE_CONTRACT_INPUT': {
      const lockLeft = remainingLockMinutes(conversation.locked_until);
      if (lockLeft > 0) return { reply: t.stillLocked(lockLeft) };

      // Accepter aussi "20xxxxxxxx" sans normaliser trop agressivement
      const raw = (text || '').toString().replace(/\s/g, '');
      const contractInput = CONTRACT_REGEX.test(input) ? input : raw;

      if (!CONTRACT_REGEX.test(contractInput)) {
        return handleInvoiceAttemptFailure(phone, conversation, t, t.formatError, t.invoicePrompt);
      }

      const contract = await findContract(contractInput);
      if (!contract) {
        return handleInvoiceAttemptFailure(phone, conversation, t, t.contractNotFound, t.invoicePrompt);
      }

      // Déjà un WhatsApp principal différent ?
      const existingLink = await query(
        `SELECT whatsapp_phone FROM whatsapp_valid_contacts WHERE contract_number = $1`,
        [contract.contract_number]
      );

      if (
        existingLink.rows.length > 0 &&
        normalizePhone(existingLink.rows[0].whatsapp_phone) !== normalizePhone(phone)
      ) {
        await updateConversation(phone, {
          state: 'INVOICE_ALREADY_LINKED',
          draft_contract_number: contract.contract_number,
          draft_client_name: contract.client_name,
          draft_existing_phone: existingLink.rows[0].whatsapp_phone,
        });
        return {
          reply: t.alreadyLinked(
            contract.contract_number,
            maskPhone(existingLink.rows[0].whatsapp_phone)
          ),
        };
      }

      await updateConversation(phone, {
        state: 'INVOICE_CONFIRM',
        draft_contract_number: contract.contract_number,
        draft_client_name: contract.client_name,
        draft_existing_phone: null,
      });
      return {
        reply: t.confirm(contract.contract_number, contract.client_name),
      };
    }

    case 'INVOICE_ALREADY_LINKED': {
      if (isYes(input)) {
        // Poursuite → confirmation identité titulaire
        await updateConversation(phone, { state: 'INVOICE_CONFIRM' });
        return {
          reply: t.confirm(
            conversation.draft_contract_number,
            conversation.draft_client_name
          ),
        };
      }
      if (isNo(input)) {
        await updateConversation(phone, {
          state: 'MAIN_MENU',
          draft_contract_number: null,
          draft_client_name: null,
          draft_existing_phone: null,
        });
        return { reply: t.mainMenu(displayName) };
      }
      return { reply: t.confirmInvalid() };
    }

    case 'INVOICE_CONFIRM': {
      const lockLeft = remainingLockMinutes(conversation.locked_until);
      if (lockLeft > 0) return { reply: t.stillLocked(lockLeft) };

      if (isYes(input)) {
        const name = conversation.draft_client_name;
        try {
          await activateContact(
            conversation.draft_contract_number,
            conversation.draft_client_name,
            phone
          );
        } catch (e) {
          if (e.code === 'PHONE_LIMIT_10') {
            await updateConversation(phone, {
              state: 'MAIN_MENU',
              invoice_attempts: 0,
              draft_contract_number: null,
              draft_client_name: null,
              draft_existing_phone: null,
            });
            return { reply: t.phoneLimit() };
          }
          logger.error('[CHATBOT] activateContact error:', e.message);
          throw e;
        }
        await updateConversation(phone, {
          state: 'MAIN_MENU',
          invoice_attempts: 0,
          draft_contract_number: null,
          draft_client_name: null,
          draft_existing_phone: null,
        });
        return { reply: t.subscribeSuccess(name) };
      }

      if (isNo(input)) {
        return handleInvoiceAttemptFailure(
          phone,
          conversation,
          t,
          t.confirmDeny,
          t.invoicePrompt,
          'INVOICE_CONTRACT_INPUT'
        );
      }
      return { reply: t.confirmInvalid() };
    }

    case 'LAST_INVOICE_SELECT': {
      let list = [];
      try {
        list = JSON.parse(conversation.draft_client_name || '[]');
      } catch (_) {
        list = [];
      }
      const idx = parseInt(input, 10);
      if (!idx || idx < 1 || idx > list.length) {
        return { reply: t.lastInvoiceInvalidChoice() };
      }
      const contractNumber = list[idx - 1];

      // Double contrôle sécurité
      const allowed = await isContractLinkedToPhone(contractNumber, phone);
      if (!allowed) {
        await updateConversation(phone, {
          state: 'MAIN_MENU',
          draft_client_name: null,
        });
        return { reply: t.lastInvoiceDenied() };
      }

      let replyMessage = t.lastInvoiceAck();
      try {
        const lastInvoiceService = require('./last-invoice.service');
        const result = await lastInvoiceService.requestLastInvoice(
          contractNumber,
          phone,
          botNumber
        );
        if (result.success === false && result.message) {
          replyMessage = result.message;
        }
      } catch (err) {
        logger.error('[CHATBOT] dernière facture:', err.message);
      }

      await updateConversation(phone, {
        state: 'MAIN_MENU',
        draft_client_name: null,
      });
      return { reply: replyMessage };
    }

    default: {
      await updateConversation(phone, { state: 'MAIN_MENU' });
      return { reply: t.mainMenu(displayName) };
    }
  }
}

/**
 * Clôture les conversations inactives > 3 minutes (appelé par cron)
 * @returns {Promise<Array<{phone, bot_number, language}>>}
 */
async function findInactiveConversations() {
  const result = await query(
    `SELECT phone, bot_number, language, contact_name
     FROM bot_conversations
     WHERE closed_at IS NULL
       AND language IS NOT NULL
       AND last_message_at IS NOT NULL
       AND last_message_at < NOW() - INTERVAL '${INACTIVITY_MINUTES} minutes'
       AND state IS DISTINCT FROM 'LANG_SELECT'`
  );
  return result.rows;
}

async function markClosed(phone) {
  await query(
    `UPDATE bot_conversations
     SET closed_at = NOW(), state = 'MAIN_MENU', updated_at = NOW()
     WHERE phone = $1`,
    [phone]
  );
}

module.exports = {
  processIncomingText,
  MESSAGES,
  activateContact,
  findInactiveConversations,
  markClosed,
  INACTIVITY_MINUTES,
};
