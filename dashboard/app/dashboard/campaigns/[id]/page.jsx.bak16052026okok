                  style={{ padding: '5px 12px', borderRadius: 20, fontSize: 12, fontWeight: 500, cursor: 'pointer',
                    border: '1px solid #e5ebe8', transition: 'all 0.15s',
                    background: logLevel === l ? '#2d7a3e' : 'white',
                    color: logLevel === l ? 'white' : '#6b7c74' }}>
                  {l === '' ? 'Tous' : l.charAt(0).toUpperCase() + l.slice(1)}
                </button>
              ))}
              <span style={{ marginLeft: 'auto', fontSize: 12, color: '#9eada5' }}>
                {logs.length} entrée(s)
              </span>
            </div>

            <div style={{ background: 'white', borderRadius: 16, border: '1px solid #e5ebe8', padding: '24px',
              maxHeight: 600, overflowY: 'auto' }}>
              {logs.length === 0 ? (
                <div style={{ textAlign: 'center', color: '#9eada5', padding: 40, fontSize: 14 }}>Aucun journal trouvé</div>
              ) : (
                logs.map(log => <LogEntry key={log.id} log={log} />)
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

