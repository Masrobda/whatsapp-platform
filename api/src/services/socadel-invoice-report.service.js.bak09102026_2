    const body = steps
      .map(([label, v, prev], i) => {
        const bg = zebra(i);
        const pt = pct(v, g.total);
        const pp = prev == null ? 100 : pct(v, steps[prev][1]);
        const loss = prev == null ? '—' : fmt(Math.max(0, steps[prev][1] - v));
        const color = i === 4 ? C.dark : i === 0 ? C.mid : C.green;
        return `<tr>${td(esc(label), { bg, bold: true })}
          <td style="${cell({ bg })}" width="34%">${progressBar(pt, color, 14)}</td>
          ${td(fmt(v), { align: 'right', bg, bold: true, color: C.dark })}
          ${td(fmtPct(pt), { align: 'right', bg })}
          ${td(prev == null ? '—' : fmtPct(pp), { align: 'right', bg })}
