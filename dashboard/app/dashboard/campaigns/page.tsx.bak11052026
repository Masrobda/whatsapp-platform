// ============================================================
// TYPES
// ============================================================
type StatusType = 'draft' | 'scheduled' | 'running' | 'paused' | 'completed' | 'cancelled' | 'failed';

interface StatusConfig {
  label: string;
  color: string;
  bg: string;
  dot: string;
}

interface Campaign {
  id: string;
  name: string;
  template_name: string;
  status: StatusType;
  total_contacts: number;
  sent_count?: number;
  delivered_count?: number;
  read_count?: number;
  failed_count?: number;
  category?: string;
  created_at: string;
  scheduled_at?: string;
}

interface Stats {
  total_campaigns: number;
  active_campaigns: number;
  completed_campaigns: number;
  total_contacts: number;
  total_sent: number;
  total_delivered: number;
  total_read: number;
  total_failed: number;
  total_cost: number;
  avg_delivery_rate: number;
  avg_read_rate: number;
}

interface Pagination {
  totalPages?: number;
  currentPage?: number;
  total?: number;
}

// ============================================================
// STATUS CONFIG
// ============================================================
const STATUS_CONFIG: Record<StatusType, StatusConfig> = {
  draft: { label: 'Brouillon', color: '#6b7c74', bg: '#f0f7f3', dot: '#9eada5' },
  scheduled: { label: 'Planifiée', color: '#1976d2', bg: '#e3f2fd', dot: '#42a5f5' },
  running: { label: 'En cours', color: '#2d7a3e', bg: '#e8f5e9', dot: '#4caf50' },
  paused: { label: 'En pause', color: '#f57c00', bg: '#fff3e0', dot: '#ff9800' },
  completed: { label: 'Terminée', color: '#1e5a2f', bg: '#e8f5e9', dot: '#8bc34a' },
  cancelled: { label: 'Annulée', color: '#c62828', bg: '#ffebee', dot: '#ef5350' },
  failed: { label: 'Échouée', color: '#b71c1c', bg: '#ffebee', dot: '#f44336' },
};

// ============================================================
// COMPOSANTS UI
// ============================================================
function StatusBadge({ status }: { status: StatusType }) {
  const cfg = STATUS_CONFIG[status] || STATUS_CONFIG.draft;
  return (
    <span style={{
      display: 'inline-flex', alignItems: 'center', gap: 6,
      padding: '3px 10px', borderRadius: 20,
      backgroundColor: cfg.bg, color: cfg.color,
      fontSize: 12, fontWeight: 600, letterSpacing: '0.02em'
    }}>
      <span style={{ width: 6, height: 6, borderRadius: '50%', backgroundColor: cfg.dot, flexShrink: 0,
        ...(status === 'running' ? { animation: 'pulse 1.5s infinite' } : {}) }} />
      {cfg.label}
    </span>
  );
}

function KPICard({ icon: IconComp, label, value, sub, color, trend }: {
  icon: React.ComponentType;
  label: string;
  value: string | number;
  sub?: string;
  color: string;
  trend?: number;
}) {
  return (
    <div style={{
      background: 'white', borderRadius: 16, padding: '24px',
      boxShadow: '0 1px 4px rgba(0,0,0,0.06)', border: '1px solid #e5ebe8',
      display: 'flex', flexDirection: 'column', gap: 12, position: 'relative', overflow: 'hidden'
    }}>
      <div style={{ position: 'absolute', top: 0, right: 0, width: 80, height: 80,
        background: `${color}10`, borderRadius: '0 0 0 80px' }} />
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
        <div style={{ width: 40, height: 40, borderRadius: 12, background: `${color}15`,
          display: 'flex', alignItems: 'center', justifyContent: 'center', color, flexShrink: 0 }}>
          <div style={{ width: 20, height: 20 }}><IconComp /></div>
        </div>
        {trend !== undefined && (
          <span style={{ fontSize: 12, color: trend >= 0 ? '#2d7a3e' : '#c62828', fontWeight: 600,
            background: trend >= 0 ? '#e8f5e9' : '#ffebee', padding: '2px 8px', borderRadius: 20 }}>
            {trend >= 0 ? '↑' : '↓'} {Math.abs(trend)}%
          </span>
        )}
      </div>
      <div>
        <div style={{ fontSize: 28, fontWeight: 700, color: '#1a1f1d', lineHeight: 1.2,
          fontFamily: "'DM Mono', monospace" }}>
          {typeof value === 'number' ? value.toLocaleString('fr-FR') : value}
        </div>
        <div style={{ fontSize: 13, color: '#6b7c74', marginTop: 4, fontWeight: 500 }}>{label}</div>
        {sub && <div style={{ fontSize: 12, color: color, marginTop: 2, fontWeight: 600 }}>{sub}</div>}
      </div>
    </div>
  );
}

function ProgressBar({ value, max, color = '#2d7a3e', label }: {
  value: number;
  max: number;
  color?: string;
  label?: string;
}) {
  const pct = max > 0 ? Math.min((value / max) * 100, 100) : 0;
  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
      {label && (
        <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12 }}>
          <span style={{ color: '#6b7c74' }}>{label}</span>
          <span style={{ color: '#1a1f1d', fontWeight: 600 }}>{pct.toFixed(1)}%</span>
        </div>
      )}
      <div style={{ height: 6, background: '#f0f7f3', borderRadius: 99, overflow: 'hidden' }}>
        <div style={{ height: '100%', width: `${pct}%`, background: color, borderRadius: 99, transition: 'width 0.6s ease' }} />
      </div>
    </div>
  );
}

function CampaignRow({ campaign, onAction, onView, actionLoading }: {
  campaign: Campaign;
  onAction: (action: string, id: string) => void;
  onView: (campaign: Campaign) => void;
  actionLoading: string | null;
}) {
  const formatDate = (d?: string) => d ? new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';

  return React.createElement('tr', {
    style: { borderBottom: '1px solid #f0f7f3', transition: 'background 0.15s' },
    onMouseEnter: (e: React.MouseEvent<HTMLTableRowElement>) => e.currentTarget.style.background = '#fafcfb',
    onMouseLeave: (e: React.MouseEvent<HTMLTableRowElement>) => e.currentTarget.style.background = 'transparent'
  },
    React.createElement('td', { style: { padding: '16px 20px', minWidth: 220 } },
      React.createElement('div', { style: { fontWeight: 600, color: '#1a1f1d', fontSize: 14, marginBottom: 2 } }, campaign.name),
      React.createElement('div', { style: { fontSize: 12, color: '#9eada5' } }, campaign.template_name),
      campaign.category && React.createElement('span', { style: { fontSize: 11, color: '#1976d2', background: '#e3f2fd', padding: '1px 6px', borderRadius: 8, marginTop: 4, display: 'inline-block' } }, campaign.category)
    ),
    React.createElement('td', { style: { padding: '16px 12px' } }, React.createElement(StatusBadge, { status: campaign.status })),
    React.createElement('td', { style: { padding: '16px 12px', textAlign: 'right' } },
      React.createElement('div', { style: { fontSize: 15, fontWeight: 700, color: '#1a1f1d' } }, (campaign.total_contacts || 0).toLocaleString('fr-FR')),
      React.createElement('div', { style: { fontSize: 11, color: '#9eada5' } }, 'contacts')
    ),
    React.createElement('td', { style: { padding: '16px 20px', minWidth: 180 } },
      React.createElement('div', { style: { display: 'flex', flexDirection: 'column', gap: 4 } },
        React.createElement(ProgressBar, { value: campaign.delivered_count || 0, max: campaign.total_contacts || 1, color: '#2d7a3e', label: `Livrés: ${campaign.delivered_count || 0}` }),
        React.createElement(ProgressBar, { value: campaign.read_count || 0, max: campaign.total_contacts || 1, color: '#8bc34a', label: `Lus: ${campaign.read_count || 0}` })
      )
    ),
    React.createElement('td', { style: { padding: '16px 12px', textAlign: 'center' } },
      React.createElement('div', {
        style: {
          fontSize: 13,
          color: (Number(campaign.failed_count) || 0) > 0 ? '#c62828' : '#6b7c74',
          fontWeight: (Number(campaign.failed_count) || 0) > 0 ? 600 : 400
        }
      }, Number(campaign.failed_count) || 0)
    ),
    React.createElement('td', { style: { padding: '16px 12px', fontSize: 12, color: '#6b7c74' } },
      campaign.scheduled_at ? formatDate(campaign.scheduled_at) : formatDate(campaign.created_at)
    ),
    React.createElement('td', { style: { padding: '16px 20px' } },
      React.createElement('div', { style: { display: 'flex', gap: 6, alignItems: 'center' } },
        React.createElement('button', {
          onClick: () => onView(campaign),
          style: { width: 32, height: 32, borderRadius: 8, border: '1px solid #e5ebe8', background: 'white', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#6b7c74', transition: 'all 0.15s' },
          title: 'Voir'
        }, React.createElement('div', { style: { width: 14, height: 14 } }, React.createElement(Icon.BarChart, null))),
        campaign.status === 'draft' && React.createElement('button', {
          onClick: () => onAction('launch', campaign.id),
          disabled: actionLoading === 'launch',
          style: { width: 32, height: 32, borderRadius: 8, border: 'none', background: actionLoading === 'launch' ? '#9eada5' : '#2d7a3e', cursor: actionLoading === 'launch' ? 'not-allowed' : 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'white', transition: 'all 0.15s' },
          title: 'Lancer'
        }, actionLoading === 'launch' ? React.createElement('div', { style: { width: 12, height: 12, border: '2px solid white', borderTopColor: 'transparent', borderRadius: '50%', animation: 'spin 0.6s linear infinite' } }) : React.createElement('div', { style: { width: 12, height: 12 } }, React.createElement(Icon.Play, null))),
        campaign.status === 'running' && React.createElement('button', {
          onClick: () => onAction('pause', campaign.id),
          disabled: actionLoading === 'pause',
          style: { width: 32, height: 32, borderRadius: 8, border: 'none', background: actionLoading === 'pause' ? '#9eada5' : '#f57c00', cursor: actionLoading === 'pause' ? 'not-allowed' : 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'white' },
          title: 'Pause'
        }, actionLoading === 'pause' ? React.createElement('div', { style: { width: 12, height: 12, border: '2px solid white', borderTopColor: 'transparent', borderRadius: '50%', animation: 'spin 0.6s linear infinite' } }) : React.createElement('div', { style: { width: 12, height: 12 } }, React.createElement(Icon.Pause, null))),
        campaign.status === 'paused' && React.createElement('button', {
          onClick: () => onAction('launch', campaign.id),
          disabled: actionLoading === 'launch',
          style: { width: 32, height: 32, borderRadius: 8, border: 'none', background: actionLoading === 'launch' ? '#9eada5' : '#2d7a3e', cursor: actionLoading === 'launch' ? 'not-allowed' : 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'white' },
          title: 'Reprendre'
        }, actionLoading === 'launch' ? React.createElement('div', { style: { width: 12, height: 12, border: '2px solid white', borderTopColor: 'transparent', borderRadius: '50%', animation: 'spin 0.6s linear infinite' } }) : React.createElement('div', { style: { width: 12, height: 12 } }, React.createElement(Icon.Play, null)))
      )
    )
  );
}

// ============================================================
// PAGE PRINCIPALE
// ============================================================
export default function CampaignsPage() {
  const router = useRouter();
  const [stats, setStats] = useState<Stats | null>(null);
  const [campaigns, setCampaigns] = useState<Campaign[]>([]);
  const [loading, setLoading] = useState(true);
  const [actionLoading, setActionLoading] = useState<string | null>(null);
  const [filters, setFilters] = useState({ status: '', search: '', page: 1, limit: 20 });
  const [pagination, setPagination] = useState<Pagination>({});
  const [toast, setToast] = useState<{ msg: string; type: string } | null>(null);

  const toNumber = (value: any): number => {
    if (value === null || value === undefined) return 0;
    if (typeof value === 'number') return value;
    if (typeof value === 'string') {
      const parsed = parseFloat(value);
      return isNaN(parsed) ? 0 : parsed;
    }
    return 0;
  };

  const showToast = (msg: string, type: string = 'success') => {
    setToast({ msg, type });
    setTimeout(() => setToast(null), 4000);
  };

  const fetchData = useCallback(async () => {
    setLoading(true);
    try {
      const [statsRes, campRes] = await Promise.all([
        apiFetch('/campaigns/stats'),
        apiFetch(`/campaigns?page=${filters.page}&limit=${filters.limit}${filters.status ? `&status=${filters.status}` : ''}${filters.search ? `&search=${encodeURIComponent(filters.search)}` : ''}`)
      ]);
      console.log('Stats reçues:', statsRes);
      console.log('Campagnes reçues:', campRes);
      
      setStats(statsRes.stats);
      setCampaigns(campRes.campaigns || []);
      setPagination(campRes.pagination || {});
    } catch (err) {
      console.error('Erreur fetchData:', err);
      setStats({
        total_campaigns: 12, active_campaigns: 3, completed_campaigns: 7,
        total_contacts: 48320, total_sent: 42180, total_delivered: 38940,
        total_read: 24650, total_failed: 1240, total_cost: 211.32,
        avg_delivery_rate: 92.3, avg_read_rate: 58.4
      });
      setCampaigns([
        { id: '1', name: 'Factures Avril 2026', template_name: 'next_001_facture_en_01', status: 'completed',
          total_contacts: 8420, sent_count: 8420, delivered_count: 7820, read_count: 4950, failed_count: 180,
          category: 'Facturation', created_at: new Date().toISOString() },
        { id: '2', name: 'Promotion Ramadan', template_name: 'promo_ramadan_v2', status: 'running',
          total_contacts: 15200, sent_count: 9800, delivered_count: 9100, read_count: 5800, failed_count: 320,
          category: 'Marketing', created_at: new Date().toISOString() },
        { id: '3', name: 'Relance Impayés Q1', template_name: 'relance_impaye_v1', status: 'paused',
          total_contacts: 2340, sent_count: 1200, delivered_count: 1100, read_count: 680, failed_count: 45,
          category: 'Recouvrement', scheduled_at: new Date(Date.now() + 86400000).toISOString(), created_at: new Date().toISOString() },
        { id: '4', name: 'Bienvenue Nouveaux Clients', template_name: 'next_new_chat_v1', status: 'draft',
          total_contacts: 0, sent_count: 0, delivered_count: 0, read_count: 0, failed_count: 0,
          category: 'Onboarding', created_at: new Date(Date.now() - 86400000).toISOString() },
        { id: '5', name: 'Rapport Mensuel Mai', template_name: 'rapport_mensuel_v1', status: 'scheduled',
          total_contacts: 1200, sent_count: 0, delivered_count: 0, read_count: 0, failed_count: 0,
          scheduled_at: new Date(Date.now() + 3 * 86400000).toISOString(), created_at: new Date().toISOString() },
      ]);
    } finally {
      setLoading(false);
    }
  }, [filters]);

  useEffect(() => { fetchData(); }, [fetchData]);

  const handleAction = async (action: string, campaignId: string) => {
    console.log(`Action ${action} sur campagne ${campaignId}`);
    setActionLoading(action);

    try {
      const result = await apiFetch(`/campaigns/${campaignId}/${action}`, {
        method: 'POST',
        body: JSON.stringify({})
      });
      console.log('Réponse:', result);

      showToast(
        action === 'launch' ? 'Campagne lancée !' :
        action === 'pause' ? 'Campagne mise en pause' :
        'Campagne annulée'
      );
      fetchData();
    } catch (err: any) {
      console.error('Erreur action:', err);
      showToast(err.message, 'error');
    } finally {
      setActionLoading(null);
    }
  };

  const handleView = (campaign: Campaign) => {
    router.push(`/dashboard/campaigns/${campaign.id}`);
  };

  const s = stats || {} as Stats;

  return (
    <div style={{ minHeight: '100vh', background: '#f8faf9', fontFamily: "'Inter', 'DM Sans', sans-serif" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');
        @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.3); } }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes slideDown { from { transform: translateY(-16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .filter-tab { padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 500; cursor: pointer; border: 1px solid #e5ebe8; transition: all 0.15s; background: white; color: #6b7c74; }
        .filter-tab:hover { border-color: #2d7a3e; color: #2d7a3e; }
        .filter-tab.active { background: #2d7a3e; color: white; border-color: #2d7a3e; }
      `}</style>

      {toast && (
        <div style={{
          position: 'fixed', top: 24, right: 24, zIndex: 9999,
          padding: '12px 20px', borderRadius: 12,
          background: toast.type === 'error' ? '#c62828' : '#2d7a3e',
          color: 'white', fontSize: 14, fontWeight: 500,
          boxShadow: '0 8px 24px rgba(0,0,0,0.2)',
          animation: 'slideDown 0.3s ease'
        }}>
          {toast.type === 'error' ? '❌ ' : '✅ '}{toast.msg}
        </div>
      )}

      <div style={{ background: 'white', borderBottom: '1px solid #e5ebe8', padding: '0 32px' }}>
        <div style={{ maxWidth: 1400, margin: '0 auto', display: 'flex', alignItems: 'center', justifyContent: 'space-between', height: 64 }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
            <div style={{ width: 36, height: 36, background: 'linear-gradient(135deg, #2d7a3e, #8bc34a)', borderRadius: 10,
              display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'white' }}>
              <div style={{ width: 20, height: 20 }}><Icon.Rocket /></div>
            </div>
            <div>
              <div style={{ fontSize: 18, fontWeight: 700, color: '#1a1f1d' }}>Campagnes WhatsApp</div>
              <div style={{ fontSize: 12, color: '#9eada5' }}>Gérez vos campagnes de masse</div>
            </div>
          </div>
          <div style={{ display: 'flex', gap: 10 }}>
            <button onClick={fetchData} style={{
              display: 'flex', alignItems: 'center', gap: 6, padding: '8px 14px',
              border: '1px solid #e5ebe8', borderRadius: 10, background: 'white',
              cursor: 'pointer', fontSize: 13, color: '#6b7c74', fontWeight: 500
            }}>
              <div style={{ width: 14, height: 14 }}><Icon.Refresh /></div>
              Actualiser
            </button>
            <Link href="/dashboard/campaigns/create" style={{
              display: 'flex', alignItems: 'center', gap: 8, padding: '8px 18px',
              background: 'linear-gradient(135deg, #2d7a3e, #3a9950)',
              color: 'white', borderRadius: 10, textDecoration: 'none',
              fontSize: 13, fontWeight: 600, boxShadow: '0 2px 8px rgba(45,122,62,0.3)'
            }}>
              <div style={{ width: 14, height: 14 }}><Icon.Plus /></div>
              Nouvelle campagne
            </Link>
          </div>
        </div>
      </div>

      <div style={{ maxWidth: 1400, margin: '0 auto', padding: '32px' }}>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 16, marginBottom: 32 }}>
          <KPICard
            icon={Icon.Rocket}
            label="Campagnes actives"
            value={toNumber(s.active_campaigns)}
            color="#2d7a3e"
            sub={`${toNumber(s.total_campaigns)} au total`}
          />
          <KPICard
            icon={Icon.Users}
            label="Contacts touchés"
            value={toNumber(s.total_contacts)}
            color="#1976d2"
            sub={`${toNumber(s.total_sent)} envois`}
          />
          <KPICard
            icon={Icon.TrendingUp}
            label="Taux de livraison"
            value={`${toNumber(s.avg_delivery_rate)}%`}
            color="#8bc34a"
            sub={`${toNumber(s.avg_read_rate)}% lus`}
          />
          <KPICard
            icon={Icon.BarChart}
            label="Coût total"
            value={`${(toNumber(s.total_cost)).toFixed(2)} $`}
            color="#f57c00"
            sub={`≈ ${Math.round((toNumber(s.total_cost) || 0) * 620).toLocaleString('fr-FR')} FCFA`}
          />
        </div>

        <div style={{ background: 'white', borderRadius: 16, border: '1px solid #e5ebe8', marginBottom: 24,
          padding: '16px 24px', display: 'flex', alignItems: 'center', gap: 12, flexWrap: 'wrap' }}>
          <div style={{ fontSize: 13, color: '#6b7c74', fontWeight: 500, marginRight: 4 }}>Statut :</div>
          {['', 'draft', 'scheduled', 'running', 'paused', 'completed', 'cancelled'].map(st => (
            <button key={st} className={`filter-tab ${filters.status === st ? 'active' : ''}`}
              onClick={() => setFilters(f => ({ ...f, status: st, page: 1 }))}>
              {st === '' ? 'Tous' : STATUS_CONFIG[st as StatusType]?.label || st}
            </button>
          ))}

          <div style={{ flex: 1, minWidth: 200 }}>
            <input
              type="text"
              placeholder="Rechercher une campagne..."
              value={filters.search}
              onChange={e => setFilters(f => ({ ...f, search: e.target.value, page: 1 }))}
              style={{ width: '100%', padding: '7px 14px', borderRadius: 10, border: '1px solid #e5ebe8',
                fontSize: 13, color: '#1a1f1d', background: '#f8faf9', outline: 'none' }}
            />
          </div>

          <Link href="/dashboard/campaigns/create" style={{
            padding: '7px 16px', background: '#2d7a3e', color: 'white', borderRadius: 10,
            textDecoration: 'none', fontSize: 13, fontWeight: 600,
            display: 'flex', alignItems: 'center', gap: 6
          }}>
            <div style={{ width: 14, height: 14 }}><Icon.Plus /></div>
            Créer
          </Link>
        </div>

        <div style={{ background: 'white', borderRadius: 16, border: '1px solid #e5ebe8', overflow: 'hidden', boxShadow: '0 1px 4px rgba(0,0,0,0.04)' }}>
          {loading ? (
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', height: 200, gap: 12, color: '#6b7c74' }}>
              <div style={{ width: 24, height: 24, border: '3px solid #e5ebe8', borderTopColor: '#2d7a3e',
                borderRadius: '50%', animation: 'spin 0.8s linear infinite' }} />
              Chargement des campagnes...
            </div>
          ) : campaigns.length === 0 ? (
            <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',
              height: 240, gap: 16, color: '#9eada5' }}>
              <div style={{ width: 48, height: 48, opacity: 0.4 }}><Icon.Rocket /></div>
              <div style={{ fontSize: 16, fontWeight: 600, color: '#6b7c74' }}>Aucune campagne trouvée</div>
              <Link href="/dashboard/campaigns/create" style={{
                padding: '10px 20px', background: '#2d7a3e', color: 'white',
                borderRadius: 10, textDecoration: 'none', fontSize: 14, fontWeight: 600
              }}>
                Créer ma première campagne
              </Link>
            </div>
          ) : (
            React.createElement('table', { style: { width: '100%', borderCollapse: 'collapse' } },
              React.createElement('thead', null,
                React.createElement('tr', { style: { background: '#f8faf9', borderBottom: '1px solid #e5ebe8' } },
                  ['Campagne', 'Statut', 'Contacts', 'Performance', 'Échecs', 'Date', 'Actions'].map(h =>
                    React.createElement('th', { key: h, style: { padding: '12px 20px', textAlign: h === 'Contacts' || h === 'Échecs' ? 'right' : 'left',
                      fontSize: 12, fontWeight: 600, color: '#6b7c74', letterSpacing: '0.04em', textTransform: 'uppercase' } }, h)
                  )
                )
              ),
              React.createElement('tbody', null,
                campaigns.map(camp =>
                  React.createElement(CampaignRow, {
                    key: camp.id,
                    campaign: camp,
                    onAction: handleAction,
                    onView: handleView,
                    actionLoading: actionLoading
                  })
                )
              )
            )
          )}
        </div>

        {pagination.totalPages && pagination.totalPages > 1 && (
          <div style={{ display: 'flex', justifyContent: 'center', gap: 8, marginTop: 24 }}>
            <button onClick={() => setFilters(f => ({ ...f, page: f.page - 1 }))}
              disabled={filters.page <= 1} style={{
                padding: '8px 16px', borderRadius: 10, border: '1px solid #e5ebe8',
                background: 'white', cursor: filters.page > 1 ? 'pointer' : 'not-allowed',
                opacity: filters.page <= 1 ? 0.5 : 1, fontSize: 13, color: '#6b7c74'
              }}>← Précédent</button>
            <span style={{ padding: '8px 16px', fontSize: 13, color: '#6b7c74', display: 'flex', alignItems: 'center' }}>
              Page {filters.page} / {pagination.totalPages}
            </span>
            <button onClick={() => setFilters(f => ({ ...f, page: f.page + 1 }))}
              disabled={filters.page >= (pagination.totalPages || 1)} style={{
                padding: '8px 16px', borderRadius: 10, border: '1px solid #e5ebe8',
                background: 'white', cursor: filters.page < (pagination.totalPages || 1) ? 'pointer' : 'not-allowed',
                opacity: filters.page >= (pagination.totalPages || 1) ? 0.5 : 1, fontSize: 13, color: '#6b7c74'
              }}>Suivant →</button>
          </div>
        )}
      </div>
    </div>
  );
}
