<tr><td align="center" style="padding:20px 8px;">
<table width="900" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:900px;max-width:900px;background:#ffffff;border:1px solid ${C.border};">

  <!-- En-tête -->
  <tr><td bgcolor="${C.navy}" style="background:${C.navy};padding:26px 28px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td valign="middle" style="font-family:${FONT};">
        <div style="font-size:11px;letter-spacing:2px;color:#a9c2e3;text-transform:uppercase;">SOCADEL · Collecte WhatsApp</div>
        <div style="font-size:24px;font-weight:700;color:#ffffff;margin-top:6px;">Rapport journalier</div>
        <div style="font-size:12px;color:#c9d9ee;margin-top:4px;">Migration vers les canaux digitaux · WhatsApp &amp; SMS</div>
