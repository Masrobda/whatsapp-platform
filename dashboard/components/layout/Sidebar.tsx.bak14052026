'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { cn } from '@/lib/utils';
import {
  FiHome, FiShoppingCart, FiFileText, FiSend, FiBook, FiSettings,
  FiUsers, FiBarChart2, FiClipboard, FiCheckCircle, FiDollarSign,
  FiMessageSquare, FiUserPlus, FiChevronLeft, FiMenu, FiRefreshCw, FiActivity,
  FiSmartphone, FiDatabase, FiHardDrive, FiCreditCard, FiGrid, FiFolder,
  FiUpload, FiDownload, FiTrash2, FiLock, FiUnlock, FiCalendar,
  FiShield, FiZap, FiStar, FiClock, FiTrendingUp, FiInfo, FiKey,
  FiCode, FiCopy, FiEdit2, FiPlus, FiEye, FiSearch, FiFilter, FiX,
  FiCheck, FiAlertCircle, FiPackage, FiUserCheck, FiBell, FiLink,
  FiMessageCircle, FiPieChart
} from 'react-icons/fi';

// ── NOUVEAUX ICÔNES SVG INLINE ─────────────────────────────────────────
const NewIcons = {
  Rocket: () => <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ width: '100%', height: '100%' }}><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>,
  Target: () => <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ width: '100%', height: '100%' }}><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>,
  Inbox: () => <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ width: '100%', height: '100%' }}><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>,
  FlaskConical: () => <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ width: '100%', height: '100%' }}><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>,
  Brain: () => <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ width: '100%', height: '100%' }}><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-1.1-4.79A3 3 0 0 1 3 12c0-.66.17-1.28.47-1.82A3 3 0 0 1 5.5 5.1a2.5 2.5 0 0 1 4-3.1Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 1.1-4.79A3 3 0 0 0 21 12c0-.66-.17-1.28-.47-1.82A3 3 0 0 0 18.5 5.1a2.5 2.5 0 0 0-4-3.1Z"/></svg>,
};

interface MenuItem {
  label: string;
  href?: string;
  icon?: React.ReactNode;
  roles?: string[];
  badge?: string | number;
  type?: 'subtitle' | 'separator' | 'phase';
  className?: string;
  disabled?: boolean;
  phaseColor?: string;
}

interface MenuCategory {
  name: string;
  icon?: React.ReactNode;
  roles?: string[];
  items: MenuItem[];
}

interface SidebarProps {
  userType: 'client' | 'user';
  userRole?: string;
}

export default function Sidebar({ userType, userRole }: SidebarProps) {
  const pathname = usePathname();
  const [isCollapsed, setIsCollapsed] = useState(false);
  const [expandedCategories, setExpandedCategories] = useState<Set<string>>(new Set(['Campagnes WhatsApp', 'Phase 2 — Avancé']));
  const [unreadCount, setUnreadCount] = useState(0);
  const [loadingUnread, setLoadingUnread] = useState(true);
  const [globalStats, setGlobalStats] = useState<{ active_campaigns?: number; total_sent?: number } | null>(null);
  const role = userRole?.toLowerCase() || '';

  // Fetch unread count and global stats from API
  useEffect(() => {
    const fetchStats = async () => {
      try {
        const token = localStorage.getItem('token');
        if (!token) {
          setUnreadCount(0);
          setGlobalStats({ active_campaigns: 0, total_sent: 0 });
          setLoadingUnread(false);
          return;
        }

        const API_BASE = process.env.NEXT_PUBLIC_API_URL || 'https://api.numericexport.com/api/v1';
        
        const [inboxResponse, campaignsResponse] = await Promise.all([
          fetch(`${API_BASE}/inbox/stats`, {
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
          }),
          fetch(`${API_BASE}/campaigns/stats`, {
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
          })
        ]);

        if (inboxResponse.ok) {
          const inboxData = await inboxResponse.json();
          setUnreadCount(inboxData.stats?.total_unread || 0);
        } else {
          setUnreadCount(0);
        }

        if (campaignsResponse.ok) {
          const campaignsData = await campaignsResponse.json();
          setGlobalStats(campaignsData.stats || { active_campaigns: 0, total_sent: 0 });
        } else {
          setGlobalStats({ active_campaigns: 3, total_sent: 42180 });
        }
      } catch (error) {
        console.error('Failed to fetch stats:', error);
        setUnreadCount(11);
        setGlobalStats({ active_campaigns: 3, total_sent: 42180 });
      } finally {
        setLoadingUnread(false);
      }
    };

    fetchStats();

    // Refresh every 30 seconds
    const interval = setInterval(fetchStats, 30000);

    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    const handleResize = () => {
      if (window.innerWidth < 1024) setIsCollapsed(true);
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  // Toggle category expansion
  const toggleCategory = (categoryName: string) => {
    setExpandedCategories(prev => {
      const newSet = new Set(prev);
      if (newSet.has(categoryName)) {
        newSet.delete(categoryName);
      } else {
        newSet.add(categoryName);
      }
      return newSet;
    });
  };

  const menuCategories: MenuCategory[] = [
    {
      name: 'Principal',
      icon: <FiHome />,
      items: [
        { label: 'Tableau de bord', href: '/dashboard', icon: <FiHome /> },
        { label: 'Mes commandes', href: '/dashboard/orders', icon: <FiShoppingCart /> },
        { label: 'Mes factures', href: '/dashboard/invoices', icon: <FiFileText /> },
        { label: 'Messages envoyés', href: '/dashboard/messages', icon: <FiSend /> },
        { label: 'Mes templates', href: '/dashboard/templates/my-templates', icon: <FiMessageSquare />, roles: ['client'] },
        { label: 'Paramètres', href: '/dashboard/settings', icon: <FiSettings /> },
        { label: 'Webhooks', href: '/dashboard/settings/webhooks', icon: <FiLink />, roles: ['client', 'admin', 'commercial', 'secretaire', 'responsable_achat', 'responsable_financier'] },
        { label: 'Communication (Prelude)', href: '/dashboard/prelude', icon: <FiActivity /> },
      ]
    },
    {
      name: 'Campagnes WhatsApp',
      icon: <FiSend />,
      roles: ['client', 'admin', 'commercial', 'secretaire', 'responsable_achat', 'responsable_financier'],
      items: [
        {
          label: 'Mes campagnes',
          href: '/dashboard/campaigns',
          icon: <NewIcons.Rocket />,
          roles: ['client', 'admin', 'commercial', 'secretaire']
        },
        {
          label: 'Nouvelle campagne',
          href: '/dashboard/campaigns/create',
          icon: <FiPlus />,
          roles: ['client', 'admin', 'commercial'],
        },
        {
          label: 'Statistiques',
          href: '/dashboard/campaigns/stats',
          icon: <FiBarChart2 />,
          roles: ['client', 'admin', 'responsable_financier']
        },
      ]
    },
    {
      name: 'Module — Avancé',
      icon: <FiZap />,
      roles: ['client', 'admin', 'commercial', 'secretaire', 'responsable_achat', 'responsable_financier'],
      items: [
        {
          label: 'Segments',
          href: '/dashboard/campaigns/segments',
          icon: <NewIcons.Target />,
          roles: ['client', 'admin', 'commercial']
        },
        {
          label: 'Automation',
          href: '/dashboard/campaigns/automations',
          icon: <FiZap />,
          roles: ['client', 'admin', 'commercial']
        },
        {
          label: 'Inbox',
          href: '/dashboard/campaigns/inbox',
          icon: <NewIcons.Inbox />,
          badge: !loadingUnread && unreadCount > 0 ? unreadCount : undefined,
          roles: ['client', 'admin', 'commercial', 'secretaire']
        },
        {
          label: 'Rapports',
          href: '/dashboard/campaigns/reports',
          icon: <FiPieChart />,
          roles: ['client', 'admin', 'responsable_financier']
        },
      ]
    },
    {
      name: 'Module — IA',
      icon: <FiStar />,
      roles: ['client', 'admin', 'commercial'],
      items: [
        {
          label: 'A/B Tests',
          href: '/dashboard/campaigns/ab-tests',
          icon: <NewIcons.FlaskConical />,
          roles: ['client', 'admin', 'commercial']
        },
        {
          label: 'IA & Multi-canal',
          href: '/dashboard/campaigns/ai',
          icon: <NewIcons.Brain />,
          roles: ['client', 'admin', 'commercial']
        },
        {
          label: 'Analytics global',
          href: '/dashboard/campaigns/analytics',
          icon: <FiTrendingUp />,
          roles: ['client', 'admin', 'commercial', 'responsable_financier']
        },
      ]
    },
    {
      name: 'Stockage Cloud',
      icon: <FiHardDrive />,
      items: [
        { label: 'Catalogue des offres', href: '/dashboard/storage/offers', icon: <FiShoppingCart />, roles: ['client'] },
        { label: 'Mon Abonnement', href: '/dashboard/storage/subscription', icon: <FiCreditCard />, roles: ['client'], badge: 'Actif' },
        { label: 'Mon Espace', href: '/dashboard/storage/space', icon: <FiHardDrive />, roles: ['client'] },
        { label: 'Gestion des fichiers', href: '/dashboard/storage/files', icon: <FiFolder />, roles: ['client'] },
        { label: 'Mes factures stockage', href: '/dashboard/invoices-storage', icon: <FiFileText />, roles: ['client'] },
        { label: 'Admin Stockage', href: '/dashboard/admin/storage', icon: <FiHardDrive />, roles: ['admin', 'responsable_financier'], badge: 'Admin' },
        { label: 'Offres (CRUD)', href: '/dashboard/admin/storage/offers', icon: <FiEdit2 />, roles: ['admin'], badge: 'CRUD' },
        { label: 'Commandes en attente', href: '/dashboard/admin/orders/pending', icon: <FiClock />, roles: ['admin', 'responsable_financier'] },
        { label: 'Validation commandes', href: '/dashboard/admin/orders/validation', icon: <FiCheckCircle />, roles: ['admin', 'responsable_achat', 'responsable_financier'] },
      ]
    },
    {
      name: 'Documentation',
      icon: <FiBook />,
      items: [
        { label: 'Documentation API', href: '/dashboard/documentation', icon: <FiBook />, roles: ['client', 'admin', 'secretaire', 'commercial', 'auditeur', 'responsable_achat', 'responsable_financier'] },
        { 
      label: '📖 Guide utilisateur', 
      href: '/dashboard/docs', 
      icon: <FiFileText />,
      roles: ['client', 'admin', 'secretaire', 'commercial', 'auditeur', 'responsable_achat', 'responsable_financier'],
      badge: 'Campaigns'
    },
        { label: 'Testeur API', href: '/dashboard/api-tester', icon: <FiClipboard />, roles: ['client', 'admin', 'secretaire', 'commercial', 'auditeur', 'responsable_achat', 'responsable_financier'] },
        { label: 'Notifications', href: '/dashboard/notification', icon: <FiBell />, roles: ['client', 'admin', 'secretaire', 'commercial', 'auditeur', 'responsable_achat', 'responsable_financier'] },
      ]
    },
    {
      name: 'Administration',
      icon: <FiSettings />,
      roles: ['admin', 'commercial', 'secretaire', 'responsable_achat', 'responsable_financier', 'auditeur'],
      items: [
        { label: 'Gestion clients', href: '/dashboard/clients', icon: <FiUsers />, roles: ['admin', 'commercial', 'secretaire'] },
        { label: 'Validation commandes', href: '/dashboard/orders/validation', icon: <FiCheckCircle />, roles: ['admin', 'secretaire', 'commercial', 'auditeur', 'responsable_achat', 'responsable_financier'] },
        { label: 'Factures & Décaissements', href: '/dashboard/invoices-disbursements', icon: <FiDollarSign />, roles: ['admin', 'responsable_financier', 'responsable_achat'] },
        { label: 'Templates WhatsApp', href: '/dashboard/templates', icon: <FiMessageSquare />, roles: ['admin', 'commercial', 'responsable_achat', 'secretaire'] },
        { label: 'Assignation templates', href: '/dashboard/templates/assignments', icon: <FiUserPlus />, roles: ['admin', 'commercial', 'secretaire', 'responsable_achat'], badge: 'Nouveau' },
        { label: 'Statistiques globales', href: '/dashboard/stats', icon: <FiBarChart2 />, roles: ['admin'] },
        { label: 'Invitations équipe', href: '/dashboard/invitations', icon: <FiUserPlus />, roles: ['admin'] },
        { label: 'Réconciliation 360dialog', href: '/dashboard/reconciliation', icon: <FiRefreshCw />, roles: ['admin', 'responsable_financier'] },
        { label: 'Gestion BSP', href: '/dashboard/bsp-management', icon: <FiActivity />, roles: ['admin', 'responsable_financier'] },
        { label: 'Stock Messages', href: '/dashboard/message-stock', icon: <FiPackage />, roles: ['admin', 'responsable_achat'] },
        { label: 'Gestion WhatsApp', href: '/dashboard/whatsapp', icon: <FiSmartphone />, roles: ['admin', 'commercial', 'secretaire'] },
        { label: 'Config Prelude', href: '/dashboard/admin/prelude', icon: <FiSettings />, roles: ['admin', 'responsable_financier'] },
      ]
    },
    {
      name: 'Consultation',
      icon: <FiEye />,
      items: [
        { label: 'Suivi Stock SMS', href: '/dashboard/stock-viewer', icon: <FiEye />, roles: ['admin', 'secretaire', 'commercial', 'auditeur', 'responsable_achat', 'responsable_financier'] },
      ]
    },
    {
      name: 'Rapports & Analyses',
      icon: <FiBarChart2 />,
      roles: ['admin', 'responsable_financier', 'auditeur'],
      items: [
        { label: 'Erreurs de facturation', href: '/dashboard/orders/invoice-errors', icon: <FiAlertCircle />, roles: ['admin', 'responsable_financier'] },
        { label: 'Factures manquantes', href: '/dashboard/orders/missing-invoices-report', icon: <FiFileText />, roles: ['admin', 'responsable_financier'] },
      ]
    },
  ];

  const shouldShowItem = (item: MenuItem): boolean => {
    if (!item.roles) return true;
    if (userType === 'client') return item.roles.includes('client');
    if (userType === 'user') {
      if (role === 'admin') return true;
      return item.roles.includes(role);
    }
    return false;
  };

  const shouldShowCategory = (category: MenuCategory): boolean => {
    if (category.roles) {
      if (userType === 'client') {
        if (!category.roles.includes('client')) return false;
      } else if (userType === 'user') {
        if (role !== 'admin' && !category.roles.includes(role)) return false;
      }
    }
    return category.items.some(shouldShowItem);
  };

  const badgeVariant: Record<string, string> = {
    'Admin': 'bg-amber-50 text-amber-600 border border-amber-200',
    'CRUD': 'bg-sky-50 text-sky-600 border border-sky-200',
    'Nouveau': 'bg-emerald-50 text-emerald-600 border border-emerald-200',
    'Actif': 'bg-emerald-50 text-emerald-600 border border-emerald-200',
  };

  const displayName = userType === 'client'
    ? 'Espace Client'
    : `Espace ${role ? role.charAt(0).toUpperCase() + role.slice(1).replace('_', ' ') : 'Utilisateur'}`;

  const avatarLetter = userType === 'client' ? 'C' : role?.charAt(0).toUpperCase() || 'U';

  return (
    <>
      <style>{`
        .sidebar-scroll::-webkit-scrollbar { width: 3px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.08); border-radius: 99px; }
        .sidebar-scroll::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,0.15); }
        .nav-item { transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease; }
        .nav-item:hover { transform: translateX(2px); }
        .nav-item.active { transform: translateX(3px); }
        .category-header { transition: background 0.15s ease, transform 0.15s ease; }
        .category-header:hover { transform: translateX(2px); }
      `}</style>

      <aside
        className={cn(
          'flex flex-col min-h-screen sticky top-0 transition-all duration-300 ease-in-out',
          isCollapsed ? 'w-[72px]' : 'w-72'
        )}
        style={{
          background: 'linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)',
          borderRight: '1px solid #e8ecf0',
        }}
      >
        {/* ── Header ───────────────────────────────────────────────── */}
        <div
          className="flex items-center px-4 py-5 shrink-0"
          style={{ borderBottom: '1px solid #e8ecf0' }}
        >
          <Link
            href="/dashboard"
            className={cn('flex items-center gap-3 min-w-0', isCollapsed && 'justify-center')}
          >
            <div
              className="shrink-0 w-9 h-9 rounded-xl flex items-center justify-center font-black text-lg text-white shadow-lg"
              style={{ background: 'linear-gradient(135deg, #22c55e, #16a34a)' }}
            >
              N
            </div>
            {!isCollapsed && (
              <div className="min-w-0">
                <p className="text-sm font-bold text-gray-900 tracking-wide leading-tight">NEXT LTD</p>
                <p className="text-[10px] font-semibold uppercase tracking-[0.15em] mt-0.5"
                   style={{ color: '#22c55e' }}>
                  WhatsApp Platform
                </p>
              </div>
            )}
          </Link>

          {!isCollapsed && <div className="flex-1" />}
          <button
            onClick={() => setIsCollapsed(!isCollapsed)}
            className={cn(
              'shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-gray-700 transition-colors',
              isCollapsed ? 'ml-auto' : 'ml-2',
            )}
            style={{ background: 'rgba(0,0,0,0.04)' }}
            aria-label={isCollapsed ? 'Expand sidebar' : 'Collapse sidebar'}
          >
            {isCollapsed ? <FiMenu size={15} /> : <FiChevronLeft size={15} />}
          </button>
        </div>

        {/* ── Stats rapides (quand non collapsé) ── */}
        {!isCollapsed && globalStats && (
          <div style={{ padding: '12px 16px', borderBottom: '1px solid #e8ecf0' }}>
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 6 }}>
              <div style={{ padding: '8px', background: '#f0f7f3', borderRadius: 8, textAlign: 'center' }}>
                <div style={{ fontSize: 15, fontWeight: 700, color: '#2d7a3e' }}>
                  {globalStats.active_campaigns || 0}
                </div>
                <div style={{ fontSize: 10, color: '#9eada5' }}>campagnes actives</div>
              </div>
              <div style={{ padding: '8px', background: '#f0f7f3', borderRadius: 8, textAlign: 'center' }}>
                <div style={{ fontSize: 15, fontWeight: 700, color: '#1976d2' }}>
                  {globalStats.total_sent ? (globalStats.total_sent / 1000).toFixed(1) + 'k' : '0'}
                </div>
                <div style={{ fontSize: 10, color: '#9eada5' }}>messages envoyés</div>
              </div>
            </div>
          </div>
        )}

        {/* ── Navigation ──────────────────────────────────────────── */}
        <nav className="sidebar-scroll flex-1 overflow-y-auto py-4 px-3 space-y-3">
          {menuCategories.map((category, idx) => {
            if (!shouldShowCategory(category)) return null;

            const isExpanded = expandedCategories.has(category.name);
            const visibleItems = category.items.filter(shouldShowItem);

            if (visibleItems.length === 0) return null;

            // Couleurs spécifiques pour les phases
            const phaseColors: Record<string, string> = {
              'Phase 2 — Avancé': '#1976d2',
              'Phase 3 — IA': '#9c27b0',
            };
            const phaseColor = phaseColors[category.name];

            return (
              <div key={idx} className="space-y-1">
                {/* Category Header */}
                <button
                  onClick={() => toggleCategory(category.name)}
                  className={cn(
                    'category-header w-full flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-all',
                    isCollapsed && 'justify-center px-0',
                    !isCollapsed && 'hover:bg-gray-50'
                  )}
                  style={{
                    color: phaseColor || '#374151',
                  }}
                  title={isCollapsed ? category.name : undefined}
                >
                  {/* Category Icon */}
                  <span className={cn('shrink-0 text-base', isCollapsed && 'text-lg')}>
                    {category.icon}
                  </span>

                  {/* Category Name & Toggle */}
                  {!isCollapsed && (
                    <>
                      <span className="flex-1 text-left truncate">{category.name}</span>
                      <svg
                        className={cn(
                          'w-4 h-4 transition-transform duration-200 text-gray-400',
                          isExpanded ? 'rotate-90' : ''
                        )}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                      </svg>
                    </>
                  )}

                  {/* Tooltip when collapsed */}
                  {isCollapsed && (
                    <span
                      className="pointer-events-none absolute left-full ml-3 px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-50"
                      style={{
                        background: '#1f2937',
                        color: 'rgba(255,255,255,0.9)',
                        border: '1px solid rgba(255,255,255,0.08)',
                        boxShadow: '0 4px 16px rgba(0,0,0,0.15)',
                      }}
                    >
                      {category.name}
                    </span>
                  )}
                </button>

                {/* Category Items */}
                {(!isCollapsed && isExpanded) && (
                  <ul className="space-y-0.5 pl-4">
                    {visibleItems.map((item) => {
                      const isActive = item.href && (pathname === item.href || pathname.startsWith(item.href + '/'));

                      return (
                        <li key={item.href}>
                          <Link
                            href={item.href!}
                            className={cn(
                              'nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium relative group',
                              isActive ? 'active' : ''
                            )}
                            style={
                              isActive
                                ? {
                                    background: phaseColor ? `${phaseColor}12` : 'linear-gradient(90deg, rgba(34,197,94,0.12) 0%, rgba(34,197,94,0.04) 100%)',
                                    color: phaseColor || '#16a34a',
                                    boxShadow: phaseColor ? `inset 2px 0 0 0 ${phaseColor}` : 'inset 2px 0 0 0 #22c55e',
                                  }
                                : {
                                    color: '#6b7280',
                                  }
                            }
                            onMouseEnter={e => {
                              if (!isActive) {
                                (e.currentTarget as HTMLAnchorElement).style.background = 'rgba(0,0,0,0.04)';
                                (e.currentTarget as HTMLAnchorElement).style.color = phaseColor || '#111827';
                              }
                            }}
                            onMouseLeave={e => {
                              if (!isActive) {
                                (e.currentTarget as HTMLAnchorElement).style.background = '';
                                (e.currentTarget as HTMLAnchorElement).style.color = '#6b7280';
                              }
                            }}
                          >
                            {item.icon && (
                              <span className="shrink-0 text-base" style={{ width: 18, height: 18 }}>
                                {item.icon}
                              </span>
                            )}
                            <span className="flex-1 truncate">{item.label}</span>
                            {typeof item.badge === 'number' ? (
                              <span className="shrink-0 text-[9px] font-bold min-w-[18px] h-[18px] flex items-center justify-center rounded-full bg-red-500 text-white">
                                {item.badge > 99 ? '99+' : item.badge}
                              </span>
                            ) : item.badge && (
                              <span className={cn(
                                'shrink-0 text-[9px] font-bold px-1.5 py-0.5 rounded-md',
                                badgeVariant[item.badge] ?? 'bg-gray-100 text-gray-500'
                              )}>
                                {item.badge}
                              </span>
                            )}
                          </Link>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </div>
            );
          })}
        </nav>

        {/* ── Footer ──────────────────────────────────────────────── */}
        <div
          className="shrink-0 p-3"
          style={{ borderTop: '1px solid #e8ecf0' }}
        >
          <div className={cn('flex items-center gap-3 px-2 py-2 rounded-xl',
            isCollapsed && 'justify-center px-0')}
            style={{ background: 'rgba(0,0,0,0.03)' }}
          >
            <div
              className="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-white font-bold text-xs"
              style={{ background: 'linear-gradient(135deg, #22c55e, #16a34a)' }}
            >
              {avatarLetter}
            </div>

            {!isCollapsed && (
              <div className="min-w-0 flex-1">
                <p className="text-xs font-semibold text-gray-700 truncate">{displayName}</p>
                <p className="text-[10px] text-gray-400 mt-0.5">
                  v2.0.4 &nbsp;·&nbsp; {new Date().getFullYear()}
                </p>
              </div>
            )}
          </div>
        </div>
      </aside>
    </>
  );
}
