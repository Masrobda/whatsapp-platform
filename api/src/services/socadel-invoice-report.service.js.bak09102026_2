  const rateCell = (rate, target, bg) =>
    `<td style="${cell({ align: 'right', bg })}"><span style="font-weight:700;color:${C.dark};">${fmtPct(rate)}</span>${progressBar(rate, rateColor(rate, target), 4)}</td>`;

  /* ── 0. Hero + synthèse ── */
