    </td></tr></table></td>`;

  const insightBox = (title, items, color) => `<td width="33%" valign="top" style="padding:0 6px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid ${C.border};border-top:3px solid ${color};background:#ffffff;"><tr><td style="padding:12px 14px;font-family:${FONT};font-size:11.5px;line-height:1.5;color:${C.text};">
      <div style="font-size:12.5px;font-weight:700;color:${C.dark};margin-bottom:8px;">${title}</div>
      ${items.map((t) => `<div style="margin-bottom:7px;">• ${t}</div>`).join('')}
