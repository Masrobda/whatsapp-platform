/* ───────────────────────── Helpers ───────────────────────── */
const nbsp = (s) => String(s).replace(/[\u202f\u00a0]/g, '\u00a0');
const fmt = (n) => nbsp(Math.round(Number(n || 0)).toLocaleString('fr-FR'));
const fmtPct = (n) => nbsp(`${Number(n || 0).toFixed(1).replace('.', ',')} %`);
const fmtDec = (n, d = 1) => Number(n || 0).toFixed(d).replace('.', ',');
const fmtK = (n) => {
  const v = Number(n || 0);
  if (v >= 1e6) return `${(v / 1e6).toFixed(1).replace('.', ',')}M`;
  if (v >= 1e3) return `${(v / 1e3).toFixed(v >= 1e4 ? 0 : 1).replace('.', ',')}k`;
  return String(Math.round(v));
};
const money = (n) => {
  const v = Number(n || 0);
  if (v >= 1e9) return nbsp(`${(v / 1e9).toFixed(2).replace('.', ',')} Md FCFA`);
  if (v >= 1e6) return nbsp(`${(v / 1e6).toFixed(1).replace('.', ',')} M FCFA`);
  return nbsp(`${fmt(v)} FCFA`);
};
const fmtHours = (h) => {
  if (h == null || Number.isNaN(Number(h))) return '—';
  h = Number(h);
  if (h < 1) return nbsp(`${Math.round(h * 60)} min`);
  if (h < 48) return nbsp(`${fmtDec(h)} h`);
  return nbsp(`${fmtDec(h / 24)} j`);
};
const fmtDays = (d) => (d == null || Number.isNaN(Number(d)) ? '—' : nbsp(`${fmtDec(d)} j`));
const esc = (s) =>
  String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

function pct(num, den) {
  if (!den || den <= 0) return 0;
  return Math.round((Number(num) / Number(den)) * 1000) / 10;
}

const pad = (n) => String(n).padStart(2, '0');
function toDay(v) {
  if (v instanceof Date) return v;
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(v));
  return m ? new Date(+m[1], +m[2] - 1, +m[3]) : new Date(v);
}
const ymd = (v) => {
  const d = toDay(v);
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
};
const dm = (v) => {
  if (!v) return '—';
  const d = toDay(v);
  return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}`;
};
const maskPhone = (t) => {
  const s = String(t || '');
  return s ? s.slice(0, 4) + s.slice(4).replace(/\d(?=\d{4})/g, '•') : '';
};

function withTimeout(promise, ms, label) {
  let timer;
  const timeout = new Promise((_, reject) => {
    timer = setTimeout(() => reject(new Error(`Timeout ${label} ${ms}ms`)), ms);
  });
  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
}

async function step(label, fn, fallback) {
  const t0 = Date.now();
  try {
    const r = await withTimeout(fn(), QUERY_TIMEOUT_MS, label);
    logger.info(`[SOCADEL-INVOICE] ${label} OK (+${Date.now() - t0}ms)`);
    return r;
  } catch (err) {
    console.error(`[SOCADEL-INVOICE] ${label} ÉCHEC: ${err.message}`);
    try {
      logger.error(`[SOCADEL-INVOICE] ${label} ÉCHEC: ${err.message}`);
    } catch (_) {}
    if (fallback === undefined) throw err;
    return fallback;
  }
}

/* ───────────────────────── SQL ─────────────────────────
 * Périmètre : factures du cycle/année (émission à venir) de mysql_invoices_all,
 * rapprochées des paiements oracle_payments (num_rec = numero_facture).
 * Paramètres : $1 = cycle, $2 = année.
 *
 * Définitions :
 *  tried      = envoi tenté (queued, delivered, read, failed)
 *  delivered  = distribuée (delivered ou read)
 *  paid       = paiement enregistré (montant_paye > 0)
 *  delay_pay  = date de paiement - jour de distribution (jours)
 */
const BASE = `
WITH t AS (SELECT (NOW() AT TIME ZONE 'Africa/Douala')::date AS today),
r AS (
  SELECT
    COALESCE(NULLIF(i.region, ''),    'Non renseigné') AS region,
    COALESCE(NULLIF(i.division, ''),  'Non renseigné') AS division,
    COALESCE(NULLIF(i.mrc, ''),       'Non renseigné') AS mrc,
    COALESCE(NULLIF(i.agence, ''),    'Non renseigné') AS agence,
    COALESCE(NULLIF(i.categorie, ''), 'Non renseigné') AS categorie,
    i.nom_client, i.numero_contrat, i.numero_facture, i.telephone,
    COALESCE(i.montant, 0)::float8 AS montant,
    i.due_date, i.date_creation,
    COALESCE(i.whatsapp_status, 'pending') AS st,
    i.whatsapp_sent_at AS sent_at,
    COALESCE(i.whatsapp_attempts, 0) AS attempts,
    i.whatsapp_error AS err,
    (i.contact_ws_status = 'valid') AS is_valid,
    (p.num_rec IS NOT NULL AND COALESCE(p.montant_paye, 0) > 0) AS paid,
    COALESCE(p.montant_paye, 0)::float8 AS montant_paye,
    CASE WHEN p.date_paiement ~ '^[0-9]{2}/[0-9]{2}/[0-9]{2}$'
         THEN to_date(p.date_paiement, 'DD/MM/YY') END AS pay_date,
    (i.whatsapp_sent_at AT TIME ZONE 'Africa/Douala')::date AS sent_day
  FROM mysql_invoices_all i
  LEFT JOIN oracle_payments p ON p.num_rec = i.numero_facture
  WHERE i.cycle = $1 AND i.annee = $2
),
b AS (
  SELECT r.*,
    t.today,
    (r.st IN ('queued', 'delivered', 'read', 'failed')) AS tried,
    (r.st IN ('delivered', 'read')) AS delivered,
    CASE WHEN r.paid AND r.pay_date IS NOT NULL AND r.sent_day IS NOT NULL
         THEN r.pay_date - r.sent_day END AS delay_pay,
    CASE WHEN r.sent_at IS NOT NULL AND r.date_creation IS NOT NULL AND r.sent_at >= r.date_creation
         THEN EXTRACT(EPOCH FROM (r.sent_at - r.date_creation)) / 3600.0 END AS delay_dist_h
  FROM r CROSS JOIN t
)`;

const METRICS = `
  COUNT(*)::int AS total,
  COALESCE(SUM(montant), 0)::float8 AS montant,
  COUNT(*) FILTER (WHERE is_valid)::int AS valides,
  COUNT(*) FILTER (WHERE tried)::int AS envoyees,
  COUNT(*) FILTER (WHERE delivered)::int AS distribuees,
  COUNT(*) FILTER (WHERE st = 'read')::int AS lues,
  COUNT(*) FILTER (WHERE st = 'failed')::int AS echecs,
  COALESCE(SUM(montant) FILTER (WHERE delivered), 0)::float8 AS montant_distribue,
  COUNT(*) FILTER (WHERE delivered AND paid)::int AS payees,
  COALESCE(SUM(montant_paye) FILTER (WHERE delivered AND paid), 0)::float8 AS montant_paye,
  AVG(delay_pay) FILTER (WHERE delivered AND paid AND delay_pay >= 0)::float8 AS delai_paiement,
  AVG(delay_dist_h)::float8 AS delai_dist_h`;

const SUM_KEYS = [
  'total', 'montant', 'valides', 'envoyees', 'distribuees', 'lues', 'echecs',
  'montant_distribue', 'payees', 'montant_paye',
];

function enrich(r) {
  const o = { ...r };
  o.tx_valide = pct(r.valides, r.total);
  o.tx_envoi = pct(r.envoyees, r.total);
  o.tx_succes = pct(r.distribuees, r.total);
  o.tx_succes_valides = pct(r.distribuees, r.valides);
  o.tx_lecture = pct(r.lues, r.distribuees);
  o.tx_echec = pct(r.echecs, r.envoyees);
  o.tx_recouv = Math.min(100, pct(r.montant_paye, r.montant_distribue));
  o.tx_paiement = pct(r.payees, r.distribuees);
  // Score composite : 40 % succès + 20 % lecture + 40 % recouvrement
  o.score = Math.round((0.4 * o.tx_succes + 0.2 * o.tx_lecture + 0.4 * o.tx_recouv) * 10) / 10;
  return o;
}

function sumRows(rows) {
  const s = Object.fromEntries(SUM_KEYS.map((k) => [k, 0]));
  let dp = 0;
  for (const r of rows) {
    for (const k of SUM_KEYS) s[k] += Number(r[k] || 0);
    dp += Number(r.delai_paiement || 0) * Number(r.payees || 0);
  }
  s.delai_paiement = s.payees ? dp / s.payees : null;
  return enrich(s);
}

async function resolveCycle(opts = {}) {
  const y = opts.annee || process.env.SOCADEL_INVOICE_YEAR;
  const c = opts.cycle || process.env.SOCADEL_INVOICE_CYCLE;
  if (y && c) return { annee: +y, cycle: +c };
  const r = await query(`
    SELECT annee, cycle FROM mysql_invoices_all
    WHERE annee IS NOT NULL AND cycle IS NOT NULL
    ORDER BY annee DESC, cycle DESC LIMIT 1`);
  if (!r.rows[0]) throw new Error('Aucune facture trouvée dans mysql_invoices_all');
  return { annee: r.rows[0].annee, cycle: r.rows[0].cycle };
}

const run = async (sql, params) => (await query(sql, params)).rows;

async function fetchGlobal(p) {
  const rows = await run(
    `${BASE}
     SELECT ${METRICS},
       (SELECT today FROM t) AS today,
       COUNT(DISTINCT numero_contrat)::int AS contrats,
       COUNT(*) FILTER (WHERE NOT is_valid)::int AS invalides,
       COUNT(*) FILTER (WHERE st = 'pending')::int AS pending,
       COUNT(*) FILTER (WHERE st = 'processing')::int AS processing,
       COUNT(*) FILTER (WHERE st = 'queued')::int AS queued,
       COUNT(*) FILTER (WHERE st = 'skipped')::int AS skipped,
       COUNT(*) FILTER (WHERE attempts > 1)::int AS retries,
       COUNT(*) FILTER (WHERE paid)::int AS payees_total,
       COALESCE(SUM(montant_paye) FILTER (WHERE paid), 0)::float8 AS montant_paye_total,
       COUNT(*) FILTER (WHERE delivered AND paid AND delay_pay < 0)::int AS payees_avant_dist,
       COUNT(*) FILTER (WHERE delivered AND paid AND pay_date <= due_date)::int AS payees_avant_echeance,
       COUNT(*) FILTER (WHERE NOT delivered AND NOT paid)::int AS nd_np,
       COALESCE(SUM(montant) FILTER (WHERE NOT delivered AND NOT paid), 0)::float8 AS nd_np_montant,
       PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY delay_dist_h) AS dist_med_h,
       PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY delay_dist_h) AS dist_p90_h,
       PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY delay_pay::float8)
         FILTER (WHERE delivered AND paid AND delay_pay >= 0) AS pay_med,
       PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY delay_pay::float8)
         FILTER (WHERE delivered AND paid AND delay_pay >= 0) AS pay_p90,
       MIN(due_date) AS due_min, MAX(due_date) AS due_max,
       MIN(sent_at) AS first_sent, MAX(sent_at) AS last_sent
     FROM b`,
    [p.cycle, p.annee]
  );
  return rows[0];
}

const fetchStatus = (p) =>
  run(`${BASE} SELECT st, COUNT(*)::int AS nb, COALESCE(SUM(montant),0)::float8 AS montant
       FROM b GROUP BY st ORDER BY nb DESC`, [p.cycle, p.annee]);

const fetchErrors = (p) =>
  run(
    `${BASE}
     SELECT CASE
       WHEN err IS NULL OR err = '' THEN 'Cause non renseignée'
       WHEN err ILIKE '%not a valid%' OR err ILIKE '%invalid%' OR err ILIKE '%131026%'
         OR err ILIKE '%not registered%' OR err ILIKE '%no whatsapp%' THEN 'Numéro invalide / sans WhatsApp'
       WHEN err ILIKE '%rate%' OR err ILIKE '%limit%' OR err ILIKE '%130429%' OR err ILIKE '%throttl%' THEN 'Limite de débit'
       WHEN err ILIKE '%template%' THEN 'Modèle de message'
       WHEN err ILIKE '%block%' OR err ILIKE '%opt-out%' OR err ILIKE '%opted%' OR err ILIKE '%131050%' THEN 'Bloqué / désabonné'
       WHEN err ILIKE '%timeout%' OR err ILIKE '%network%' OR err ILIKE '%econn%' OR err ILIKE '%unavailable%' THEN 'Erreur technique / réseau'
       ELSE 'Autre cause' END AS cause,
       COUNT(*)::int AS nb, COALESCE(SUM(montant),0)::float8 AS montant
     FROM b WHERE st = 'failed' GROUP BY 1 ORDER BY nb DESC`,
    [p.cycle, p.annee]
  );

const fetchErrorsRaw = (p) =>
  run(
    `${BASE}
     SELECT LEFT(err, 90) AS err, COUNT(*)::int AS nb
     FROM b WHERE st = 'failed' AND err IS NOT NULL AND err <> ''
     GROUP BY 1 ORDER BY nb DESC LIMIT 5`,
    [p.cycle, p.annee]
  );

const fetchAttempts = (p) =>
  run(
    `${BASE}
     SELECT attempts, COUNT(*)::int AS nb,
       COUNT(*) FILTER (WHERE delivered)::int AS distribuees,
       COUNT(*) FILTER (WHERE st = 'failed')::int AS echecs
     FROM b WHERE tried GROUP BY attempts ORDER BY attempts`,
    [p.cycle, p.annee]
  );

const fetchDaily = (p) =>
  run(
    `${BASE},
     d AS (
       SELECT generate_series(
         GREATEST(
           (SELECT today FROM t) - 30,
           LEAST(
             COALESCE((SELECT MIN(sent_day) FROM b), (SELECT today FROM t)),
             COALESCE((SELECT MIN(pay_date) FROM b), (SELECT today FROM t))
           )
         ),
         (SELECT today FROM t), '1 day'::interval)::date AS jour
     ),
     s AS (
       SELECT sent_day AS jour,
         COUNT(*) FILTER (WHERE tried)::int AS envoyees,
         COUNT(*) FILTER (WHERE delivered)::int AS distribuees,
         COUNT(*) FILTER (WHERE st = 'failed')::int AS echecs,
         COALESCE(SUM(montant) FILTER (WHERE delivered), 0)::float8 AS montant_distribue
       FROM b WHERE sent_day IS NOT NULL GROUP BY 1
     ),
     pm AS (
       SELECT pay_date AS jour, COUNT(*)::int AS payees,
         COALESCE(SUM(montant_paye), 0)::float8 AS montant_paye
       FROM b WHERE paid AND pay_date IS NOT NULL GROUP BY 1
     )
     SELECT d.jour,
       COALESCE(s.envoyees, 0) AS envoyees, COALESCE(s.distribuees, 0) AS distribuees,
       COALESCE(s.echecs, 0) AS echecs, COALESCE(s.montant_distribue, 0) AS montant_distribue,
       COALESCE(pm.payees, 0) AS payees, COALESCE(pm.montant_paye, 0) AS montant_paye
     FROM d LEFT JOIN s ON s.jour = d.jour LEFT JOIN pm ON pm.jour = d.jour
     ORDER BY d.jour`,
    [p.cycle, p.annee]
  );

const fetchDailyRegion = (p) =>
  run(
    `${BASE}
     SELECT sent_day AS jour, region, COUNT(*)::int AS nb
     FROM b WHERE delivered AND sent_day IS NOT NULL
     GROUP BY 1, 2 ORDER BY 1, 2`,
    [p.cycle, p.annee]
  );

const fetchPayBuckets = (p) =>
  run(
    `${BASE}
     SELECT ord, COUNT(*)::int AS nb, COALESCE(SUM(montant_paye),0)::float8 AS montant FROM (
       SELECT CASE WHEN delay_pay < 0 THEN 0 WHEN delay_pay = 0 THEN 1 WHEN delay_pay = 1 THEN 2
                   WHEN delay_pay <= 3 THEN 3 WHEN delay_pay <= 7 THEN 4 WHEN delay_pay <= 15 THEN 5 ELSE 6 END AS ord,
              montant_paye
       FROM b WHERE delivered AND paid AND delay_pay IS NOT NULL
     ) x GROUP BY ord ORDER BY ord`,
    [p.cycle, p.annee]
  );

const fetchEcheancier = (p) =>
  run(
    `${BASE}
     SELECT ord, COUNT(*)::int AS nb, COALESCE(SUM(montant),0)::float8 AS montant FROM (
       SELECT CASE
         WHEN due_date IS NULL THEN 10
         WHEN due_date - today < -30 THEN 0 WHEN due_date - today < -15 THEN 1
         WHEN due_date - today < -7 THEN 2 WHEN due_date - today < 0 THEN 3
         WHEN due_date - today = 0 THEN 4 WHEN due_date - today = 1 THEN 5
         WHEN due_date - today = 2 THEN 6 WHEN due_date - today = 3 THEN 7
         WHEN due_date - today <= 7 THEN 8 ELSE 9 END AS ord,
         montant
       FROM b WHERE delivered AND NOT paid
     ) x GROUP BY ord ORDER BY ord`,
    [p.cycle, p.annee]
  );

// whereSql est une constante interne (jamais issue d'une saisie utilisateur)
const RELANCE_SOON = 'due_date IS NOT NULL AND due_date >= today AND due_date <= today + 3';
const RELANCE_LATE = 'due_date IS NOT NULL AND due_date < today';
const fetchRelance = (p, whereSql, limit) =>
  run(
    `${BASE}
     SELECT nom_client, numero_contrat, numero_facture, agence, mrc, division, region, categorie, telephone,
       montant, due_date, (due_date - today)::int AS jours, st
     FROM b WHERE delivered AND NOT paid AND ${whereSql}
     ORDER BY montant DESC LIMIT $3`,
    [p.cycle, p.annee, limit]
  );

const fetchPareto = (p) =>
  run(
    `${BASE},
     k AS (SELECT b.*, ROW_NUMBER() OVER (ORDER BY montant DESC, numero_facture) AS rn,
                  COUNT(*) OVER () AS n FROM b)
     SELECT CASE WHEN rn <= CEIL(0.2 * n) THEN 'top' ELSE 'rest' END AS seg, ${METRICS}
     FROM k GROUP BY 1`,
    [p.cycle, p.annee]
  );

const fetchConcentration = (p) =>
  run(
    `${BASE},
     k AS (SELECT montant, ROW_NUMBER() OVER (ORDER BY montant DESC) AS rn,
                  COUNT(*) OVER () AS n,
                  SUM(montant) OVER (ORDER BY montant DESC ROWS UNBOUNDED PRECEDING) AS cum,
                  SUM(montant) OVER () AS tot FROM b)
     SELECT MIN(rn)::int AS k80, MAX(n)::int AS n, MAX(tot)::float8 AS tot
     FROM k WHERE cum >= 0.8 * tot`,
    [p.cycle, p.annee]
  );

const fetchBigUnpaid = (p) =>
  run(
    `${BASE}
     SELECT nom_client, agence, categorie, montant, due_date, st
     FROM b WHERE NOT paid ORDER BY montant DESC LIMIT 10`,
    [p.cycle, p.annee]
  );

const fetchChannel = (p) =>
  run(
    `${BASE}
     SELECT CASE WHEN st = 'read' THEN 'lue' WHEN st = 'delivered' THEN 'delivree' ELSE 'non_distribuee' END AS seg,
       COUNT(*)::int AS total, COALESCE(SUM(montant),0)::float8 AS montant,
       COUNT(*) FILTER (WHERE paid)::int AS payees,
       COALESCE(SUM(montant_paye),0)::float8 AS montant_paye
     FROM b GROUP BY 1`,
    [p.cycle, p.annee]
  );

async function fetchDim(p, expr, { order = 'total DESC', parent = null } = {}) {
  const rows = await run(
    `${BASE}
     SELECT ${expr} AS label, ${parent ? `MIN(${parent}) AS parent,` : ''} ${METRICS}
     FROM b GROUP BY 1 ORDER BY ${order}`,
    [p.cycle, p.annee]
  );
  return rows.map(enrich);
}

const TRANCHE_EXPR = `CASE
  WHEN montant < 5000 THEN '< 5 000'
  WHEN montant < 10000 THEN '5 000 – 10 000'
  WHEN montant < 25000 THEN '10 000 – 25 000'
  WHEN montant < 50000 THEN '25 000 – 50 000'
  WHEN montant < 100000 THEN '50 000 – 100 000'
  WHEN montant < 500000 THEN '100 000 – 500 000'
  ELSE '≥ 500 000' END`;

/* ───────────────────────── Assemblage ───────────────────────── */
async function buildReportData(opts = {}) {
  const t0 = Date.now();
  const p = await resolveCycle(opts);
  logger.info(`[SOCADEL-INVOICE] collecte données cycle ${p.cycle}/${p.annee}…`);

  const [
    globalRow, status, errors, errorsRaw, attempts, daily, dailyRegion, payBuckets, echeancier,
    relanceSoon, relanceLate, pareto, conc, bigUnpaid, channel,
    byCategorie, byRegion, byDivision, byMrc, byAgence, byTranche,
  ] = await Promise.all([
    step('global', () => fetchGlobal(p)),
    step('statuts', () => fetchStatus(p), []),
    step('causes échecs', () => fetchErrors(p), []),
    step('messages d’erreur', () => fetchErrorsRaw(p), []),
    step('tentatives', () => fetchAttempts(p), []),
    step('journalier', () => fetchDaily(p), []),
    step('journalier par région', () => fetchDailyRegion(p), []),
    step('délais de paiement', () => fetchPayBuckets(p), []),
    step('échéancier', () => fetchEcheancier(p), []),
    step('relance ≤ 3 j', () => fetchRelance(p, RELANCE_SOON, 5000), []),
    step('relance échues', () => fetchRelance(p, RELANCE_LATE, 5000), []),
    step('pareto', () => fetchPareto(p), []),
    step('concentration', () => fetchConcentration(p), []),
    step('gros impayés', () => fetchBigUnpaid(p), []),
    step('impact canal', () => fetchChannel(p), []),
    step('catégories', () => fetchDim(p, 'categorie'), []),
    step('régions', () => fetchDim(p, 'region'), []),
    step('divisions', () => fetchDim(p, 'division', { parent: 'region' }), []),
    step('mrc', () => fetchDim(p, 'mrc', { parent: 'division' }), []),
    step('agences', () => fetchDim(p, 'agence', { parent: 'division' }), []),
    step('tranches', () => fetchDim(p, TRANCHE_EXPR, { order: 'MIN(montant)' }), []),
  ]);

  const global = enrich(globalRow);

  const paretoRows = Object.fromEntries(pareto.map((r) => [r.seg, enrich(r)]));
  const c80 = conc[0] || {};

  const eligible = byAgence.filter((a) => a.total >= MIN_VOLUME);
  const sorted = [...eligible].sort((a, b) => b.score - a.score || b.total - a.total);
  const top = sorted.slice(0, 10);
  const flop = sorted.length > 10 ? sorted.slice(-Math.min(10, sorted.length - 10)).reverse() : [];

  const data = {
    generatedAt: new Date().toISOString(),
    cycle: p.cycle,
    annee: p.annee,
    today: global.today,
    global,
    status,
    errors,
    errorsRaw,
    attempts,
    daily,
    dailyRegion,
    payBuckets,
    echeancier,
    relanceSoon,
    relanceLate,
    pareto: { top: paretoRows.top || null, rest: paretoRows.rest || null, k80: c80.k80 || 0, n: c80.n || 0, tot: c80.tot || 0 },
    bigUnpaid,
    channel,
    byCategorie, byRegion, byDivision, byMrc, byAgence, byTranche,
    ranking: { top, flop },
  };
  logger.info(`[SOCADEL-INVOICE] données prêtes en ${Date.now() - t0}ms`);
  return data;
}

/* ───────────────────────── Analyse automatique ───────────────────────── */
const ech = (data, ords) => {
  const rows = (data.echeancier || []).filter((r) => ords.includes(r.ord));
  return { nb: rows.reduce((a, r) => a + r.nb, 0), montant: rows.reduce((a, r) => a + r.montant, 0) };
};

function buildInsights(data) {
  const g = data.global;
  const facts = [];
  const alerts = [];
  const recos = [];

  facts.push(
    `<b>${fmt(g.distribuees)}</b> factures distribuées sur ${fmt(g.total)} à distribuer, soit un taux de succès de <b>${fmtPct(g.tx_succes)}</b> (${money(g.montant_distribue)}).`
  );
  facts.push(`<b>${fmtPct(g.tx_lecture)}</b> des factures délivrées ont été lues (${fmt(g.lues)} lectures).`);
  const ch = Object.fromEntries((data.channel || []).map((r) => [r.seg, r]));
  if (ch.lue && ch.non_distribuee && ch.lue.total && ch.non_distribuee.total) {
    facts.push(
      `Taux de paiement : <b>${fmtPct(pct(ch.lue.payees, ch.lue.total))}</b> pour les factures lues, contre ${fmtPct(pct(ch.non_distribuee.payees, ch.non_distribuee.total))} pour les non distribuées.`
    );
  } else {
    facts.push(`<b>${money(g.montant_paye)}</b> encaissés sur les factures distribuées (recouvrement ${fmtPct(g.tx_recouv)}).`);
  }

  const soon = ech(data, [4, 5, 6, 7]);
  const late = ech(data, [0, 1, 2, 3]);
  if (soon.nb > 0)
    alerts.push(`<b>${fmt(soon.nb)}</b> factures distribuées (${money(soon.montant)}) arrivent à échéance sous 3 jours sans paiement.`);
  if (late.nb > 0)
    alerts.push(`<b>${fmt(late.nb)}</b> factures distribuées sont échues et impayées (${money(late.montant)}).`);
  if (g.tx_echec > 5 && data.errors?.[0])
    alerts.push(`Taux d'échec de <b>${fmtPct(g.tx_echec)}</b>, principale cause : ${esc(data.errors[0].cause.toLowerCase())}.`);
  const queue = (g.pending || 0) + (g.processing || 0);
  if (queue > 0) alerts.push(`<b>${fmt(queue)}</b> factures sont encore en attente d'envoi.`);
  const under = (data.byAgence || []).filter((a) => a.total >= MIN_VOLUME && a.tx_succes < TARGET_SUCCESS).length;
  if (under > 0) alerts.push(`<b>${fmt(under)}</b> agences sont sous l'objectif de succès de ${fmt(TARGET_SUCCESS)} %.`);
  if (!alerts.length) alerts.push('Aucune alerte majeure sur la période.');

  if (soon.nb > 0) recos.push('Relancer en priorité les factures à échéance sous 3 jours (liste détaillée plus bas et en pièce jointe).');
  if (g.invalides > 0 || g.echecs > 0)
    recos.push(`Corriger les numéros en erreur (${fmt(Math.max(g.invalides, g.echecs))}) avec les agences et basculer vers SMS ou agent en cas d'échec persistant.`);
  if (data.pareto?.top && data.pareto.top.payees < data.pareto.top.distribuees)
    recos.push('Cibler les gros montants non payés (focus 20/80) par une relance personnalisée.');
  if (under > 0) recos.push('Accompagner les agences les moins performantes (classement en fin de rapport).');
  if (late.nb > 0) recos.push('Lancer un plan de recouvrement sur les factures échues, en commençant par les plus anciennes.');
  if (!recos.length) recos.push('Maintenir le rythme actuel de distribution et de relance.');

  return { facts, alerts: alerts.slice(0, 5), recos: recos.slice(0, 5) };
}

