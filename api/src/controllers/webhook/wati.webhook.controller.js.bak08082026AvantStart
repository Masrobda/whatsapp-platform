class WatiWebhookController {
  constructor() {
    this.secret    = process.env.WATI_WEBHOOK_SECRET || 'your-secret-key';
    this.apiKey    = process.env.WATI_API_KEY;
    this.baseURL   = 'https://live-mt-server.wati.io/10144460';
    this.rateLimit = new Map();

    // Anti-doublon in-memory (TTL 10s)
    this.recentEvents = new Map();
    setInterval(() => {
      const cutoff = Date.now() - 10000;
      for (const [k, t] of this.recentEvents) {
        if (t < cutoff) this.recentEvents.delete(k);
      }
    }, 10000);
  }

  isDuplicateEvent(localMessageId, eventType) {
    const key = `${localMessageId}|${eventType}`;
    if (this.recentEvents.has(key)) return true;
    this.recentEvents.set(key, Date.now());
    return false;
  }

  checkRateLimit(ip, limit = 10, windowMs = 60000) {
    const now = Date.now();
    const windowStart = now - windowMs;
    if (!this.rateLimit.has(ip)) this.rateLimit.set(ip, []);
    const requests = this.rateLimit.get(ip).filter(t => t > windowStart);
    requests.push(now);
    this.rateLimit.set(ip, requests);
    return requests.length <= limit;
  }

  isTestPayload(payload) {
    return [
      payload.localMessageId    === 'message.LocalMessageId',
      payload.whatsappMessageId === 'message.WhatsappMessageId',
      payload.id                === 'message.Id',
      payload.conversationId    === 'message.ConversationId',
      payload.ticketId          === 'message.TicketId',
      payload.timestamp         === 'message.Time',
    ].some(Boolean);
  }

  // ============================================================
  // FIND MESSAGE — 3 niveaux de lookup, du plus rapide au plus lent
  //
  //   Niveau 1 : message_id_index (table plate, <5ms)        ← OPTION 2
  //   Niveau 2 : messages avec created_at > -7j (7 partitions) ← OPTION 1
  //   Niveau 3 : messages sans borne (240 partitions, fallback rare)
  // ============================================================
  async findMessage(localMessageId, whatsappMessageId) {
    console.log(`🔍 findMessage: localId=${localMessageId}, waId=${whatsappMessageId}`);

    const isPlaceholder = id =>
      !id || id === 'message.LocalMessageId' || id === 'message.WhatsappMessageId';

    const isUUID = id =>
      id && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);

    // ── NIVEAU 1 : message_id_index (table plate non partitionnée) ──
    // Lookup instantané <5ms quelle que soit la taille de messages
    try {
      if (!isPlaceholder(localMessageId) || !isPlaceholder(whatsappMessageId)) {
        const parts  = [];
        const values = [];

        if (!isPlaceholder(localMessageId)) {
          values.push(localMessageId);
          parts.push(
            `SELECT message_id AS id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 1 AS prio
             FROM message_id_index WHERE wati_local_id = $${values.length}`
          );
          values.push(localMessageId);
          parts.push(
            `SELECT message_id AS id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 2 AS prio
             FROM message_id_index WHERE wa_message_id = $${values.length}`
          );
        }

        if (!isPlaceholder(whatsappMessageId)) {
          values.push(whatsappMessageId);
          parts.push(
            `SELECT message_id AS id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 3 AS prio
             FROM message_id_index WHERE wa_message_id = $${values.length}`
          );
        }

        if (parts.length > 0) {
          const idxResult = await query(
            `SELECT * FROM (${parts.join(' UNION ALL ')}) sub ORDER BY prio ASC LIMIT 1`,
            values
          );

          if (idxResult.rows.length > 0) {
            console.log(`✅ [INDEX] Trouvé via message_id_index en <5ms`);
            return idxResult.rows[0];
          }
        }
      }
    } catch (idxErr) {
      // Si message_id_index n'existe pas encore, on tombe sur le niveau 2
      logger.warn('[findMessage] message_id_index indisponible, fallback partition:', idxErr.message);
    }

    // ── NIVEAU 2 : table messages bornée à 7 jours (7 partitions max) ──
    // Partition pruning : PostgreSQL n'inspecte que les partitions de la fenêtre
    {
      const parts  = [];
      const values = [];

      if (!isPlaceholder(localMessageId)) {
        values.push(localMessageId);
        parts.push(
          `SELECT id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 1 AS prio
           FROM messages
           WHERE wati_local_id = $${values.length}
             AND created_at > NOW() - INTERVAL '7 days'`
        );
        values.push(localMessageId);
        parts.push(
          `SELECT id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 2 AS prio
           FROM messages
           WHERE wa_message_id = $${values.length}
