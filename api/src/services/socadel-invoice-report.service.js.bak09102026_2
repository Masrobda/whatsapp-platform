          return `<tr>${td(String(i + 1), { align: 'center', bg, bold: true, color: startGood ? C.green : C.red })}
            <td style="${cell({ bg, bold: true })}">${esc(r.label)}<div style="font-size:9.5px;font-weight:400;color:${C.muted};">${esc(r.parent || '')}</div></td>
            ${td(fmt(r.total), { align: 'right', bg })}${rateCell(r.tx_succes, TARGET_SUCCESS, bg)}${td(fmtPct(r.tx_lecture), { align: 'right', bg })}${td(fmtPct(r.tx_recouv), { align: 'right', bg })}
            ${td(fmtDec(r.score), { align: 'right', bg, bold: true, color: C.dark })}</tr>`;
