  /* ── 1. KPI ── */
  const soon = ech(data, [4, 5, 6, 7]);
  const late = ech(data, [0, 1, 2, 3]);
  const cards = [
    { label: 'Factures à distribuer', value: fmt(g.total), sub: `${fmt(g.contrats)} contrats`, color: C.dark },
    { label: 'Montant à distribuer', value: money(g.montant), sub: `Cycle ${g.cycle || data.cycle}/${data.annee}`, color: C.dark },
    { label: 'Contacts WhatsApp valides', value: fmt(g.valides), sub: `Couverture ${fmtPct(g.tx_valide)}`, rate: g.tx_valide, color: C.mid },
    { label: 'Envois tentés', value: fmt(g.envoyees), sub: `${fmtPct(g.tx_envoi)} des factures`, rate: g.tx_envoi, color: C.mid },
    { label: 'Factures distribuées', value: fmt(g.distribuees), sub: 'Délivrées + lues', rate: g.tx_succes, color: C.green },
    { label: 'Taux de succès', value: fmtPct(g.tx_succes), sub: `Sur contacts valides : ${fmtPct(g.tx_succes_valides)}`, rate: g.tx_succes, color: rateColor(g.tx_succes, TARGET_SUCCESS) },
    { label: 'Taux de lecture', value: fmtPct(g.tx_lecture), sub: `${fmt(g.lues)} factures lues`, rate: g.tx_lecture, color: C.green },
    { label: "Taux d'échec", value: fmtPct(g.tx_echec), sub: `${fmt(g.echecs)} échecs`, rate: g.tx_echec, color: g.tx_echec > 5 ? C.red : C.grey },
    { label: 'Délai moyen de distribution', value: fmtHours(g.delai_dist_h), sub: `Médiane ${fmtHours(g.dist_med_h)} · P90 ${fmtHours(g.dist_p90_h)}`, color: C.mid },
    { label: 'Montant distribué', value: money(g.montant_distribue), sub: `${fmtPct(pct(g.montant_distribue, g.montant))} du montant`, rate: pct(g.montant_distribue, g.montant), color: C.green },
