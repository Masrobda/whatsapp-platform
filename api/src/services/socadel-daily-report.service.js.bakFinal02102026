    { label: 'WhatsApp OK', value: fmt(g.whatsapp_ok), sub: `Taux ${fmtPct(g.taux_whatsapp)}`, rate: g.taux_whatsapp, color: C.blueLight },
    { label: 'SMS (tchoroko)', value: fmt(g.sms), sub: `Taux ${fmtPct(g.taux_sms)}`, rate: g.taux_sms, color: C.blueLight },
    { label: 'En attente Meta', value: fmt(g.en_attente_meta), sub: 'WhatsApp envoyés', color: C.slate },
    { label: 'Non délivrées', value: fmt(g.non_delivrees), sub: "Échecs d'envoi", color: C.slate },
    { label: 'Montant total', value: fmt(g.montant), sub: `Ab. digital × ${WHATSAPP_UNIT_VALUE}`, color: C.navy },
    { label: 'Itinéraires', value: fmt(g.n_itineraires), sub: `≥ 95 % : ${fmt(g.iti_ge_95)} · < 95 % : ${fmt(g.iti_lt_95)}`, rate: pct(g.iti_ge_95, g.n_itineraires), color: C.blue },
    { label: "Aujourd'hui", value: fmt(todayT.checked), sub: `vérifiés · ${fmt(todayT.abonne)} abonnés`, color: C.navy2 },
    { label: '7 derniers jours', value: fmt(l7Checked), sub: `vérifiés · ${fmt(l7Abo)} abonnés`, color: C.navy2 },
  ];

  const preheader = `Abonnés digitaux : ${fmt(g.abonne_digital)} sur ${fmt(g.total)} (${fmtPct(g.taux_abonne_digital)}) · Montant : ${fmt(g.montant)}`;

  const html = `<!DOCTYPE html>
<html lang="fr"><head>
