// ============================================================
// UTILITAIRES
// ============================================================
export function normalizePhoneNumber(phone) {
  if (!phone) return null;
  const cleaned = String(phone).replace(/[\s\-\(\)\.]/g, '').replace(/\D/g, '');
  if (!cleaned) return null;
  if (cleaned.startsWith('237') && cleaned.length >= 12) return `+${cleaned}`;
  if (cleaned.length === 9) return `+237${cleaned}`;
  if (cleaned.length === 8) return `+2376${cleaned}`;
  if (cleaned.length >= 10) return `+${cleaned}`;
  return null;
}

export function formatDate(dateStr, options = {}) {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleDateString('fr-FR', {
    day: '2-digit', month: 'short', year: 'numeric', ...options
  });
}

export function formatDateTime(dateStr) {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleString('fr-FR', {
    day: '2-digit', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit'
  });
}

export function formatNumber(n) {
  if (n === undefined || n === null) return '0';
  // Convertir en nombre si c'est une string
  const num = typeof n === 'string' ? parseFloat(n) : n;
  if (isNaN(num)) return '0';
  return num.toLocaleString('fr-FR');
}

export function formatCost(usd, currency = 'USD') {
  // CORRECTION : S'assurer que usd est un nombre
  let val = 0;
  if (usd === undefined || usd === null) {
    val = 0;
  } else if (typeof usd === 'string') {
    val = parseFloat(usd);
  } else if (typeof usd === 'number') {
    val = usd;
  } else {
    val = 0;
  }
  
  if (isNaN(val)) val = 0;
  
  if (currency === 'FCFA') {
    const fcfa = Math.round(val * 620);
    return `${fcfa.toLocaleString('fr-FR')} FCFA`;
  }
  return `${val.toFixed(2)} USD`;
}

export function estimateSendTime(contactCount, ratePerMinute) {
  if (!contactCount || !ratePerMinute) return '—';
  const mins = Math.ceil(contactCount / ratePerMinute);
  if (mins < 60) return `~${mins} min`;
  const h = (mins / 60).toFixed(1);
  return `~${h} h`;
}

export function parseCSVContacts(text) {
  const lines = text.trim().split('\n');
  if (lines.length < 2) return [];
  const headers = lines[0].split(',').map(h => h.trim().replace(/"/g, '').toLowerCase());

  const phoneCol = headers.findIndex(h => ['phone_number','phone','telephone','téléphone','numero'].includes(h));
  const nameCol = headers.findIndex(h => ['name','nom','prenom','prénom'].includes(h));
  const emailCol = headers.findIndex(h => ['email'].includes(h));

  return lines.slice(1).map(line => {
    const vals = line.split(',').map(v => v.trim().replace(/"/g, ''));
    const phone = phoneCol >= 0 ? vals[phoneCol] : vals[0];
    const name = nameCol >= 0 ? vals[nameCol] : '';
    const email = emailCol >= 0 ? vals[emailCol] : '';

    const variables = {};
    headers.forEach((h, i) => {
      if (i !== phoneCol && i !== nameCol && i !== emailCol && vals[i]) {
        variables[h] = vals[i];
      }
    });

    return { phone_number: phone || '', name: name || '', email: email || '', variables };
  }).filter(c => c.phone_number);
}
