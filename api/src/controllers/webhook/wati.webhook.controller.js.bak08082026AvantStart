// ── LOGGING DES WEBHOOKS ──────────────────────────────────
async logWebhook(webhookId, event, payload, status, responseBody = null, durationMs = 0) {
  try {
    await query(
      `INSERT INTO webhook_logs
       (webhook_id, event, payload, response_status, response_body, duration_ms, created_at)
       VALUES ($1, $2, $3, $4, $5, $6, NOW())`,
      [webhookId || null, event, JSON.stringify(payload), status, responseBody, durationMs]
    );
  } catch (err) {
    logger.error('[logWebhook] Erreur insertion:', err.message);
  }
}

async getWebhookIdFromRequest(request) {
  const protocol = request.protocol || 'https';
  const host = request.headers.host || request.hostname;
  const fullUrl = `${protocol}://${host}${request.url}`;

  const cached = webhookIdCache.get(fullUrl);
  if (cached && (Date.now() - cached.timestamp < CACHE_TTL)) {
    return cached.id;
  }

  const result = await query(
    `SELECT id FROM client_webhooks WHERE url = $1 AND is_active = true LIMIT 1`,
    [fullUrl]
  );

  if (result.rows.length === 0) {
    logger.warn(`Aucun webhook trouvé pour l'URL: ${fullUrl}`);
    return null;
  }

  const webhookId = result.rows[0].id;
  webhookIdCache.set(fullUrl, { id: webhookId, timestamp: Date.now() });
  return webhookId;
}

async triggerClientWebhooks(messageId, status) {
  try {
    // Récupérer les infos depuis message_id_index
    const indexResult = await query(
      `SELECT client_id, recipient_phone, wa_message_id, wa_status
       FROM message_id_index
       WHERE message_id = $1
       LIMIT 1`,
      [messageId]
    );
    if (indexResult.rows.length === 0) return;
    const msg = indexResult.rows[0];

    const webhooksResult = await query(
      `SELECT ch.* FROM client_webhooks ch
       WHERE ch.client_id = $1 AND ch.is_active = true AND $2 = ANY(ch.events)`,
      [msg.client_id, `message.${status}`]
    );
    for (const webhook of webhooksResult.rows) {
      this.sendWebhookNotification(webhook, messageId, status, msg).catch(err =>
        logger.error('sendWebhookNotification:', err.message)
      );
    }
  } catch (error) {
    logger.error('triggerClientWebhooks:', error.message);
  }
}

async sendWebhookNotification(webhook, messageId, status, msgData) {
  try {
    const payload = {
      event: `message.${status}`,
      timestamp: new Date().toISOString(),
      data: {
        message_id: messageId,
        status,
        recipient: msgData.recipient_phone,
        wa_message_id: msgData.wa_message_id,
        // On peut omettre les dates ou les récupérer depuis l'index si besoin
        sent_at: null,
        delivered_at: null,
        read_at: null
      }
    };
    const signature = crypto.createHmac('sha256', webhook.secret)
      .update(JSON.stringify(payload)).digest('hex');
    await axios.post(webhook.url, payload, {
      headers: { 'Content-Type': 'application/json', 'X-Webhook-Signature': signature },
      timeout: 10000
    });
  } catch (error) {
    logger.error('sendWebhookNotification:', error.message);
  }
}

// ============================================================
// HANDLE WEBHOOK — Point d'entrée principal
// Répond 200 immédiatement à WATI puis traite en arrière‑plan
// ============================================================
async handleWebhook(request, reply) {
  const clientIp = request.ip || request.connection?.remoteAddress || 'unknown';
  const startTime = Date.now();

  try {
    // Récupérer le webhook_id associé à cette URL
    let webhookId = await this.getWebhookIdFromRequest(request);
    if (!webhookId) {
      // On continue sans ID (on loguera avec NULL)
      logger.warn('⚠️ Webhook reçu sans ID correspondant (URL inconnue) — logué sans webhook_id');
    }

    // Rate limiting
    if (!this.checkRateLimit(clientIp)) {
      return reply.code(429).send({ error: 'Too many requests' });
    }

    const payload = request.body;
    const eventType = payload.eventType || payload.event_type || payload.event || 'unknown';

    // LOG initial (même si webhookId est null)
    const duration = Date.now() - startTime;
    await this.logWebhook(webhookId || null, eventType, payload, 200, null, duration);

    // Test payload (message.test du dashboard)
    if (this.isTestPayload(payload)) {
      return reply.code(200).send({
        status: 'received',
        message: 'Test webhook working',
        timestamp: new Date().toISOString()
      });
    }

    // Log métier
    logger.info('📨 WATI webhook:', {
      eventType,
      localMessageId: payload.localMessageId,
      whatsappMessageId: payload.whatsappMessageId,
      ip: clientIp
    });

    // Réponse immédiate à WATI (évite les retries pour timeout)
    reply.code(200).send({ status: 'received', timestamp: new Date().toISOString() });

    // ── Traitement asynchrone post‑réponse ──
    setImmediate(async () => {
      try {
        switch (eventType) {
          case 'sentMessageDELIVERED_v2':
          case 'sentMessageDELIVERED':
            await this.updateMessageStatus(
              payload.whatsappMessageId, 'delivered',
              payload.timestamp, eventType, payload.localMessageId
            );
            break;

          case 'sentMessageREAD_v2':
          case 'sentMessageREAD':
            await this.updateMessageStatus(
              payload.whatsappMessageId, 'read',
              payload.timestamp, eventType, payload.localMessageId
            );
            break;

          case 'sentMessageSENT_v2':
          case 'sentMessageSENT':
            await this.updateMessageStatus(
              payload.whatsappMessageId, 'sent',
              payload.timestamp, eventType, payload.localMessageId
            );
            break;

           case 'templateMessageFailed':
           case 'templateMessageFailed_v2':
            await this.updateMessageStatus(
              payload.whatsappMessageId, 'failed',
              payload.timestamp, eventType, payload.localMessageId,
              payload.failedDetail || payload.failed_detail || payload.data?.failedDetail || null
            );
            break;

          case 'message':
          case 'messageReceived':
            await this.saveIncomingMessage(payload);
            break;

          default:
            logger.info(`ℹ️ Webhook non géré: ${eventType}`);
        }
      } catch (err) {
        logger.error('Erreur traitement webhook async:', err.message);
      }
    });

  } catch (error) {
    logger.error('❌ Erreur handleWebhook:', error.message);
    if (!reply.sent) {
      return reply.code(200).send({ status: 'error', timestamp: new Date().toISOString() });
    }
  }
}

