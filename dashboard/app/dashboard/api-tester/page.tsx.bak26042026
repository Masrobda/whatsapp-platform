'use client';
import { useState, useEffect } from 'react';
import { messages as messagesAPI, client } from '@/lib/api';
import Card, { CardHeader, CardTitle, CardContent } from '@/components/ui/Card';
import Button from '@/components/ui/Button';
import Input from '@/components/ui/Input';
import { FiSend, FiCheck, FiX, FiKey, FiSmartphone, FiInfo, FiAlertTriangle } from 'react-icons/fi';
import Cookies from 'js-cookie';

export default function ApiTesterPage() {
  const [messageType, setMessageType] = useState<'text' | 'template' | 'media'>('text');

  const [formData, setFormData] = useState({
    recipient_phone: '',
    message_content: '',
    template_name: '',
    template_language: 'fr',
    template_params: '',
    media_url: '',
    media_type: 'image',
  });

  const [clientPhoneNumber, setClientPhoneNumber] = useState<string | null>(null);
  const [apiToken, setApiToken] = useState('');
  const [useManualToken, setUseManualToken] = useState(false);
  const [useManualPhone, setUseManualPhone] = useState(false);
  const [manualPhoneInput, setManualPhoneInput] = useState('');

  const [isSending, setIsSending] = useState(false);
  const [result, setResult] = useState<any>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

    // ✅ NOUVEAU: État pour la validation du numéro
  const [phoneValidationError, setPhoneValidationError] = useState<string | null>(null);
  const [isValidatingPhone, setIsValidatingPhone] = useState(false);

  // Numéro émetteur effectif
  const effectivePhoneNumber = useManualPhone ? manualPhoneInput : clientPhoneNumber;

  // ✅ NOUVEAU: Fonction pour vérifier si le numéro appartient bien au client
  const validatePhoneNumber = async (phoneNumber: string) => {
  if (!phoneNumber || !isValidPhoneNumber(phoneNumber)) {
    setPhoneValidationError('Format de numéro invalide');
    return false;
  }

  setIsValidatingPhone(true);
  setPhoneValidationError(null);

  try {
    const authToken = Cookies.get('token');
    const clientId = Cookies.get('client_id');

    // ✅ Vérifier si ce client est assigné à ce numéro
    const response = await fetch(`${process.env.NEXT_PUBLIC_API_URL}/whatsapp/numbers/validate`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${authToken}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ 
        phone_number: phoneNumber,
        client_id: clientId  // Ajoutez le client_id
      }),
    });

    const data = await response.json();

    if (!response.ok) {
      if (response.status === 403) {
        setPhoneValidationError('Ce numéro ne vous est pas assigné');
        return false;
      }
      throw new Error(data.message || 'Erreur de validation');
    }

    setPhoneValidationError(null);
    return true;
  } catch (error) {
    console.error('❌ Erreur validation:', error);
    setPhoneValidationError('Impossible de valider le numéro');
    return false;
  } finally {
    setIsValidatingPhone(false);
  }
};

// ✅ NOUVEAU: Effet pour valider quand le numéro change
  useEffect(() => {
    if (effectivePhoneNumber && useManualPhone) {
      const timeoutId = setTimeout(() => {
        validatePhoneNumber(effectivePhoneNumber);
      }, 500); // Délai pour éviter trop d'appels
      
      return () => clearTimeout(timeoutId);
    } else {
      setPhoneValidationError(null);
    }
  }, [effectivePhoneNumber, useManualPhone]);

  useEffect(() => {
    const loadClientCredentials = async () => {
      setIsLoading(true);
      setError(null);

      try {
        // 1. Récupérer les credentials (token API et instance)
        console.log('📡 Chargement des credentials...');
        const credentialsResponse = await client.getCredentials();
        const credentials = credentialsResponse.credentials || credentialsResponse;

        console.log('✅ Credentials reçus:', {
          hasToken: !!credentials?.api_token,
          hasInstance: !!credentials?.api_instance,
          hasPhoneNumber: !!credentials?.whatsapp_number
        });

        // Token API
        const token = credentials?.api_token || credentials?.data?.api_token;
        if (token && typeof token === 'string' && token.startsWith('nxt_')) {
          setApiToken(token);
          setUseManualToken(false);
          console.log('✅ Token API chargé:', token.slice(0, 15) + '...');
        } else {
          console.log('⚠️ Token API non trouvé dans credentials');

          // Fallback: chercher dans le cookie
          const cookieToken = Cookies.get('api_token');
          if (cookieToken?.startsWith('nxt_')) {
            setApiToken(cookieToken);
            setUseManualToken(false);
            console.log('✅ Token API chargé depuis cookie');
          } else {
            setUseManualToken(true);
          }
        }

        // 2. Récupérer le numéro WhatsApp du client
        // Méthode 1: Depuis les credentials (recommandé)
        let whatsappNumber = credentials?.whatsapp_number || credentials?.data?.whatsapp_number;

        if (whatsappNumber) {
          setClientPhoneNumber(whatsappNumber);
          setUseManualPhone(false);
          console.log('✅ Numéro WhatsApp chargé depuis credentials:', whatsappNumber);
        } else {
          console.log('⚠️ Numéro non trouvé dans credentials, tentative API directe...');

          // Méthode 2: Appel API direct avec le token du client
          const authToken = Cookies.get('token');

          if (authToken) {
            try {
              const response = await fetch(`${process.env.NEXT_PUBLIC_API_URL}/whatsapp/my-numbers`, {
                headers: {
                  'Authorization': `Bearer ${authToken}`,
                  'Content-Type': 'application/json',
                },
                credentials: 'include',
              });

              if (response.ok) {
                const data = await response.json();
                const number = data.data?.[0]?.phone_number || null;

                if (number) {
                  setClientPhoneNumber(number);
                  setUseManualPhone(false);
                  console.log('✅ Numéro WhatsApp chargé depuis API:', number);
                }
              }
            } catch (apiError) {
              console.log('⚠️ Échec API directe, tentative credentials alternatifs...');

              // Méthode 3: Récupérer depuis les credentials de l'utilisateur
              try {
                const userResponse = await fetch(`${process.env.NEXT_PUBLIC_API_URL}/auth/me`, {
                  headers: {
                    'Authorization': `Bearer ${authToken}`,
                  },
                });

                if (userResponse.ok) {
                  const userData = await userResponse.json();
                  whatsappNumber = userData.user?.whatsapp_number || userData.whatsapp_number;

                  if (whatsappNumber) {
                    setClientPhoneNumber(whatsappNumber);
                    setUseManualPhone(false);
                    console.log('✅ Numéro WhatsApp chargé depuis profil utilisateur:', whatsappNumber);
                  }
                }
              } catch (userError) {
                console.log('❌ Impossible de charger le numéro automatiquement');
              }
            }
          }
        }

        // Si toujours pas de numéro, proposer la saisie manuelle
        if (!clientPhoneNumber && !whatsappNumber) {
          console.log('⚠️ Aucun numéro trouvé, saisie manuelle requise');
          setUseManualPhone(true);
          setError('Veuillez saisir votre numéro WhatsApp émetteur');
        }

      } catch (error) {
        console.error('❌ Erreur chargement credentials:', error);
        setUseManualToken(true);
        setUseManualPhone(true);
        setError('Erreur de chargement des identifiants. Veuillez les saisir manuellement.');
      } finally {
        setIsLoading(false);
      }
    };

    loadClientCredentials();
  }, []);

  // Fonction pour valider le format du numéro
  const isValidPhoneNumber = (phone: string | null) => {
    if (!phone) return false;
    return /^\+\d{8,15}$/.test(phone);
  };

  const handleSend = async () => {
    // Validations
    if (!formData.recipient_phone.trim()) {
      alert('Veuillez entrer un numéro de destinataire');
      return;
    }

    if (!effectivePhoneNumber) {
      alert('Numéro WhatsApp émetteur manquant');
      return;
    }

    if (!isValidPhoneNumber(effectivePhoneNumber)) {
      alert('Le numéro émetteur doit être au format international (+237XXXXXXXXX)');
      return;
    }

    if (!apiToken) {
      alert('Veuillez saisir un token API valide');
      return;
    }

    // ✅ NOUVEAU: Validation renforcée du numéro émetteur
    if (useManualPhone) {
      // Vérification stricte pour les numéros saisis manuellement
      if (effectivePhoneNumber !== clientPhoneNumber) {
        const isAuthorized = await validatePhoneNumber(effectivePhoneNumber);
        if (!isAuthorized) {
          setResult({
            success: false,
            error: {
              message: 'Numéro émetteur non autorisé. Utilisez uniquement le numéro assigné à votre compte.',
              code: 'UNAUTHORIZED_EMITTER'
            }
          });
          return;
        }
      }
    } else {
      // Vérification que le numéro automatique est toujours valide
      if (!clientPhoneNumber) {
        alert('Numéro émetteur non disponible');
        return;
      }
    }

    setIsSending(true);
    setResult(null);

    try {
      const payload: any = {
        phoneNumber: effectivePhoneNumber,
        recipient_phone: formData.recipient_phone.trim(),
        message_type: messageType,
      };

      if (messageType === 'text') {
        if (!formData.message_content.trim()) {
          alert('Veuillez entrer un message');
          setIsSending(false);
          return;
        }
        payload.message_content = formData.message_content.trim();
      } else if (messageType === 'template') {
        if (!formData.template_name.trim()) {
          alert('Veuillez entrer le nom du template');
          setIsSending(false);
          return;
        }
        payload.template_name = formData.template_name.trim();
        payload.template_language = formData.template_language.trim();
        if (formData.template_params.trim()) {
          payload.template_params = formData.template_params
            .split(',')
            .map((p) => p.trim())
            .filter(Boolean);
        }
      } else if (messageType === 'media') {
        if (!formData.media_url.trim()) {
          alert("Veuillez entrer l'URL du média");
          setIsSending(false);
          return;
        }
        payload.media_url = formData.media_url.trim();
        payload.media_type = formData.media_type;
        if (formData.message_content.trim()) {
          payload.message_content = formData.message_content.trim();
        }
      }

      console.log('📤 Envoi message avec:', {
        emitter: effectivePhoneNumber,
        token: apiToken.slice(0, 15) + '...',
        recipient: payload.recipient_phone
      });

      const response = await messagesAPI.send(payload, apiToken);
      setResult({ success: true, data: response });
    } catch (error: any) {
      console.error('❌ Erreur envoi:', error);

      // ✅ AMÉLIORATION: Messages d'erreur plus explicites
      const errorData = error.response?.data;
      let errorMessage = errorData?.message || error.message || 'Erreur réseau';
      let errorCode = errorData?.code || error.code;
      
      // Interpréter les erreurs spécifiques
      if (errorMessage.includes('phoneNumber') || errorMessage.includes('émetteur')) {
        errorMessage = 'Numéro émetteur non valide. Veuillez utiliser le numéro WhatsApp assigné à votre compte.';
      }

      setResult({
        success: false,
        error: error.response?.data || {
          message: error.message || 'Erreur réseau',
          code: error.code
        },
      });
    } finally {
      setIsSending(false);
    }
  };

  if (isLoading) {
    return (
      <div className="space-y-6">
        <div>
          <h1 className="text-2xl font-bold text-dark">Testeur API</h1>
          <p className="text-gray-500 mt-1">Chargement de votre configuration WhatsApp...</p>
        </div>
        <Card>
          <CardContent>
            <div className="flex flex-col items-center justify-center py-12">
              <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
              <p className="mt-4 text-gray-600">Récupération de votre token API et numéro WhatsApp...</p>
              <p className="text-xs text-gray-400 mt-2">Client ID: {Cookies.get('client_id') || 'Non disponible'}</p>
            </div>
          </CardContent>
        </Card>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-dark">Testeur API</h1>
        <p className="text-gray-500 mt-1">Testez l'envoi de messages WhatsApp avec votre numéro dédié</p>
      </div>

      {error && (
        <div className="bg-amber-50 border border-amber-200 rounded-lg p-4">
          <p className="text-sm text-amber-800 flex items-center gap-2">
            <FiInfo className="flex-shrink-0" />
            {error}
          </p>
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <Card>
          <CardHeader>
            <CardTitle>📱 Envoyer un message de test</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="space-y-5">
              {/* Section Token API */}
              <div>
                {!useManualToken && apiToken ? (
                  <div className="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <FiKey className="text-green-600" />
                        <span className="text-sm font-medium text-green-700">
                          Token API chargé automatiquement
                        </span>
                      </div>
                      <button
                        onClick={() => setUseManualToken(true)}
                        className="text-xs text-green-600 hover:text-green-800 underline"
                      >
                        Modifier
                      </button>
                    </div>
                    <p className="text-xs text-green-600 mt-1 font-mono break-all">
                      {apiToken.slice(0, 20)}...{apiToken.slice(-10)}
                    </p>
                    <p className="text-xs text-gray-500 mt-2">
                      Ce token est unique et confidentiel. Il donne accès à votre compte.
                    </p>
                  </div>
                ) : (
                  <Input
                    label="Token API (nxt_...)"
                    type="text"
                    placeholder="nxt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                    value={apiToken}
                    onChange={(e) => setApiToken(e.target.value)}
                    icon={<FiKey />}
                    required
                  />
                )}
              </div>

              {/* Section Numéro WhatsApp Émetteur - Assigné au client */}
              <div>
                <label className="block text-sm font-medium text-dark mb-2">
                  📞 Votre numéro WhatsApp émetteur
                  <span className="text-red-500 ml-1">*</span>
                </label>

                {!useManualPhone && clientPhoneNumber ? (
                  <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <FiSmartphone className="text-blue-600" />
                        <span className="text-sm font-medium text-blue-700">
                          Numéro WhatsApp dédié
                        </span>
                      </div>
                      <button
                        onClick={() => setUseManualPhone(true)}
                        className="text-xs text-blue-600 hover:text-blue-800 underline"
                      >
                        Saisir autre numéro
                      </button>
                    </div>

                    {/* Affichage du numéro */}
                    <div className="mt-2 p-3 bg-white rounded-lg border border-blue-100">
                      <p className="text-lg font-mono font-bold text-dark">
                        {clientPhoneNumber}
                      </p>
                      <p className="text-xs text-gray-500 mt-1">
                        Ce numéro a été validé par Meta et vous est attribué exclusivement
                      </p>
                    </div>

                    {/* Informations supplémentaires */}
                    <div className="mt-3 flex items-start gap-2 text-xs text-gray-600">
                      <FiInfo className="flex-shrink-0 mt-0.5" size={14} />
                      <p>
                        Utilisez ce numéro comme <code className="bg-gray-100 px-1 py-0.5 rounded">phoneNumber</code> dans vos requêtes API.
                        Il est lié à votre compte et ne peut pas être utilisé par d'autres clients.
                      </p>
                    </div>
                  </div>
                ) : (
                  <div className="space-y-3">
                    <Input
                      type="text"
                      placeholder="+237699876543"
                      value={manualPhoneInput}
                      onChange={(e) => setManualPhoneInput(e.target.value)}
                      icon={<FiSmartphone />}
                      required
                      className={phoneValidationError ? 'border-red-500 focus:ring-red-500' : ''}
                    />

                    {/* ✅ NOUVEAU: Message d'erreur de validation */}
                    {phoneValidationError && (
                        <div className="flex items-start gap-2 p-3 bg-red-50 border border-red-200 rounded-lg">
                        <FiAlertTriangle className="text-red-500 flex-shrink-0 mt-0.5" size={16} />
                        <div>
                            <p className="text-xs font-medium text-red-800">Numéro non valide</p>
                            <p className="text-xs text-red-700">{phoneValidationError}</p>
                            <p className="text-xs text-red-600 mt-1">
                            Utilisez votre numéro assigné : <span className="font-mono font-bold">{clientPhoneNumber || 'Non disponible'}</span>
                            </p>
                        </div>
                        </div>
                    )}

                    {isValidatingPhone && (
                        <p className="text-xs text-gray-500 flex items-center gap-1">
                        <span className="animate-spin">⏳</span> Validation du numéro...
                        </p>
                    )}

                    {clientPhoneNumber && (
                      <button
                        onClick={() => {
                          setUseManualPhone(false);
                          setManualPhoneInput('');
                        }}
                        className="text-xs text-primary hover:text-primary-dark underline"
                      >
                        ← Revenir à mon numéro assigné ({clientPhoneNumber})
                      </button>
                    )}

                    {manualPhoneInput && !isValidPhoneNumber(manualPhoneInput) && (
                      <p className="text-xs text-amber-700 mt-1">
                        Format attendu : +237XXXXXXXXX (ex: +237699876543)
                      </p>
                    )}

                    <p className="text-xs text-gray-500 mt-2">
                      ⚠️ Seul le numéro WhatsApp qui vous a été assigné est actif sur votre compte.
                      L'utilisation d'un autre numéro échouera.
                    </p>
                  </div>
                )}
              </div>

              {/* Rappel du numéro assigné dans le payload */}
              {!useManualPhone && clientPhoneNumber && (
                <div className="bg-gray-50 border border-gray-200 rounded-lg p-3">
                  <p className="text-xs font-medium text-gray-700 mb-1">Payload attendu :</p>
                  <pre className="text-xs text-gray-600 bg-white p-2 rounded border border-gray-100 overflow-x-auto">
{`{
  "phoneNumber": "${clientPhoneNumber}",
  "recipient_phone": "...",
  "message_type": "...",
  ...
}`}
                  </pre>
                </div>
              )}

              {/* Numéro destinataire */}
              <Input
                label="Numéro destinataire"
                type="text"
                placeholder="+237600000000"
                value={formData.recipient_phone}
                onChange={(e) =>
                  setFormData({ ...formData, recipient_phone: e.target.value })
                }
                required
              />

              {/* Type de message */}
              <div>
                <label className="block text-sm font-medium text-dark mb-2">Type de message</label>
                <div className="grid grid-cols-3 gap-2">
                  {(['text', 'template', 'media'] as const).map((type) => (
                    <button
                      key={type}
                      onClick={() => setMessageType(type)}
                      className={`px-4 py-2 rounded-lg font-medium transition-all capitalize ${
                        messageType === type
                          ? 'bg-gradient-primary text-white shadow-md'
                          : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                      }`}
                    >
                      {type === 'text' ? 'Texte' : type === 'template' ? 'Template' : 'Média'}
                    </button>
                  ))}
                </div>
              </div>

              {/* Champs dynamiques selon le type */}
              {messageType === 'text' && (
                <div>
                  <label className="block text-sm font-medium text-dark mb-2">Message</label>
                  <textarea
                    value={formData.message_content}
                    onChange={(e) =>
                      setFormData({ ...formData, message_content: e.target.value })
                    }
                    rows={4}
                    className="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="Entrez votre message ici..."
                  />
                </div>
              )}

              {messageType === 'template' && (
                <div className="space-y-4">
                  <Input
                    label="Nom du template"
                    placeholder="hello_world"
                    value={formData.template_name}
                    onChange={(e) =>
                      setFormData({ ...formData, template_name: e.target.value })
                    }
                  />
                  <Input
                    label="Langue"
                    placeholder="fr"
                    value={formData.template_language}
                    onChange={(e) =>
                      setFormData({ ...formData, template_language: e.target.value })
                    }
                  />
                  <Input
                    label="Paramètres (séparés par des virgules)"
                    placeholder="John, 15"
                    value={formData.template_params}
                    onChange={(e) =>
                      setFormData({ ...formData, template_params: e.target.value })
                    }
                  />
                </div>
              )}

              {messageType === 'media' && (
                <div className="space-y-4">
                  <div>
                    <label className="block text-sm font-medium text-dark mb-2">
                      Type de média
                    </label>
                    <select
                      value={formData.media_type}
                      onChange={(e) =>
                        setFormData({ ...formData, media_type: e.target.value })
                      }
                      className="w-full px-4 py-2.5 border rounded-lg"
                    >
                      <option value="image">Image</option>
                      <option value="video">Vidéo</option>
                      <option value="document">Document</option>
                      <option value="audio">Audio</option>
                    </select>
                  </div>
                  <Input
                    label="URL du média"
                    type="url"
                    placeholder="https://..."
                    value={formData.media_url}
                    onChange={(e) =>
                      setFormData({ ...formData, media_url: e.target.value })
                    }
                  />
                  <Input
                    label="Légende (optionnel)"
                    placeholder="Description"
                    value={formData.message_content}
                    onChange={(e) =>
                      setFormData({ ...formData, message_content: e.target.value })
                    }
                  />
                </div>
              )}

              <Button
                onClick={handleSend}
                isLoading={isSending}
                className="w-full"
                disabled={isSending || !apiToken || !effectivePhoneNumber}
              >
                <FiSend className="mr-2" />
                Envoyer le message
              </Button>

              {/* Note sur le numéro émetteur */}
              <p className="text-xs text-gray-400 text-center mt-2">
                Le numéro émetteur est votre numéro WhatsApp Business dédié.
                Il est automatiquement utilisé pour tous vos envois.
              </p>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>📊 Résultat de l'envoi</CardTitle>
          </CardHeader>
          <CardContent>
            {result ? (
              <div className="space-y-4">
                <div
                  className={`p-4 rounded-lg border ${
                    result.success ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200'
                  }`}
                >
                  <div className="flex items-center gap-2 mb-2">
                    {result.success ? (
                      <FiCheck className="text-green-600" size={24} />
                    ) : (
                      <FiX className="text-red-600" size={24} />
                    )}
                    <span
                      className={`font-bold ${
                        result.success ? 'text-green-600' : 'text-red-600'
                      }`}
                    >
                      {result.success ? 'Succès !' : 'Échec'}
                    </span>
                  </div>
                  <p className="text-sm text-gray-700">
                    {result.success
                      ? result.data?.message || 'Message ajouté à la file d\'envoi'
                      : result.error?.message || 'Erreur inconnue'}
                  </p>
                  {result.success && result.data?.data?.queue_position && (
                    <p className="text-xs text-gray-500 mt-1">
                      Position dans la file: {result.data.data.queue_position}
                    </p>
                  )}
                </div>

                <div>
                  <h4 className="font-medium mb-2">Détails complets</h4>
                  <pre className="bg-gray-900 text-white p-4 rounded-lg text-xs overflow-auto max-h-96">
                    {JSON.stringify(result.success ? result.data : result.error, null, 2)}
                  </pre>
                </div>
              </div>
            ) : (
              <div className="text-center py-12 text-gray-500 border-2 border-dashed rounded-xl">
                <FiSend size={48} className="mx-auto mb-4 opacity-30" />
                <p>En attente d'un envoi...</p>
                {effectivePhoneNumber && (
                  <p className="text-xs text-gray-400 mt-2">
                    Prêt à envoyer depuis le numéro: {effectivePhoneNumber}
                  </p>
                )}
              </div>
            )}
          </CardContent>
        </Card>
      </div>

      {/* Résumé des identifiants */}
      <Card>
        <CardHeader>
          <CardTitle>🔑 Vos identifiants API</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="p-4 bg-gray-50 rounded-lg">
              <p className="text-sm font-medium text-gray-700 mb-1">Token API</p>
              <p className="text-sm font-mono">
                {apiToken ? (
                  <>
                    {apiToken.slice(0, 20)}...{apiToken.slice(-10)}
                    <span className="ml-2 text-xs text-green-600">✓ Chargé</span>
                  </>
                ) : (
                  <span className="text-amber-600">Non défini</span>
                )}
              </p>
            </div>
            <div className="p-4 bg-gray-50 rounded-lg">
              <p className="text-sm font-medium text-gray-700 mb-1">Numéro WhatsApp émetteur</p>
              <p className="text-sm font-mono">
                {effectivePhoneNumber ? (
                  <>
                    {effectivePhoneNumber}
                    <span className="ml-2 text-xs text-green-600">✓ Chargé</span>
                  </>
                ) : (
                  <span className="text-amber-600">Non défini</span>
                )}
              </p>
              {clientPhoneNumber && !useManualPhone && (
                <p className="text-xs text-gray-500 mt-1">
                  Numéro attribué à votre compte
                </p>
              )}
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}

