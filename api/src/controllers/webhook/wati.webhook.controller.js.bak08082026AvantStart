async _flushStatusUpdates(updates) {
  const groups = new Map();
  for (const [messageId, data] of updates) {
    const key = `${data.status}|${data.clientId}`;
    if (!groups.has(key)) {
      groups.set(key, {
        status: data.status,
        clientId: data.clientId,
        timestampDate: data.timestampDate,
        ids: [],
        waMessageIds: new Map(),
        failedDetails: new Map(),
      });
    }
    const g = groups.get(key);
    g.ids.push(messageId);
    if (data.waMessageId) g.waMessageIds.set(messageId, data.waMessageId);
    if (data.failedDetail) g.failedDetails.set(messageId, data.failedDetail);
  }

  const allPromises = [];
  for (const g of groups.values()) {
    const tsField = getTimestampField(g.status);

    // ========== AJOUT 1 : Mise à jour de la table principale "messages" ==========
    allPromises.push(
      query(
        `UPDATE messages
         SET wa_status = $1, ${tsField} = $2
         WHERE id = ANY($3::uuid[])`,
        [g.status, g.timestampDate, g.ids]
      )
    );

    // Mise à jour de message_id_index
    allPromises.push(
      query(
        `UPDATE message_id_index
         SET wa_status = $1
         WHERE message_id = ANY($2::uuid[])`,
        [g.status, g.ids]
      )
    );

    // Mise à jour de la table client
    const clientTable = `messages_client_${g.clientId.replace(/-/g, '_')}`;
    allPromises.push(
      query(
        `UPDATE ${clientTable}
         SET wa_status = $1, ${tsField} = $2
         WHERE id = ANY($3::uuid[])`,
        [g.status, g.timestampDate, g.ids]
      )
    );

    // Mise à jour de wa_message_id dans les trois tables
    for (const [msgId, waMsgId] of g.waMessageIds) {
      allPromises.push(
        query(
          `UPDATE message_id_index
           SET wa_message_id = $1
           WHERE message_id = $2
             AND (wa_message_id IS NULL OR wa_message_id <> $1)`,
          [waMsgId, msgId]
        )
      );
      allPromises.push(
        query(
          `UPDATE ${clientTable}
           SET wa_message_id = $1
           WHERE id = $2
             AND (wa_message_id IS NULL OR wa_message_id <> $1)`,
          [waMsgId, msgId]
        )
      );
      // ========== AJOUT 2 : Mise à jour de wa_message_id dans "messages" ==========
      allPromises.push(
        query(
          `UPDATE messages
           SET wa_message_id = $1
           WHERE id = $2
             AND (wa_message_id IS NULL OR wa_message_id <> $1)`,
          [waMsgId, msgId]
        )
      );
    }
   // wa_error_message : uniquement pour les messages en échec, raison réelle WATI/Meta
    if (g.status === 'failed') {
      for (const [msgId, detail] of g.failedDetails) {
        allPromises.push(
          query(`UPDATE messages SET wa_error_message = $1 WHERE id = $2`, [detail, msgId]),
        //  query(`UPDATE message_id_index SET wa_error_message = $1 WHERE message_id = $2`, [detail, msgId]),
          query(`UPDATE ${clientTable} SET wa_error_message = $1 WHERE id = $2`, [detail, msgId])
        );
      }
    }
  }

  await Promise.all(allPromises);

logger.info(`[BATCH] ✅ ${updates.length} status flushés sur message_id_index et clients`);
}

  async _flushOrphans(orphans) {
    const localIds = orphans.map(o => o.localMessageId).filter(Boolean);
    if (localIds.length === 0) return;

    const existing = await query(
      `SELECT local_message_id FROM orphan_webhooks WHERE local_message_id = ANY($1)`,
      [localIds]
    );
    const existingSet = new Set(existing.rows.map(r => r.local_message_id));

    const toInsert = orphans.filter(o => !existingSet.has(o.localMessageId));
    const toUpdate = orphans.filter(o =>  existingSet.has(o.localMessageId));

    if (toInsert.length > 0) {
      const values = [];
      const placeholders = toInsert.map((o, i) => {
        const base = i * 9;
        values.push(
          o.localMessageId, o.whatsappMessageId, o.eventType,
          JSON.stringify(o.rawPayload),
          o.sent_at || null, o.delivered_at || null,
          o.read_at || null, o.failed_at || null,
          o.eventType
        );
        return `($${base+1},$${base+2},$${base+3},$${base+4},NOW(),$${base+5},$${base+6},$${base+7},$${base+8},$${base+9})`;
      });
      await query(
        `INSERT INTO orphan_webhooks
           (local_message_id, whatsapp_message_id, event_type, payload, created_at,
            sent_at, delivered_at, read_at, failed_at, last_event_type)
         VALUES ${placeholders.join(',')}
         ON CONFLICT (local_message_id) DO NOTHING`,
        values
      );
    }

    for (const o of toUpdate) {
      const setClause = [];
      const vals = [];
      if (o.delivered_at) { setClause.push(`delivered_at = $${vals.length+1}`); vals.push(o.delivered_at); }
      if (o.read_at)      { setClause.push(`read_at = $${vals.length+1}`);      vals.push(o.read_at); }
      if (o.sent_at)      { setClause.push(`sent_at = $${vals.length+1}`);      vals.push(o.sent_at); }
      if (o.failed_at)    { setClause.push(`failed_at = $${vals.length+1}`);    vals.push(o.failed_at); }
      setClause.push(`last_event_type = $${vals.length+1}`); vals.push(o.eventType);
      vals.push(o.localMessageId);
      if (setClause.length > 1) {
        await query(
          `UPDATE orphan_webhooks SET ${setClause.join(', ')} WHERE local_message_id = $${vals.length}`,
          vals
        ).catch(err => logger.error('[BATCH] orphan update:', err.message));
      }
    }

    logger.info(`[BATCH] 🗂 ${toInsert.length} orphans insérés, ${toUpdate.length} mis à jour`);
  }
}

