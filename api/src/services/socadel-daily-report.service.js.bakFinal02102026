      <td valign="middle" align="right" style="font-family:${FONT};">
        <div style="font-size:11px;color:#a9c2e3;text-transform:uppercase;letter-spacing:1px;">Situation au</div>
        <div style="font-size:15px;font-weight:600;color:#ffffff;margin-top:4px;">${esc(dateLabel)}</div>
      </td>
    </tr></table>
  </td></tr>
  <tr><td bgcolor="${C.blue}" style="background:${C.blue};height:3px;font-size:0;line-height:0;">&nbsp;</td></tr>

