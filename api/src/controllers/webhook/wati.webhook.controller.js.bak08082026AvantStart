            query(
              `INSERT INTO message_id_index
                 (wati_local_id, wa_message_id, message_id, created_at, client_id, recipient_phone, wa_status)
               VALUES ($1, $2, $3, $4, $5, $6, $7)
               ON CONFLICT (wati_local_id) DO UPDATE
                 SET wa_message_id = EXCLUDED.wa_message_id,
                     wa_status     = EXCLUDED.wa_status`,
              [localMessageId, row.wa_message_id, row.id, row.created_at, row.client_id, row.recipient_phone, row.wa_status]
            ).catch(() => {});
          }

          return row;
        }
      }
    }

    // ── NIVEAU 3 : fallback sans borne temporelle (rare — webhook très tardif) ──
    // On log pour monitoring : si ce cas est fréquent, augmenter l'INTERVAL du niveau 2
    logger.warn(`[findMessage] Fallback niveau 3 (scan 240 partitions): localId=${localMessageId}`);
    {
      const parts  = [];
      const values = [];

      if (!isPlaceholder(localMessageId)) {
        values.push(localMessageId);
        parts.push(
          `SELECT id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 1 AS prio
           FROM messages WHERE wati_local_id = $${values.length}`
        );
        values.push(localMessageId);
        parts.push(
          `SELECT id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 2 AS prio
           FROM messages WHERE wa_message_id = $${values.length}`
        );
      }

      if (!isPlaceholder(whatsappMessageId)) {
        values.push(whatsappMessageId);
        parts.push(
          `SELECT id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 3 AS prio
           FROM messages WHERE wa_message_id = $${values.length}`
        );
      }

      if (isUUID(localMessageId)) {
        values.push(localMessageId);
        parts.push(
          `SELECT id, client_id, wa_status, wa_message_id, recipient_phone, created_at, 4 AS prio
           FROM messages WHERE id::text = $${values.length}`
        );
      }

      if (parts.length === 0) {
        console.log('❌ Aucun identifiant valide');
        return null;
      }

      const result = await query(
        `SELECT * FROM (${parts.join(' UNION ALL ')}) sub ORDER BY prio ASC LIMIT 1`,
        values
