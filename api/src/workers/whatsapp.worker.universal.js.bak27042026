// src/workers/whatsapp.worker.universal.js
const { Worker } = require('bullmq');
const { redisConnection } = require('../config/redis');
const { query } = require('../config/database');
const logger = require('../utils/logger');
const watiService = require('../services/wati.service'); // Utilisation du vrai service

// Fonction de vérification du cooldown
async function checkCooldown(recipientPhone, clientId) {
  try {
    const result = await query(
      `SELECT MAX(created_at) as last_message_date
       FROM messages
       WHERE recipient_phone = $1 AND client_id = $2
       AND wa_status IN ('sent', 'delivered', 'read')`,
      [recipientPhone, clientId]
    );

    if (result.rows.length === 0 || !result.rows[0].last_message_date) {
      return { canSend: true };
    }

    const COOLDOWN_DAYS = parseInt(process.env.MESSAGE_COOLDOWN_DAYS) || 14;
    const lastMessageDate = new Date(result.rows[0].last_message_date);
    const now = new Date();
    const daysSinceLastMessage = (now - lastMessageDate) / (1000 * 60 * 60 * 24);

    if (daysSinceLastMessage < COOLDOWN_DAYS) {
      return {
        canSend: false,
        reason: `Délai de ${COOLDOWN_DAYS} jours non respecté.`
      };
    }
    return { canSend: true };
  } catch (error) {
    return { canSend: true };
  }
}

const worker = new Worker(
  'whatsapp-messages-*',
  async (job) => {
    // CORRECTION : Extraction de invoice_data du job
    const { 
      messageId, client_id, recipient_phone, message_type, 
      template_name, template_language, template_params, 
      message_content, invoice_data 
    } = job.data;

    logger.info(`[WORKER] Traitement message ${messageId} pour ${recipient_phone}`);

    try {
      const cooldownCheck = await checkCooldown(recipient_phone, client_id);
      if (!cooldownCheck.canSend) {
        throw new Error(cooldownCheck.reason);
      }

      let result;
      if (message_type === 'template') {
        if (invoice_data && invoice_data.pdfUrl) {
          // Au lieu de sendInvoiceWithPDF, on envoie le template avec le média attaché
          result = await watiService.sendTemplateMessage(
            recipient_phone,
            template_name,
            template_params || {},
            {
              url: invoice_data.pdfUrl,
              filename: `Facture_${invoice_data.number || '001'}.pdf`,
              type: "document"
            }
          );
        } else {
          result = await watiService.sendTemplateMessage(
            recipient_phone,
            template_name,
            template_params || {}
          );
        }
      }else {
        result = await watiService.sendTextMessage(recipient_phone, message_content);
      }

      if (result && result.success) {
        await query(
          `UPDATE messages
           SET wa_status = 'sent',
               wa_message_id = $1,
               sent_at = NOW(),
               channel_used = 'wati'
           WHERE id = $2`,
          [result.messageId, messageId]
        );
        logger.info(`[WORKER] Message ${messageId} marqué comme envoyé`);
      } else {
        throw new Error(result?.error || 'Échec envoi WATI');
      }

      return result;
    } catch (error) {
      logger.error(`[WORKER] Échec message ${messageId}:`, error.message);
      await query(
        `UPDATE messages
         SET wa_status = 'failed',
             wa_error_message = $1,
             failed_at = NOW()
         WHERE id = $2`,
        [error.message, messageId]
      );
      throw error;
    }
  },
  {
    connection: redisConnection,
    concurrency: 5,
    autorun: true
  }
);

module.exports = { worker };
