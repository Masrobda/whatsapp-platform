  const generatedLabel = new Date().toLocaleString('fr-FR', { timeZone: 'Africa/Douala' });

  const cell = (o = {}) =>
    `padding:6px;font-size:${o.size || 11}px;text-align:${o.align || 'left'};` +
    `${o.bold ? 'font-weight:700;' : ''}${o.color ? `color:${o.color};` : ''}${o.bg ? `background:${o.bg};` : ''}`;
  const td = (v, o = {}) => `<td style="${cell(o)}">${v}</td>`;
  const headCell = (align) =>
    `padding:8px 6px;background:${C.dark};color:#ffffff;font-size:10px;font-weight:600;text-align:${align};`;
  const tblStyle = `border-collapse:collapse;border:1px solid ${C.border};font-family:${FONT};color:${C.text};`;
  const zebra = (i) => (i % 2 ? C.softer : '#ffffff');
  const rateColor = (rate, target) => (rate >= target ? C.green : rate >= target - 15 ? C.amber : C.red);

  const tbl = (heads, body, foot = '') =>
    `<tr><td style="padding:0 28px;"><table width="100%" cellpadding="0" cellspacing="0" border="0" style="${tblStyle}">
      <thead><tr>${heads.map(([h, a]) => `<th style="${headCell(a)}">${h}</th>`).join('')}</tr></thead>
      <tbody>${body}${foot}</tbody></table></td></tr>`;

  function progressBar(rate, color, h = 6) {
    const w = Math.round(Math.min(100, Math.max(0, Number(rate) || 0)));
    const left = w > 0 ? `<td width="${w}%" bgcolor="${color}" style="background:${color};height:${h}px;font-size:0;line-height:0;">&nbsp;</td>` : '';
    const right = w < 100 ? `<td width="${100 - w}%" bgcolor="${C.track}" style="background:${C.track};height:${h}px;font-size:0;line-height:0;">&nbsp;</td>` : '';
    return `<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:4px;"><tr>${left}${right}</tr></table>`;
  }

  function sectionTitle(title, subtitle) {
    return `<tr><td style="padding:28px 28px 10px 28px;">
      <table cellpadding="0" cellspacing="0" border="0" width="100%"><tr>
        <td width="4" bgcolor="${C.green}" style="background:${C.green};">&nbsp;</td>
        <td style="padding-left:12px;font-family:${FONT};">
          <div style="font-size:15px;font-weight:700;color:${C.dark};">${esc(title)}</div>
          ${subtitle ? `<div style="font-size:11px;color:${C.muted};margin-top:2px;">${esc(subtitle)}</div>` : ''}
        </td></tr></table></td></tr>`;
  }

  function kpiCard(c) {
    return `<td width="25%" valign="top" style="padding:6px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;border:1px solid ${C.border};border-top:3px solid ${c.color || C.dark};">
        <tr><td style="padding:12px 14px;font-family:${FONT};">
          <div style="font-size:11px;color:${C.muted};">${esc(c.label)}</div>
          <div style="font-size:22px;font-weight:700;color:${C.dark};margin-top:4px;">${c.value}</div>
          <div style="font-size:10.5px;color:${C.muted};margin-top:2px;min-height:13px;">${c.sub || '&nbsp;'}</div>
          ${c.rate != null ? progressBar(c.rate, c.color || C.green, 6) : ''}
        </td></tr></table></td>`;
