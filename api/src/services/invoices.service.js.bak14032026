// src/services/invoice.service.js
const fs = require('fs-extra');
const path = require('path');
const { query } = require('../config/database');

class InvoiceService {
    
    async generateInvoice(data) {
        const {
            invoiceNumber,
            orderNumber,
            clientName,
            clientEmail,
            amount,
            months,
            offerName,
            storageGb,
            date = new Date(),
            type = 'subscription'
        } = data;

        // Récupérer les informations de l'entreprise
        const company = {
            name: 'NUMERICEXPORT',
            address: 'Dakar, Sénégal',
            phone: '+221 78 123 45 67',
            email: 'contact@numericexport.com',
            ninea: 'SN-DKR-2023-123456',
            rc: 'RC-DKR-2023-789012'
        };

        const formattedDate = date.toLocaleDateString('fr-FR', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });

        const dueDate = new Date(date);
        dueDate.setDate(dueDate.getDate() + 15);
        const formattedDueDate = dueDate.toLocaleDateString('fr-FR');

        const amountFormatted = new Intl.NumberFormat('fr-FR', {
            style: 'currency',
            currency: 'XOF',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        }).format(amount);

        const taxRate = 0.18; // 18% TVA au Sénégal
        const taxAmount = amount * taxRate;
        const totalWithTax = amount + taxAmount;

        const taxFormatted = new Intl.NumberFormat('fr-FR', {
            style: 'currency',
            currency: 'XOF',
            minimumFractionDigits: 0
        }).format(taxAmount);

        const totalFormatted = new Intl.NumberFormat('fr-FR', {
            style: 'currency',
            currency: 'XOF',
            minimumFractionDigits: 0
        }).format(totalWithTax);

        // Générer le HTML
        const html = `
        <!DOCTYPE html>
        <html lang="fr">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Facture ${invoiceNumber}</title>
            <style>
                body {
                    font-family: 'Arial', sans-serif;
                    margin: 0;
                    padding: 20px;
                    color: #333;
                }
                .invoice-container {
                    max-width: 800px;
                    margin: 0 auto;
                    background: white;
                    padding: 30px;
                    box-shadow: 0 0 10px rgba(0,0,0,0.1);
                }
                .header {
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    margin-bottom: 30px;
                    padding-bottom: 20px;
                    border-bottom: 2px solid #2ecc71;
                }
                .company-info h1 {
                    color: #2ecc71;
                    margin: 0 0 10px 0;
                    font-size: 28px;
                }
                .company-info p {
                    margin: 3px 0;
                    color: #666;
                }
                .invoice-title {
                    text-align: right;
                }
                .invoice-title h2 {
                    color: #2ecc71;
                    margin: 0;
                    font-size: 24px;
                }
                .invoice-title .invoice-number {
                    font-size: 18px;
                    color: #333;
                    margin-top: 5px;
                }
                .client-info {
                    margin-bottom: 30px;
                    padding: 20px;
                    background: #f9f9f9;
                    border-radius: 5px;
                }
                .client-info h3 {
                    margin: 0 0 10px 0;
                    color: #333;
                }
                .client-info p {
                    margin: 5px 0;
                    color: #666;
                }
                .dates {
                    display: flex;
                    justify-content: space-between;
                    margin-bottom: 20px;
                }
                .dates .date-box {
                    flex: 1;
                    padding: 10px;
                    background: #f0f0f0;
                    border-radius: 5px;
                    margin: 0 5px;
                }
                .dates .date-box:first-child { margin-left: 0; }
                .dates .date-box:last-child { margin-right: 0; }
                .dates .label {
                    font-size: 12px;
                    color: #666;
                    text-transform: uppercase;
                }
                .dates .value {
                    font-size: 16px;
                    font-weight: bold;
                    color: #333;
                }
                table {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 20px 0;
                }
                th {
                    background: #2ecc71;
                    color: white;
                    padding: 12px;
                    text-align: left;
                }
                td {
                    padding: 12px;
                    border-bottom: 1px solid #ddd;
                }
                .totals {
                    text-align: right;
                    margin-top: 20px;
                    padding-top: 20px;
                    border-top: 2px solid #2ecc71;
                }
                .totals table {
                    width: 300px;
                    margin-left: auto;
                }
                .totals td {
                    padding: 5px 0;
                    border: none;
                }
                .totals .total {
                    font-size: 20px;
                    font-weight: bold;
                    color: #2ecc71;
                }
                .payment-info {
                    margin-top: 30px;
                    padding: 20px;
                    background: #f0f8ff;
                    border-radius: 5px;
                }
                .payment-info h3 {
                    margin: 0 0 10px 0;
                    color: #333;
                }
                .payment-info p {
                    margin: 5px 0;
                    color: #666;
                }
                .footer {
                    margin-top: 30px;
                    text-align: center;
                    color: #999;
                    font-size: 12px;
                }
                .status-badge {
                    display: inline-block;
                    padding: 5px 10px;
                    background: #f1c40f;
                    color: white;
                    border-radius: 3px;
                    font-size: 12px;
                    font-weight: bold;
                    margin-left: 10px;
                }
            </style>
        </head>
        <body>
            <div class="invoice-container">
                <!-- En-tête -->
                <div class="header">
                    <div class="company-info">
                        <h1>${company.name}</h1>
                        <p>${company.address}</p>
                        <p>Tél: ${company.phone}</p>
                        <p>Email: ${company.email}</p>
                        <p>NINEA: ${company.ninea}</p>
                        <p>RC: ${company.rc}</p>
                    </div>
                    <div class="invoice-title">
                        <h2>FACTURE</h2>
                        <div class="invoice-number">N° ${invoiceNumber}</div>
                        <div class="status-badge">EN ATTENTE DE PAIEMENT</div>
                    </div>
                </div>

                <!-- Client -->
                <div class="client-info">
                    <h3>Facturé à</h3>
                    <p><strong>${clientName || 'Client'}</strong></p>
                    <p>Email: ${clientEmail || 'N/A'}</p>
                </div>

                <!-- Dates -->
                <div class="dates">
                    <div class="date-box">
                        <div class="label">Date d'émission</div>
                        <div class="value">${formattedDate}</div>
                    </div>
                    <div class="date-box">
                        <div class="label">Date d'échéance</div>
                        <div class="value">${formattedDueDate}</div>
                    </div>
                </div>

                <!-- Détails de la commande -->
                <table>
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Quantité</th>
                            <th>Prix unitaire</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong>${offerName || 'Abonnement stockage'}</strong><br>
                                ${storageGb ? `${storageGb} Go de stockage cloud` : ''}<br>
                                Période: ${months} mois
                            </td>
                            <td>1</td>
                            <td>${amountFormatted}</td>
                            <td>${amountFormatted}</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totaux -->
                <div class="totals">
                    <table>
                        <tr>
                            <td>Sous-total:</td>
                            <td>${amountFormatted}</td>
                        </tr>
                        <tr>
                            <td>TVA (18%):</td>
                            <td>${taxFormatted}</td>
                        </tr>
                        <tr>
                            <td class="total">TOTAL:</td>
                            <td class="total">${totalFormatted}</td>
                        </tr>
                    </table>
                </div>

                <!-- Informations de paiement -->
                <div class="payment-info">
                    <h3>Instructions de paiement</h3>
                    <p><strong>Mode de paiement :</strong> Virement bancaire</p>
                    <p><strong>Banque :</strong> ECOBANK Sénégal</p>
                    <p><strong>Titulaire :</strong> NUMERICEXPORT SARL</p>
                    <p><strong>IBAN :</strong> SN08 1234 5678 9012 3456 7890 123</p>
                    <p><strong>SWIFT/BIC :</strong> ECOCSNDA</p>
                    <p><strong>Référence à rappeler :</strong> ${invoiceNumber}</p>
                    <p style="color: #e74c3c; margin-top: 10px;">
                        <strong>Important :</strong> La validation de votre commande se fera après réception du virement.
                    </p>
                </div>

                <!-- Pied de page -->
                <div class="footer">
                    <p>${company.name} - Capital social: 1 000 000 FCFA</p>
                    <p>Cette facture est générée automatiquement. Pour toute question, contactez-nous.</p>
                </div>
            </div>
        </body>
        </html>
        `;

        // Sauvegarder la facture
        const invoiceDir = path.join(process.cwd(), 'invoices');
        await fs.ensureDir(invoiceDir);
        
        const invoicePath = path.join(invoiceDir, `${invoiceNumber}.html`);
        await fs.writeFile(invoicePath, html);

        return html;
    }

    async generateInvoicePDF(invoiceNumber) {
        // Optionnel: Convertir HTML en PDF avec Puppeteer
        // À implémenter si besoin
    }
}

module.exports = new InvoiceService();
