    { label: 'Échues · impayées', value: fmt(late.nb), sub: money(late.montant), color: C.red },
  ];

  /* ── 2. Entonnoir ── */
  function funnel() {
    const steps = [
      ['Factures à distribuer', g.total, null],
      ['Envois tentés', g.envoyees, 0],
      ['Distribuées (délivrées + lues)', g.distribuees, 1],
      ['Lues', g.lues, 2],
      ['Payées (parmi les distribuées)', g.payees, 2],
