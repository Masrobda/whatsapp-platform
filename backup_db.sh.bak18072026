#!/bin/bash

# Répertoire de sauvegarde dans votre home
BACKUP_DIR="/home/patrick/backups/postgres"
mkdir -p "$BACKUP_DIR"

# Nom du fichier avec date/heure
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="$BACKUP_DIR/backup_$DATE.sql"

# Export avec l'utilisateur dédié (le mot de passe est lu depuis ~/.pgpass)
pg_dump -U nextltd_user -d nextltd_db -h localhost -p 5432 > "$BACKUP_FILE"

# Compression
gzip "$BACKUP_FILE"

# Supprimer les sauvegardes de plus de 30 jours
find "$BACKUP_DIR" -type f -name "*.sql.gz" -mtime +30 -delete

# Copie vers /var/www/numericexport/ pour récupération facile (scp)
cp "$BACKUP_FILE.gz" /var/www/numericexport/last_backup.sql.gz

# Journalisation (dans votre home)
echo "$(date) - Sauvegarde terminée : $BACKUP_FILE.gz" >> /home/patrick/backups/backup_db.log
